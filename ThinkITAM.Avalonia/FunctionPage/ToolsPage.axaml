<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="ThinkITAM.FunctionPage.ToolsPage"
            FontFamily="{DynamicResource MaterialFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <TextBlock Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource MaterialFontFamilyBold}"
                           FontSize="48"
                           Text="{DynamicResource TpTitle}" />
                <WrapPanel Margin="0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <!-- Network Calculator -->
                    <Border x:Name="NetworkCalculator" Margin="10,20" CornerRadius="5" Background="#4472C4">
                        <Button x:Name="NetworkCalculate" Width="300" Height="150"
                                Margin="0" Padding="0" Click="NetworkCalculate_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="AliceBlue" Kind="Lan" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="{DynamicResource TpIpCalculate}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpIpCalculateTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpIpAddress}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpIpAddressCalculate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpIpNetmask}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpIpNetmaskCalculate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpIpScale}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpIpScaleTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Port Scan Tool -->
                    <Border x:Name="PortScanTool" Margin="10,20" CornerRadius="5" Background="#5B9BD5">
                        <Button x:Name="PortScanToolButton" Width="300" Height="150"
                                Margin="0" Padding="0" Click="PortScanToolButton_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="WhiteSmoke" Kind="MidiPort" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="{DynamicResource TpPortScanTool}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpPortScanTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpPortScan}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpHostScan}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="PING" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpHostStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpHostName}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpHostNameMac}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- MAC Vendor Tool -->
                    <Border x:Name="MacVendorTool" Margin="10,20" CornerRadius="5" Background="#70AD47">
                        <Button x:Name="MacVendorButton" Width="300" Height="150"
                                Margin="0" Padding="0" Click="MacVendorButton_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="AliceBlue" Kind="ExpansionCard" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="{DynamicResource TpMac}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpMacTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Left" Margin="10,0" Text="{DynamicResource TpMacTooltip2}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Left" Margin="10,0" Text="{DynamicResource TpMacTooltip3}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Disk Calculation -->
                    <Border x:Name="DiskCalculation" Margin="10,20" CornerRadius="5" Background="#ED7D31">
                        <Button x:Name="DiskCalculationButton" Width="300" Height="150"
                                Margin="0" Padding="0" Click="DiskCalculationButton_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="Aquamarine" Kind="Hdd" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="{DynamicResource TpStorage}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpStorageTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="RAID" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpRaidCalculate}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpVideoStorage}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpVideoStorageTooltip}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Center" Text="{DynamicResource TpSaveTime}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Center" Text="{DynamicResource TpSaveTimeTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Wake On Lan -->
                    <Border x:Name="WakeOnLan" Margin="10,20" CornerRadius="5" Background="#6495ED">
                        <Button x:Name="WakeOnLanButton" Width="300" Height="150"
                                Margin="0" Padding="0" Click="WakeOnLanButton_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="CornflowerBlue" Kind="PowerSettings" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="Wake On Lan" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpWakeTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="10,0">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Left" Text="{DynamicResource TpWakeOnLan}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Left" Text="{DynamicResource TpWakeOnLanTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>

                    <!-- NotePad -->
                    <Border Margin="10,20" CornerRadius="5" Background="#9B59B6">
                        <Button x:Name="NotePadButton" Width="300" Height="150"
                                Margin="0" Padding="0" Click="NotePadButton_OnClick"
                                Background="Transparent" BorderThickness="0">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <material:MaterialIcon Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Foreground="AliceBlue" Kind="NotebookPlus" />
                                    <Grid Grid.Column="1" Height="70" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="24" Foreground="AliceBlue" Text="{DynamicResource TpNoteBook}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="AliceBlue" Opacity="0.5" Text="{DynamicResource TpNoteBookTooltip}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="10,0">
                                        <TextBlock FontSize="20" Foreground="AliceBlue" Opacity="0.9" HorizontalAlignment="Left" Text="{DynamicResource TpNoteBook}" />
                                        <TextBlock FontSize="12" Foreground="AliceBlue" Opacity="0.5" HorizontalAlignment="Left" Text="{DynamicResource TpNoteBookDescription}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>
                </WrapPanel>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.1" FontSize="48">
                IT HELPER TOOLBOX
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
