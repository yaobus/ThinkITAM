<UserControl
    x:Class="ThinkITAM.FunctionPage.NetworkAddressManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.Functions.FunctionClass"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:networkManage="clr-namespace:ThinkITAM.ViewModels.NetworkManage"
    xmlns:networkManage1="clr-namespace:ThinkITAM.UserControls.NetworkManage"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="NetworkAddressManage_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <functionClass:CustomColorIndexToColor x:Key="CustomColorIndexToColor" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <networkManage:IpAddressInfoListViewMode />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>


        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <materialDesign:Card Grid.Row="0" Margin="5,2.5,2.5,2.5">
                <TreeView
                    x:Name="NetworkTreeView"
                    Margin="-5,0,0,0"
                    IsManipulationEnabled="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItemChanged="NetworkTreeView_OnSelectedItemChanged" />

            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="5,2.5,2.5,5">
                <Grid
                    Margin="10,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="AddButton"
                        Grid.Column="0"
                        Margin="10"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="AddButton_OnClick"
                        Cursor="Hand"
                        Style="{StaticResource MaterialDesignFlatLightButton}"
                        ToolTip="{DynamicResource NmpAddNetwork}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="PlusNetworkOutline" />

                    </Button>

                    <Button
                        x:Name="EditButton"
                        Grid.Column="1"
                        Margin="10"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="EditButton_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFlatLightButton}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="PencilBoxOutline" />
                    </Button>





                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="2"
                        Margin="10"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="DeleteButton_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFlatLightButton}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="#Cf3539"
                            Kind="DeleteOutline" />

                    </Button>

                </Grid>
            </materialDesign:Card>


        </Grid>





        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,5,2.5,2.5">





            <Button
                Grid.Column="0"
                Width="40"
                Height="30"
                Margin="0"
                Padding="0"
                VerticalAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderThickness="0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="{DynamicResource NmpAddNetwork}"
                Visibility="Collapsed">

                <materialDesign:PackIcon
                    Width="32"
                    Height="32"
                    Kind="PlaylistPlus" />

            </Button>

            <materialDesign:Card
                Height="50"
                Margin="0"
                VerticalAlignment="Center"
                materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ClearSearchKeyWord"
                        Click="ClearSearchKeyWord_OnClick"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                    </Button>
                    <TextBox
                        x:Name="SearchKeyWord"
                        Grid.Column="1"
                        MinWidth="200"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                        BorderThickness="0"
                        KeyDown="SearchKeyWord_OnKeyDown"
                        Opacity="0.3" />
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        Click="SearchButton_OnClick"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                    </Button>
                </Grid>
            </materialDesign:Card>

        </Grid>

        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="1"
            Height="50"
            Margin="2.5,5,5,2.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">


                    <ToggleButton
                        x:Name="ShowModeButton"
                        Width="32"
                        Height="32"
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatListText}"
                        Click="ShowModeButton_OnClick"
                        Content="{materialDesign:PackIcon Kind=Apps}"
                        Style="{StaticResource MaterialDesignActionToggleButton}"
                        ToolTip="{DynamicResource NmpSelectShowMode}" />

                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Value="100" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="OperationPanel"
                            Grid.Column="0"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <RadioButton
                                x:Name="SingleSelectMode"
                                Margin="0"
                                BorderThickness="0"
                                Click="SingleSelectMode_OnClick"
                                IsChecked="True"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource NmpSingle}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="HexagonOutline" />

                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="MultipleSelectMode"
                                Margin="5,0"
                                Click="MultipleSelectMode_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource NmpMulti}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="HexagonMultipleOutline" />

                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="OpenBrowserMode"
                                Margin="5,0"
                                Click="OpenBrowserMode_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource NmpBrowser}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="GoogleChrome" />

                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="PingMode"
                                Margin="5,0"
                                Click="PingMode_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource NmpPing}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="Powershell" />

                                </StackPanel>
                            </RadioButton>


                            <RadioButton
                                x:Name="LogModeButton"
                                Margin="5,0"
                                Click="LogModeButton_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="日志模式"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="MathLog" />

                                </StackPanel>
                            </RadioButton>
                            <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />
                        </StackPanel>


                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                            <Button
                                x:Name="StatusTestButton"
                                Width="32"
                                Height="32"
                                Margin="5,0"
                                materialDesign:ButtonProgressAssist.IndicatorBackground="{DynamicResource MaterialDesignDarkSeparatorBackground}"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="False"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                materialDesign:ElevationAssist.Elevation="Dp1"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="StatusTestButton_OnClick"
                                Content="{materialDesign:PackIcon Radar,
                                                                  Size=24}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="{DynamicResource NmpPingAddress}" />

                            <Button
                                x:Name="ArpTestButton"
                                Width="32"
                                Height="32"
                                Margin="5,0"
                                materialDesign:ButtonProgressAssist.IndicatorBackground="{DynamicResource MaterialDesignDarkSeparatorBackground}"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="False"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                materialDesign:ElevationAssist.Elevation="Dp1"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="ArpTestButton_Click"
                                Content="{materialDesign:PackIcon FileFindOutline,
                                                                  Size=24}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="{DynamicResource NmpGetHostName}" />

                        </StackPanel>



                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">

                            <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />

                            <StackPanel
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=ShowModeButton, Converter={StaticResource BoolToVisibilityConverter}}">


                                <Button
                                    x:Name="ReSort"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="ReSort_OnClick"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource NmpResetSort}"
                                    Visibility="{Binding Path=IsChecked, ElementName=ListButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Restore" />
                                </Button>

                                <Button
                                    x:Name="SetButton"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="SetButton_Click"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource NmpSetNetworkTag}">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="TagEditOutline" />
                                </Button>

                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=ShowModeButton, Converter={StaticResource BoolToVisibilityConverter}}">

                                <ProgressBar
                                    Width="40"
                                    Height="1"
                                    Opacity="0.3"
                                    Orientation="Vertical"
                                    Value="100" />

                                <ToggleButton
                                    x:Name="GlobalToggleButton"
                                    Margin="5,0"
                                    materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=DatabaseSearchOutline,
                                                                                                          Size=24}"
                                    Click="GlobalToggleButton_OnClick"
                                    Content="{materialDesign:PackIcon Kind=LayersSearchOutline,
                                                                      Size=24}"
                                    Style="{StaticResource MaterialDesignActionToggleButton}"
                                    ToolTip="全局搜索/局部搜索" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="ClearGlobalSearchKeyWord"
                                        Click="ClearGlobalSearchKeyWord_OnClick"
                                        Style="{StaticResource MaterialDesignToolButton}">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            Margin="5,0,5,0"
                                            Kind="ClearCircleOutline" />
                                    </Button>
                                    <TextBox
                                        x:Name="GlobalSearchKeyWord"
                                        Grid.Column="1"
                                        MinWidth="200"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                        BorderThickness="0"
                                        KeyDown="GlobalSearchKeyWord_OnKeyDown"
                                        Opacity="0.3" />
                                    <Button
                                        x:Name="GlobalSearchButton"
                                        Grid.Column="2"
                                        Click="GlobalSearchButton_OnClick"
                                        Style="{StaticResource MaterialDesignToolButton}">
                                        <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                                    </Button>
                                </Grid>


                            </StackPanel>

                            <StackPanel
                                x:Name="MultipleAllocationPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=MultipleSelectMode, Converter={StaticResource BoolToVisibilityConverter}}">

                                <ProgressBar
                                    Width="40"
                                    Height="1"
                                    Opacity="0.3"
                                    Orientation="Vertical"
                                    Value="100" />

                                <TextBlock
                                    x:Name="AddressNumber"
                                    MinWidth="30"
                                    Margin="15,0,5,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    d:Text="5"
                                    FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                                    FontSize="22"
                                    ToolTip="{DynamicResource NmpSelectedIp}" />


                                <Button
                                    x:Name="MultipleAllocationButton"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="MultipleAllocationButton_OnClick"
                                    Foreground="LawnGreen"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource NmpConfigSelectedIp}">
                                    <materialDesign:PackIcon Kind="Play" />
                                </Button>

                                <Button
                                    x:Name="ClearSelected"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="ClearSelected_OnClick"
                                    Foreground="OrangeRed"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource NmpClearSelectedIp}">
                                    <materialDesign:PackIcon Kind="Delete" />
                                </Button>

                            </StackPanel>

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=OpenBrowserMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox
                                    x:Name="ProtocolCombobox"
                                    Width="100"
                                    Height="32"
                                    Margin="5,0"
                                    Padding="0"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="LanguageTypescript"
                                    DisplayMemberPath="Protocol"
                                    SelectedIndex="-1"
                                    SelectionChanged="ProtocolCombobox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ToolTip="{DynamicResource NmpSelectProtocol}" />



                                <ComboBox
                                    x:Name="PortComboBox"
                                    Width="100"
                                    Height="32"
                                    Margin="5,0"
                                    Padding="0"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="MidiPort"
                                    DisplayMemberPath="Port"
                                    IsEditable="False"
                                    PreviewKeyDown="PortComboBox_OnKeyDown"
                                    SelectedIndex="-1"
                                    SelectionChanged="PortComboBox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ToolTip="选择端口" />

                                <ComboBox
                                    x:Name="BrowserCombobox"
                                    Width="100"
                                    Height="32"
                                    MinWidth="72"
                                    Margin="5,0"
                                    Padding="0"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="GoogleChrome"
                                    DisplayMemberPath="Browser"
                                    SelectionChanged="BrowserCombobox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ToolTip="{DynamicResource NmpSelectBrowser}" />
                            </StackPanel>



                        </StackPanel>
                    </Grid>


                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchNetwork}"
                    Orientation="Horizontal"
                    Visibility="Visible">

                    <Button
                        x:Name="MultipleDataExport"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        HorizontalAlignment="Right"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="MultipleDataExport_OnClick"
                        Cursor="Hand"
                        IsEnabled="True"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="多重数据导出向导">

                        <materialDesign:PackIcon Kind="DatabaseExportOutline" />

                    </Button>


                    <Button
                        x:Name="DataExport"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        HorizontalAlignment="Right"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="DataExport_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="导出当前网段信息">

                        <materialDesign:PackIcon Kind="TableArrowRight" />

                    </Button>


                </StackPanel>


            </Grid>

        </materialDesign:Card>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:Card Grid.Column="0" Margin="2.5,2.5,5,2.5">
                <Grid>
                    <ScrollViewer
                        x:Name="GraphicalPlan"
                        d:Visibility="Collapsed"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="AddressPanel" Padding="10">
                            <!--  设置 ItemsPanel 为 WrapPanel  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <networkManage1:IpAddressInfo DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                    </ScrollViewer>


                    <DataGrid
                        x:Name="AddressListView"
                        Grid.Column="0"
                        Margin="0,0,0,10"
                        d:ItemsSource="{d:SampleData ItemCount=50}"
                        d:Visibility="Visible"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        MouseDoubleClick="AddressListView_OnMouseDoubleClick"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        Visibility="Collapsed">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            Kind="OrderBoolAscendingVariant" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{DynamicResource NmpDgSelect}"
                                            ToolTip="{DynamicResource NmpDgSelectNote}" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ToggleButton
                                                x:Name="SelectToggleButton"
                                                Grid.Column="0"
                                                Padding="0"
                                                BorderThickness="0"
                                                Checked="SelectToggleButton_Checked"
                                                IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding AddressType}"
                                                Unchecked="SelectToggleButton_OnUnchecked">
                                                <materialDesign:PackIcon Kind="CheckboxBlankOutline" />

                                                <ToggleButton.Style>
                                                    <Style BasedOn="{StaticResource MaterialDesignActionLightToggleButton}" TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Background" Value="LightSeaGreen" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>

                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Address">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            Kind="IpOutline" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{DynamicResource NmpDgIp}"
                                            ToolTip="{DynamicResource NmpDgIpNote}" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid d:Background="#008080" Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="ExtraBold"
                                                Text="{Binding Address}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Address">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            Kind="IpOutline" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{DynamicResource NmpDgIpFull}" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid d:Background="#008080" Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="ExtraBold"
                                                Text="{Binding FullAddress}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PingTime">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            Kind="Radar" />
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{DynamicResource NmpDgPing}"
                                            ToolTip="{DynamicResource NmpDgPingNote}" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
