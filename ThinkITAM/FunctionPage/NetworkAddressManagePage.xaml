                    <Expander
                        x:Name="LogExpander"
                        Margin="0,0"
                        Padding="0"
                        Collapsed="LogExpander_OnCollapsed"
                        ExpandDirection="Left"
                        Expanded="LogExpander_OnExpanded"
                        IsExpanded="{Binding Path=IsChecked, ElementName=LogModeButton}"
                        Visibility="hidden">
                        <Expander.Header>
                            <TextBlock RenderTransformOrigin=".5,.5" Text="IP地址操作日志">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Expander.Header>
                        <Grid
                            Width="300"
                            Margin="0"
                            HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ProgressBar
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Height="2"
                                HorizontalAlignment="Left"
                                Orientation="Vertical"
                                Value="100" />

                            <ListView Grid.Row="0" BorderThickness="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn DisplayMemberBinding="{Binding Index}" Header="序号" />
                                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="时间" />
                                        <GridViewColumn DisplayMemberBinding="{Binding Logs}" Header="操作日志" />

                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBox
                                Grid.Row="1"
                                Width="Auto"
                                Height="150"
                                Margin="0,0"
                                VerticalAlignment="Stretch"
                                materialDesign:HintAssist.FloatingHintHorizontalAlignment="Center"
                                materialDesign:HintAssist.Hint="  日志详情:"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                        </Grid>
                    </Expander>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="1"
            Margin="2.5,2.5,5,5"
            Background="#404040">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="OnlineHost"
                        Width="80"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="在线主机"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="LanConnect"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">

