                        x:Name="Network"
                        Width="130"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="当前网络"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                    <TextBox
                        x:Name="MaskText"
                        Width="135"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="子网掩码"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Lastpass"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />


                    <TextBox
                        x:Name="First"
                        Width="130"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="第一个可用IP"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="PageFirst"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />



                    <TextBox
                        x:Name="Last"
                        Width="130"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="最后一个可用IP"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="PageLast"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                    <TextBox
                        x:Name="Broadcast"
                        Width="130"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="广播地址"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="broadcast"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />


                    <TextBox
                        x:Name="NumBox"
                        Width="130"
                        Margin="5,0,5,10"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        materialDesign:HintAssist.Hint="网段地址总数"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Counter"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}" />



                </StackPanel>
            </Grid>
        </materialDesign:Card>
        <materialDesign:Snackbar
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,10"
            MessageQueue="{Binding MessageQueue}" />
    </Grid>

