<UserControl
    x:Class="ThinkITAM.FunctionPage.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="DimGray"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="1">

            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">


                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                    FontSize="48"
                    Text="{DynamicResource TpTitle}" />


                <WrapPanel
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:ColorZone
                        x:Name="NetworkCalculator"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="NetworkCalculate"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="NetworkCalculate_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="AliceBlue"
                                        Kind="Ipnetwork" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Style="{StaticResource MaterialDesignTextBlock}"
                                            Text="{DynamicResource TpIpCalculate}" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpIpCalculateTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpIpAddress}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpIpAddressCalculate}" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpIpNetmask}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpIpNetmaskCalculate}" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpIpScale}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpIpScaleTooltip}" />
                                    </Grid>
                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="PortScanTool"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="PortScanToolButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="PortScanToolButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="WhiteSmoke"
                                        Kind="MidiPort" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="{DynamicResource TpPortScanTool}" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpPortScanTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpPortScan}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpHostScan}" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="PING" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpHostStatus}" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpHostName}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpHostNameMac}" />
                                    </Grid>
                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="MacVendorTool"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="MacVendorButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="MacVendorButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="AliceBlue"
                                        Kind="ExpansionCard" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="{DynamicResource TpMac}" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpMacTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpMacTooltip2}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpMacTooltip3}" />
                                    </Grid>


                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="DiskCalculation"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">


                        <Button
                            x:Name="DiskCalculationButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="DiskCalculationButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="Aquamarine"
                                        Kind="Hdd" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="{DynamicResource TpStorage}" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpStorageTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="RAID" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpRaidCalculate}"
                                            TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.RowSpan="3"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpVideoStorage}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpVideoStorageTooltip}" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpSaveTime}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpSaveTimeTooltip}" />
                                    </Grid>


                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="WakeOnLan"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="WakeOnLanButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="WakeOnLanButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            Visibility="Visible">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="CornflowerBlue"
                                        Kind="PowerSettings" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="Wake On Lan" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpWakeTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpWakeOnLan}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpWakeOnLanTooltip}" />
                                    </Grid>

                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>


                    <materialDesign:ColorZone
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="NotePadButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="NotePadButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="AliceBlue"
                                        Kind="NotebookPlus" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="70"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="{DynamicResource TpNoteBook}" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpNoteBookTooltip}"
                                            TextWrapping="Wrap" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="{DynamicResource TpNoteBook}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="{DynamicResource TpNoteBookDescription}" />
                                    </Grid>

                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>


                </WrapPanel>

            </StackPanel>

            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Opacity="0.1"
                Style="{StaticResource MaterialDesignHeadline1TextBlock}">
                <Hyperlink IsEnabled="False">
                    IT HELPER TOOLBOX
                </Hyperlink>
            </TextBlock>
        </Grid>

    </Grid>




</UserControl>
