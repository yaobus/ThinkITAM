<UserControl
    x:Class="ThinkITAM.FunctionPage.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="1300"
    MinHeight="800"
    d:Background="DimGray"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="1">

            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">


                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                    FontSize="48"
                    Text="IT 工具箱" />


                <WrapPanel
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:ColorZone
                        x:Name="NetworkCalculator"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="NetworkCalculate"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="NetworkCalculate_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="AliceBlue"
                                        Kind="Ipnetwork" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="50"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62*" />
                                            <RowDefinition Height="38*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Style="{StaticResource MaterialDesignTextBlock}"
                                            Text="IP地址计算器" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="网段信息及可用IP地址信息计算" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="IP地址" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="IP地址计算" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="子网掩码" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="子网掩码计算" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="进制转换" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="IP进制转换" />
                                    </Grid>
                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="PortScanTool"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="PortScanToolButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="PortScanToolButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="WhiteSmoke"
                                        Kind="MidiPort" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="50"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62*" />
                                            <RowDefinition Height="38*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="端口扫描器" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="主机信息扫描辅助工具" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="端口扫描" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="主机端口扫描" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="PING" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="主机在线状态" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="主机名" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="主机名MAC查询" />
                                    </Grid>
                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="MacVendorTool"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="MacVendorButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="MacVendorButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="AliceBlue"
                                        Kind="ExpansionCard" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="50"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62*" />
                                            <RowDefinition Height="38*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="MAC查询厂商" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="根据MAC地址查询设备生产厂商" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="根据厂商识别码OUI查询厂商" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="根据IEEE公开的分配信息查询" />
                                    </Grid>


                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="DiskCalculation"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">


                        <Button
                            x:Name="DiskCalculationButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="DiskCalculationButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="Aquamarine"
                                        Kind="Hdd" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="50"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62*" />
                                            <RowDefinition Height="38*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="存储空间计算" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="计算存储空间容量" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="RAID" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="RAID容量计算" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="监控存储" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="存储空间计算" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="存储时间" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="存储时间计算" />
                                    </Grid>


                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                    <materialDesign:ColorZone
                        x:Name="WakeOnLan"
                        Margin="10,20"
                        CornerRadius="5"
                        Mode="PrimaryLight">

                        <Button
                            x:Name="WakeOnLanButton"
                            Width="300"
                            Height="150"
                            Margin="0"
                            Padding="0"
                            Click="WakeOnLanButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <Grid Width="280" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60*" />
                                    <RowDefinition Height="40*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        Foreground="CornflowerBlue"
                                        Kind="PowerSettings" />

                                    <Grid
                                        Grid.Column="1"
                                        Height="50"
                                        Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62*" />
                                            <RowDefinition Height="38*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="AliceBlue"
                                            Text="Wake On Lan" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="计算存储空间容量" />
                                    </Grid>


                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50*" />
                                            <RowDefinition Height="40*" />
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="AliceBlue"
                                            Opacity="0.9"
                                            Text="网络唤醒" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="AliceBlue"
                                            Opacity="0.5"
                                            Text="局域网内唤醒计算机" />
                                    </Grid>

                                </Grid>




                            </Grid>


                        </Button>


                    </materialDesign:ColorZone>

                </WrapPanel>

            </StackPanel>

            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Opacity="0.1"
                Style="{StaticResource MaterialDesignHeadline1TextBlock}">
                <Hyperlink IsEnabled="False">
                    IT HELPER TOOLBOX
                </Hyperlink>
            </TextBlock>
        </Grid>

    </Grid>




</UserControl>
