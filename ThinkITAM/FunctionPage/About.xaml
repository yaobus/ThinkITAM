<UserControl
    x:Class="ThinkITAM.FunctionPage.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="About_OnLoaded"
    mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline2TextBlock}"
            Text="ThinkITAM" />

        <TextBlock
            x:Name="VersionTextBlock"
            Margin="10"
            HorizontalAlignment="Center"
            d:Text="1.0.XX"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline6TextBlock}" />

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            Style="{StaticResource MaterialDesignBody1TextBlock}"
            Text="Copyright © 2025  Yaobus All Rights Reserved" />

        <StackPanel
            Margin="0,50,0,0"
            Opacity="0.5"
            Orientation="Vertical">

            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="开源版本:" />
            <TextBlock
                x:Name="Sipam"
                Margin="10"
                HorizontalAlignment="Center"
                MouseDown="Sipam_OnMouseDown"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="https://github.com/yaobus/SIPAM" />
            <TextBlock
                x:Name="IpamNote"
                Margin="10"
                HorizontalAlignment="Center"
                MouseDown="IpamNote_OnMouseDown"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="https://github.com/yaobus/IPAM-NOTE" />
        </StackPanel>

    </StackPanel>
</UserControl>
