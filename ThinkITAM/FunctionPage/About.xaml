<UserControl x:Class="ThinkITAM.FunctionPage.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:Background="AliceBlue"
             d:Height="768"
             d:Width="1366"
             FontFamily="{StaticResource HarmonyOsFontFamily}"
             mc:Ignorable="d">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline2TextBlock}"
            Text="ThinkITAM"
            />

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
            Text="1.0.9"
            />

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            Style="{StaticResource MaterialDesignBody1TextBlock}"
            Text="Copyright © 2025  Yaobus All Rights Reserved"

            />

        <StackPanel Margin="0,50,0,0" Orientation="Vertical" Opacity="0.5">

            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="开源版本:"
                />
            <TextBlock
                x:Name="Sipam"
                Margin="10"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="https://github.com/yaobus/SIPAM"
                MouseDown="Sipam_OnMouseDown"
                />
            <TextBlock
                x:Name="IpamNote"
                Margin="10"
                HorizontalAlignment="Center"
                Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="https://github.com/yaobus/IPAM-NOTE"
                MouseDown="IpamNote_OnMouseDown"
                />
        </StackPanel>

    </StackPanel>
</UserControl>
