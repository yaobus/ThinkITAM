<UserControl
    x:Class="ThinkITAM.FunctionPage.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="About_OnLoaded"
    mc:Ignorable="d">


    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline2TextBlock}"
            Text="ThinkITAM" />

        <TextBlock
            x:Name="VersionTextBlock"
            Margin="10"
            HorizontalAlignment="Center"
            d:Text="1.0.XX"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            Style="{StaticResource MaterialDesignHeadline6TextBlock}" />

        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            Style="{StaticResource MaterialDesignBody1TextBlock}"
            Text="Copyright © 2025  Yaobus All Rights Reserved" />


        <StackPanel
            Margin="0,50,0,0"
            HorizontalAlignment="Center"
            Opacity="0.7"
            Orientation="Horizontal">

            <Button
                x:Name="Sipam"
                Width="150"
                Margin="10"
                HorizontalAlignment="Center"
                Click="Sipam_OnClick"
                Style="{StaticResource MaterialDesignOutlinedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Margin="0"
                        VerticalAlignment="Center"
                        Kind="Github" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="SIPAM" />
                </StackPanel>
            </Button>



            <Button
                x:Name="IpamNote"
                Width="150"
                Margin="10"
                HorizontalAlignment="Center"
                Click="IpamNote_OnClick"
                Style="{StaticResource MaterialDesignOutlinedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Margin="0"
                        VerticalAlignment="Center"
                        Kind="Github" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="IPAM-NOTE" />
                </StackPanel>
            </Button>




        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            Opacity="0.7"
            Orientation="Horizontal">

            <Button
                Width="150"
                Margin="10"
                HorizontalAlignment="Center"
                Click="Chip_Click"
                Style="{StaticResource MaterialDesignOutlinedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Margin="0"
                        VerticalAlignment="Center"
                        Kind="ThumbUpOutline" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="赏个好评" />
                </StackPanel>
            </Button>

            <Button
                x:Name="DonateButton"
                Width="150"
                Margin="10"
                HorizontalAlignment="Center"
                Click="DonateButton_OnClick"
                Style="{StaticResource MaterialDesignOutlinedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Margin="0"
                        VerticalAlignment="Center"
                        Kind="HandCoinOutline" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="赏口饭吃" />
                </StackPanel>
            </Button>


        </StackPanel>

        <Button
            x:Name="Feedback"
            Width="150"
            Margin="10"
            HorizontalAlignment="Center"
            Click="Feedback_OnClick"
            Opacity="0.7"
            Style="{StaticResource MaterialDesignOutlinedLightButton}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
                    Margin="0"
                    VerticalAlignment="Center"
                    Kind="Qqchat" />
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Text="我要反馈" />
            </StackPanel>
        </Button>

    </StackPanel>
    <!--  9P4L15BSJWR0  -->







</UserControl>
