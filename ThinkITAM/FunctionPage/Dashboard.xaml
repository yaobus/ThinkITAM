<UserControl
    x:Class="IPAM_NOTE.FunctionPage.Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IPAM_NOTE.FunctionPage"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="1300"
    MinHeight="800"
    d:Background="#383838"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="Dashboard_OnLoaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>





        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>



            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Vertical">

                <Grid
                    Grid.Row="1"
                    Margin="10"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="48"
                        Foreground="AliceBlue"
                        Text="IT Asset Manage" />

                    <materialDesign:Chip
                        Grid.Column="1"
                        Height="38"
                        HorizontalAlignment="Right"
                        Content="Administrator"
                        Icon="A"
                        Style="{StaticResource MaterialDesignOutlineChip}" />

                </Grid>



                <StackPanel Orientation="Horizontal">

                    <materialDesign:Card
                        x:Name="FirstCard"
                        Width="300"
                        Height="150"
                        Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60*" />
                                <RowDefinition Height="40*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    materialDesign:ElevationAssist.Elevation="Dp3"
                                    BorderBrush="Transparent"
                                    Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        Kind="Ipnetwork" />
                                </Button>

                                <Grid
                                    Grid.Column="1"
                                    Height="50"
                                    Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="62*" />
                                        <RowDefinition Height="38*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Foreground="AliceBlue"
                                        Text="网段信息总览" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="网段信息及可用IP地址信息展示" />
                                </Grid>


                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="128" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="网段总数" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="8192" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="地址总数" />
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="4096" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="可用地址数" />
                                </Grid>
                            </Grid>




                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card
                        Width="300"
                        Height="150"
                        Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60*" />
                                <RowDefinition Height="40*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    materialDesign:ElevationAssist.Elevation="Dp3"
                                    Background="LightSeaGreen"
                                    BorderBrush="Transparent"
                                    Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        Kind="Ethernet" />
                                </Button>

                                <Grid
                                    Grid.Column="1"
                                    Height="50"
                                    Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="62*" />
                                        <RowDefinition Height="38*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Foreground="AliceBlue"
                                        Text="设备信息总览" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="设备信息及设备端口信息展示" />
                                </Grid>


                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="64" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="设备总数" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="1024" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="端口总数" />
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="256" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="可用端口数" />
                                </Grid>
                            </Grid>




                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card
                        Width="300"
                        Height="150"
                        Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60*" />
                                <RowDefinition Height="40*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    materialDesign:ElevationAssist.Elevation="Dp3"
                                    Background="Orange"
                                    BorderBrush="Transparent"
                                    Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        Kind="EthernetCable" />
                                </Button>

                                <Grid
                                    Grid.Column="1"
                                    Height="50"
                                    Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="62*" />
                                        <RowDefinition Height="38*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Foreground="AliceBlue"
                                        Text="链路信息总览" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="设备连接链路信息展示" />
                                </Grid>


                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="1024" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="链路总数" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="512" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="双绞线链路" />
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="512" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="光纤链路" />
                                </Grid>
                            </Grid>




                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card
                        Width="300"
                        Height="150"
                        Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60*" />
                                <RowDefinition Height="40*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    materialDesign:ElevationAssist.Elevation="Dp3"
                                    Background="LimeGreen"
                                    BorderBrush="Transparent"
                                    Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                                    <materialDesign:PackIcon
                                        Width="40"
                                        Height="40"
                                        Kind="Warehouse" />
                                </Button>

                                <Grid
                                    Grid.Column="1"
                                    Height="50"
                                    Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="62*" />
                                        <RowDefinition Height="38*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Foreground="AliceBlue"
                                        Text="资产信息总览" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="设备连接链路信息展示" />
                                </Grid>


                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="32" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="资产类型数" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="512" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="资产总数" />
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="40*" />
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        FontSize="20"
                                        Foreground="AliceBlue"
                                        Opacity="0.9"
                                        Text="256" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="AliceBlue"
                                        Opacity="0.5"
                                        Text="在用资产数" />
                                </Grid>
                            </Grid>




                        </Grid>
                    </materialDesign:Card>

                </StackPanel>

                <materialDesign:Card Height="300" Margin="10">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <lvc:PieChart
                            Width="300"
                            Height="300"
                            DataTooltip="{x:Null}"
                            Hoverable="False"
                            LegendLocation="Bottom">
                            <lvc:PieChart.Series>
                                <lvc:PieSeries
                                    Title="Maria"
                                    DataLabels="True"
                                    LabelPoint="{Binding PointLabel}"
                                    Values="8" />
                                <lvc:PieSeries
                                    Title="Charles"
                                    DataLabels="True"
                                    LabelPoint="{Binding PointLabel}"
                                    Values="4" />
                                <lvc:PieSeries
                                    Title="Frida"
                                    DataLabels="True"
                                    LabelPoint="{Binding PointLabel}"
                                    Values="2" />
                                <lvc:PieSeries
                                    Title="Frederic"
                                    DataLabels="True"
                                    LabelPoint="{Binding PointLabel}"
                                    Values="3" />
                            </lvc:PieChart.Series>
                        </lvc:PieChart>

                    </StackPanel>

                </materialDesign:Card>

            </StackPanel>

        </Grid>





    </Grid>


</UserControl>
