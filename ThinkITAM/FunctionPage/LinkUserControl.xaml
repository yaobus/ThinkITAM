<UserControl
    x:Class="ThinkITAM.FunctionPage.LinkUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="https://miroiu.github.io/nodify"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="LinkUserControl_OnLoaded"
    mc:Ignorable="d">


    <UserControl.Resources>
        <GeometryDrawing
            x:Key="SmallGridGeometry"
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

        <GeometryDrawing
            x:Key="LargeGridGeometry"
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

        <DrawingBrush
            x:Key="SmallGridLinesDrawingBrush"
            Drawing="{StaticResource SmallGridGeometry}"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=RackPanel}"
            Viewport="0 0 20 20"
            ViewportUnits="Absolute" />

        <DrawingBrush
            x:Key="LargeGridLinesDrawingBrush"
            Drawing="{StaticResource LargeGridGeometry}"
            Opacity="1"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=RackPanel}"
            Viewport="0 0 100 100"
            ViewportUnits="Absolute" />


        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:FirstCharToVisibilityConverter x:Key="FirstCharToVisibilityConverter" />
        <converters:FirstChar2ToVisibilityConverter x:Key="FirstChar2ToVisibilityConverter" />
        <converters:FirstCharToMaterialIconConverter x:Key="FirstCharToMaterialIconConverter" />
        <converters:FirstCharToColorConverter x:Key="FirstCharToColorConverter" />
        <converters:BackgroundColorConverter x:Key="BackgroundColorConverter" />

    </UserControl.Resources>

    <!--<Grid >


    </Grid>-->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>


        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ClearSearchKeyWord"
                    Click="ClearSearchKeyWord_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    KeyDown="SearchKeyWord_OnKeyDown"
                    Opacity="0.3" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Click="SearchButton_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <TreeView
                x:Name="LinkTreeView"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItemChanged="LinkTreeView_OnSelectedItemChanged" />


        </materialDesign:Card>




        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>



                <materialDesign:PopupBox
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    Padding="0"
                    BorderThickness="0">

                    <materialDesign:PopupBox.ToggleContent>

                        <materialDesign:ColorZone
                            Width="80"
                            Height="32"
                            Background="Transparent"
                            ClipToBounds="False"
                            CornerRadius="5">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="PlusBoxOutline" />


                        </materialDesign:ColorZone>




                    </materialDesign:PopupBox.ToggleContent>

                    <StackPanel>
                        <Button
                            x:Name="AddRoomButton"
                            Width="80"
                            Margin="5"
                            Padding="0"
                            Click="AddRoomButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="{DynamicResource LucAddRoom}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="House" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource LucRoom}" />
                            </StackPanel>

                        </Button>
                        <Button
                            x:Name="AddCabinetButton"
                            Width="80"
                            Margin="5"
                            Padding="0"
                            Click="AddCabinetButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="{DynamicResource LucAddCabinet}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ViewCarousel" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource LucCabinet}" />
                            </StackPanel>

                        </Button>
                        <Button
                            x:Name="AddRackButton"
                            Width="80"
                            Margin="5"
                            Padding="0"
                            Click="AddRackButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="{DynamicResource LucAddRack}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="VideoInputComponent" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource LucRack}" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>



                <Button
                    x:Name="EditButton"
                    Grid.Column="1"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    Visibility="Hidden">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="PencilBoxOutline" />
                </Button>





                <Button
                    x:Name="DeleteButton"
                    Grid.Column="2"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="DeleteButton_OnClick"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Foreground="#CF3539"
                        Kind="DeleteOutline" />

                </Button>

            </Grid>
        </materialDesign:Card>


        <Expander
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            MaxWidth="280"
            materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
            ExpandDirection="Right"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock RenderTransformOrigin=".5,.5" Text="{DynamicResource LucDeviceList}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <Grid>

                <materialDesign:Card Margin="2.5,2.5,2.5,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <ListView
                            x:Name="CabinetListView"
                            Grid.Row="0"
                            AllowDrop="True"
                            DataContext="vm:RackInfo"
                            IsManipulationEnabled="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionChanged="CabinetListView_OnSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
                                        <Grid Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Background="#2daf94">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                                                    Foreground="AliceBlue"
                                                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                    Text="{Binding Index}" />
                                            </Grid>



                                            <Grid Grid.Column="1" Background="{Binding rackId, Converter={StaticResource FirstCharToColorConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="70*" />
                                                    <RowDefinition Height="30*" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="5,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource HarmonyOsFontFamilyMedium}"
                                                        Foreground="AliceBlue"
                                                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                        Text="{Binding rackName}" />



                                                    <materialDesign:PackIcon
                                                        Grid.Column="1"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Kind="{Binding rackId, Converter={StaticResource FirstCharToMaterialIconConverter}}"
                                                        Opacity="0.3" />

                                                </Grid>


                                                <StackPanel
                                                    Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding rackId, Converter={StaticResource FirstCharToVisibilityConverter}}">

                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Text="{Binding slotCount}"
                                                        ToolTip="{DynamicResource LucSlotNumber}" />

                                                    <Label
                                                        Padding="0"
                                                        Content="/"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5" />

                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Text="{Binding portCount}"
                                                        ToolTip="{DynamicResource LucPortNumber}" />

                                                </StackPanel>

                                                <Grid Grid.Row="1" Visibility="{Binding rackId, Converter={StaticResource FirstChar2ToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <Grid.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="Black" />
                                                                <GradientStop Offset="0.8" Color="Black" />
                                                                <GradientStop Offset="1" Color="Transparent" />
                                                            </LinearGradientBrush>
                                                        </Grid.OpacityMask>

                                                        <TextBlock
                                                            Margin="5,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="AliceBlue"
                                                            Opacity="0.5"
                                                            Text="{Binding Model}"
                                                            ToolTip="{Binding Model}" />
                                                    </Grid>



                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="5,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Text="{Binding AssetNumber}"
                                                        ToolTip="{Binding AssetNumber}" />

                                                </Grid>


                                            </Grid>

                                        </Grid>


                                    </materialDesign:Card>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>


                    </Grid>
                </materialDesign:Card>

            </Grid>

        </Expander>



        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="2"
            Height="50"
            Margin="2.5,5,5,2.5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">


                    <ToggleButton
                        x:Name="ShowModeButton"
                        Width="32"
                        Height="32"
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatListText}"
                        Content="{materialDesign:PackIcon Kind=Apps}"
                        Style="{StaticResource MaterialDesignActionToggleButton}"
                        ToolTip="切换图形/列表显示模式"
                        Visibility="Collapsed" />

                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Visibility="Collapsed"
                        Value="100" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="OperationPanel"
                            Grid.Column="0"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <RadioButton
                                x:Name="TempManage"
                                Margin="0"
                                BorderThickness="0"
                                Click="TempManage_OnClick"
                                IsChecked="True"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource LucLinkView}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="CableData" />

                                </StackPanel>
                            </RadioButton>


                            <RadioButton
                                x:Name="LinkManage"
                                Margin="5,0"
                                Click="LinkManage_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource LucLinkManage}"
                                Visibility="Visible">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="EthernetCable" />

                                </StackPanel>
                            </RadioButton>





                            <RadioButton
                                x:Name="LinkClear"
                                Margin="5,0"
                                Click="LinkClear_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="{DynamicResource LucLinkDelete}"
                                Visibility="Visible">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="LinkVariantOff" />

                                </StackPanel>
                            </RadioButton>


                        </StackPanel>



                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">

                            <Button
                                x:Name="ReSort"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="重置为默认排序">
                                <materialDesign:PackIcon Kind="Restore" />
                            </Button>

                            <Button
                                x:Name="SetButton"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="自定义端口信息标签">
                                <materialDesign:PackIcon Kind="Settings" />
                            </Button>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">



                            <StackPanel
                                x:Name="MultipleAllocationPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <ProgressBar
                                    Width="40"
                                    Height="1"
                                    Opacity="0.3"
                                    Orientation="Vertical"
                                    Value="100" />

                                <Button
                                    x:Name="DeleteSelectedRack"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="DeleteSelectedRack_OnClick"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource LucDeviceRemove}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" />
                                </Button>

                                <Button
                                    x:Name="ClearRackPanel"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="ClearRackPanel_OnClick"
                                    Foreground="OrangeRed"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="{DynamicResource LucClearRackPanel}">
                                    <materialDesign:PackIcon Kind="Autorenew" />
                                </Button>


                                <!--<StackPanel
                                VerticalAlignment="Center"
                                d:Visibility="Visible"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=PermanentManage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />



                                <Button
                                x:Name="SaveLinkConfig"
                                Margin="0,0"
                                Click="SaveLinkConfig_OnClick"
                                IsEnabled="{Binding Path=IsChecked, ElementName=AutoSaveLinkConfig, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="保存链路配置">
                                <materialDesign:PackIcon Kind="ContentSave" />
                                </Button>

                                <ToggleButton
                                x:Name="AutoSaveLinkConfig"
                                Width="26"
                                Height="26"
                                Margin="10,0"
                                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=ContentSaveMoveOutline}"
                                Content="{materialDesign:PackIcon Kind=Numeric1CircleOutline}"
                                Style="{StaticResource MaterialDesignActionToggleButton}"
                                ToolTip="启用连续自动保存链路配置" />

                                </StackPanel>-->

                                <!--<StackPanel
                                VerticalAlignment="Center"
                                d:Visibility="Visible"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=IsChecked, ElementName=LinkClear, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />
                                <ToggleButton
                                x:Name="PerLink"
                                Width="26"
                                Height="26"
                                Margin="10,0"
                                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=LinkEdit}"
                                Click="PerLink_OnClick"
                                Content="{materialDesign:PackIcon Kind=LinkVariant}"
                                Foreground="MediumVioletRed"
                                Style="{StaticResource MaterialDesignActionToggleButton}"
                                ToolTip="清除永久链路配置" />

                                <ToggleButton
                                x:Name="TempLink"
                                Width="26"
                                Height="26"
                                Margin="10,0"
                                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=LinkEdit}"
                                Click="TempLink_OnClick"
                                Content="{materialDesign:PackIcon Kind=LinkVariant}"
                                Foreground="LawnGreen"
                                Style="{StaticResource MaterialDesignActionToggleButton}"
                                ToolTip="清除临时链路配置" />

                                </StackPanel>-->

                            </StackPanel>


                        </StackPanel>
                    </Grid>



                </StackPanel>



            </Grid>

        </materialDesign:Card>

        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <materialDesign:Card
                Grid.Row="0"
                Grid.Column="0"
                MaxHeight="210"
                Margin="2.5,2.5,2.5,0"
                d:Height="105"
                d:Visibility="Visible"
                BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        Grid.Row="0"
                        VerticalAlignment="Stretch"
                        d:Background="Orange"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <WrapPanel
                            x:Name="DevicePortPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />



                    </ScrollViewer>

                    <StackPanel
                        x:Name="DeviceInfoPlan"
                        Grid.Row="1"
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Opacity="0.5"
                        Orientation="Horizontal">
                        <Label
                            Margin="10,0"
                            Padding="0"
                            Content="{Binding rackName}" />
                        <Label
                            Margin="10,0"
                            Padding="0"
                            Content="{Binding AssetNumber}" />
                        <Label
                            Margin="10,0"
                            Padding="0"
                            Content="{Binding Model}" />
                    </StackPanel>

                </Grid>


            </materialDesign:Card>


            <materialDesign:Card
                Grid.Row="1"
                Grid.Column="0"
                Margin="2.5,0,2.5,0"
                VerticalAlignment="Stretch"
                d:Background="Chartreuse"
                BorderThickness="0.5">

                <Grid Background="{StaticResource NodifyEditor.BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>



                    <TextBlock
                        x:Name="ItemCount"
                        Grid.Row="0"
                        Height="20"
                        Margin="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        d:Text="12"
                        FontSize="16"
                        Foreground="DarkCyan" />

                    <nodify:NodifyEditor
                        x:Name="RackPanel"
                        Grid.Row="0"
                        AllowDrop="True"
                        Background="{StaticResource SmallGridLinesDrawingBrush}"
                        MaxViewportZoom="2.5"
                        MinViewportZoom="0.4">
                        <nodify:NodifyEditor.ItemContainerStyle>
                            <Style TargetType="{x:Type nodify:ItemContainer}">
                                <Setter Property="Location" Value="{Binding Location}" />
                            </Style>
                        </nodify:NodifyEditor.ItemContainerStyle>

                    </nodify:NodifyEditor>

                    <Grid
                        Grid.Row="0"
                        Panel.ZIndex="-2"
                        Background="{StaticResource LargeGridLinesDrawingBrush}" />


                </Grid>

            </materialDesign:Card>

            <materialDesign:Card
                Grid.Row="2"
                Grid.Column="0"
                MaxHeight="180"
                Margin="2.5,0,2.5,5"
                VerticalAlignment="Stretch"
                BorderThickness="0.5">

                <Grid>

                    <materialDesign:TransitioningContent
                        x:Name="GraphPanel"
                        Margin="0"
                        d:Height="150"
                        d:Visibility="Visible"
                        OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom,
                                                                        Duration=0:0:0.2}"
                        Visibility="{Binding Path=IsChecked, ElementName=LinkManage, Converter={StaticResource BoolToVisibilityConverter}}">


                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                x:Name="RoutePanel"
                                Grid.Column="0"
                                dd:DragDrop.IsDragSource="True"
                                dd:DragDrop.IsDropTarget="True"
                                BorderThickness="0.5">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>

                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <linkPage:NodePort Margin="5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <Button
                                    x:Name="ClearSelect"
                                    Margin="5,5"
                                    Click="ClearSelect_OnClick"
                                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                                    ToolTip="{DynamicResource LucClearSelect}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon Margin="5,0" Kind="DeleteSweepOutline" />
                                        <TextBlock Text="{DynamicResource LucClearNode}" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="SaveLinkButton"
                                    Margin="5,5"
                                    Click="SaveLinkButton_OnClick"
                                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                                    ToolTip="{DynamicResource LucSaveLinkTooltip}">

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon Margin="5,0" Kind="ContentSave" />
                                        <TextBlock Text="{DynamicResource LucSaveLink}" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>


                        </Grid>
                    </materialDesign:TransitioningContent>

                    <materialDesign:TransitioningContent
                        x:Name="ViewPanel"
                        Margin="0"
                        d:Visibility="Visible"
                        OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom,
                                                                        Duration=0:0:0.2}"
                        Visibility="{Binding Path=IsChecked, ElementName=TempManage, Converter={StaticResource BoolToVisibilityConverter}}">


                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                x:Name="RouteViewPanel"
                                Grid.Column="0"
                                BorderThickness="1"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <linkPage:NodePort Margin="5,0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Grid>
                    </materialDesign:TransitioningContent>


                </Grid>


            </materialDesign:Card>







        </Grid>



        <Expander
            x:Name="PanelPortExpander"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="3"
            materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
            ExpandDirection="Right"
            IsExpanded="False">
            <!--  Visibility="{Binding Path=IsChecked, ElementName=LinkManage, Converter={StaticResource BoolToVisibilityConverter}}"  -->
            <Expander.Header>
                <TextBlock
                    HorizontalAlignment="Center"
                    RenderTransformOrigin=".5,.5"
                    Text="{DynamicResource LucLinkPort}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <materialDesign:Card
                Margin="0"
                Padding="5"
                materialDesign:ElevationAssist.Elevation="Dp0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,2.5"
                        Orientation="Vertical">

                        <materialDesign:ColorZone
                            Height="50"
                            Margin="0,0,0,2.5"
                            VerticalAlignment="Center"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            CornerRadius="5"
                            Mode="Standard">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSearchKeyWord3" Style="{StaticResource MaterialDesignToolButton}">
                                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                                </Button>
                                <TextBox
                                    x:Name="SearchKeyWord3"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                    BorderThickness="0"
                                    Opacity="0.3" />
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}">
                                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                                </Button>
                            </Grid>
                        </materialDesign:ColorZone>

                        <materialDesign:ColorZone
                            Height="50"
                            Margin="0,5,0,2.5"
                            VerticalAlignment="Center"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            CornerRadius="5"
                            Mode="Standard">
                            <ComboBox
                                x:Name="BuildingsComboBox"
                                Margin="5,5,2.5,2.5"
                                Padding="5,10"
                                materialDesign:HintAssist.Hint="{DynamicResource LucSelectBuilding}"
                                BorderThickness="0"
                                DisplayMemberPath="Building"
                                MaxDropDownHeight="300"
                                SelectionChanged="BuildingsComboBox_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </materialDesign:ColorZone>


                        <materialDesign:ColorZone
                            Height="50"
                            Margin="0,5,0,2.5"
                            VerticalAlignment="Center"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            CornerRadius="5"
                            Mode="Standard">
                            <ComboBox
                                x:Name="FloorComboBox"
                                Margin="5,5,2.5,2.5"
                                Padding="5,10"
                                materialDesign:HintAssist.Hint="{DynamicResource LucSelectFloor}"
                                BorderThickness="0"
                                DisplayMemberPath="Floor"
                                MaxDropDownHeight="300"
                                SelectionChanged="FloorComboBox_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </materialDesign:ColorZone>

                        <materialDesign:ColorZone
                            Height="50"
                            Margin="0,5,0,2.5"
                            VerticalAlignment="Center"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            CornerRadius="5"
                            Mode="Standard">

                            <ComboBox
                                x:Name="RoomComboBox"
                                Margin="5,5,2.5,2.5"
                                Padding="5,10"
                                materialDesign:HintAssist.Hint="{DynamicResource LucSelectRoom}"
                                BorderThickness="0"
                                DisplayMemberPath="RoomNumber"
                                MaxDropDownHeight="300"
                                SelectionChanged="RoomComboBox_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </materialDesign:ColorZone>


                    </StackPanel>

                    <materialDesign:Card Grid.Row="1" Margin="0,2.5,0,5">
                        <TabControl
                            Width="300"
                            Style="{StaticResource MaterialDesignFilledTabControl}"
                            TabStripPlacement="Bottom">


                            <TabItem Header="{DynamicResource LucWallPort}">


                                <ScrollViewer
                                    VerticalAlignment="Stretch"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <WrapPanel
                                        x:Name="PortManagePanel"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

                                </ScrollViewer>



                            </TabItem>

                            <TabItem Header="{DynamicResource LucDevices}">



                                <ScrollViewer
                                    VerticalAlignment="Stretch"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <WrapPanel
                                        x:Name="DevicePortPanel2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />



                                </ScrollViewer>






                            </TabItem>
                        </TabControl>
                    </materialDesign:Card>
                </Grid>
            </materialDesign:Card>



        </Expander>



        <materialDesign:DialogHost
            x:Name="SaveLinkNameDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            d:Visibility="Collapsed"
            CloseOnClickAway="True"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">
                    <TextBlock
                        MaxWidth="400"
                        FontSize="14"
                        Text="{DynamicResource LucLinkName}" />
                    <TextBox
                        x:Name="NameTextBox"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        FontSize="14" />

                    <CheckBox
                        x:Name="TagSyncButton"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Content="{DynamicResource LucLinkTagSync}"
                        IsChecked="False"
                        Style="{StaticResource MaterialDesignSecondaryCheckBox}"
                        ToolTip="{DynamicResource LucLinkTagSyncTooltip}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SaveButton"
                            Margin="0,8,8,0"
                            Click="SaveButton_OnClick"
                            Content="{DynamicResource LucLinkSave}"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Margin="0,8,8,0"
                            Click="CancelButton_OnClick"
                            Content="{DynamicResource LucLinkClose}"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>


    </Grid>
</UserControl>
