<UserControl
    x:Class="ThinkITAM.FunctionPage.LinkUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="https://miroiu.github.io/nodify"
    MinWidth="1200"
    MinHeight="700"
    d:Background="#333333"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="LinkUserControl_OnLoaded"
    mc:Ignorable="d">


    <UserControl.Resources>
        <GeometryDrawing
            x:Key="SmallGridGeometry"
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

        <GeometryDrawing
            x:Key="LargeGridGeometry"
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

        <DrawingBrush
            x:Key="SmallGridLinesDrawingBrush"
            Drawing="{StaticResource SmallGridGeometry}"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=RackPanel}"
            Viewport="0 0 20 20"
            ViewportUnits="Absolute" />

        <DrawingBrush
            x:Key="LargeGridLinesDrawingBrush"
            Drawing="{StaticResource LargeGridGeometry}"
            Opacity="1"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=RackPanel}"
            Viewport="0 0 100 100"
            ViewportUnits="Absolute" />


        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <!--<Grid >


    </Grid>-->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>


        <materialDesign:ColorZone
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="#404040"
            CornerRadius="5"
            Mode="Standard">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ClearSearchKeyWord" Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="搜索关键字"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    Opacity="0.3" />
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:ColorZone>


        <materialDesign:ColorZone
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="#404040"
            CornerRadius="5"
            Mode="Standard">
            <TreeView
                x:Name="LinkTreeView"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItemChanged="LinkTreeView_OnSelectedItemChanged" />


        </materialDesign:ColorZone>




        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5"
            Background="#404040">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>



                <materialDesign:PopupBox
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    Padding="0"
                    BorderThickness="0">

                    <materialDesign:PopupBox.ToggleContent>

                        <materialDesign:ColorZone
                            Width="80"
                            Height="32"
                            Background="Transparent"
                            ClipToBounds="False"
                            CornerRadius="5">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="PlusBoxOutline" />


                        </materialDesign:ColorZone>




                    </materialDesign:PopupBox.ToggleContent>

                    <StackPanel>
                        <Button
                            x:Name="AddRoomButton"
                            Width="80"
                            Margin="0,10,0,5"
                            Padding="0"
                            Click="AddRoomButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="添加机房或配线间分组">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="House" />
                                <TextBlock VerticalAlignment="Center">设备间</TextBlock>
                            </StackPanel>

                        </Button>
                        <Button
                            x:Name="AddCabinetButton"
                            Width="80"
                            Margin="0,5"
                            Padding="0"
                            Click="AddCabinetButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="添加机柜或自定义分组">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ViewCarousel" />
                                <TextBlock VerticalAlignment="Center">设备柜</TextBlock>
                            </StackPanel>

                        </Button>
                        <Button
                            x:Name="AddRackButton"
                            Width="80"
                            Margin="0,5"
                            Padding="0"
                            Click="AddRackButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="添加配线设备">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="VideoInputComponent" />
                                <TextBlock VerticalAlignment="Center">配线架</TextBlock>
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>



                <Button
                    x:Name="EditButton"
                    Grid.Column="1"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="PencilBoxOutline" />
                </Button>





                <Button
                    x:Name="DeleteButton"
                    Grid.Column="2"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Foreground="#CF3539"
                        Kind="DeleteOutline" />

                </Button>

            </Grid>
        </materialDesign:Card>


        <Expander
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
            ExpandDirection="Right"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock RenderTransformOrigin=".5,.5" Text="设备列表">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <Grid>

                <materialDesign:Card Margin="2.5,2.5,2.5,5" Background="#404040">

                    <ListView
                        x:Name="CabinetListView"
                        AllowDrop="True"
                        DataContext="vm:RackInfo"
                        IsManipulationEnabled="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="CabinetListView_OnSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
                                    <Grid Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Background="#6ddabe">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="ExtraBlack"
                                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                Text="{Binding Index}" />
                                        </Grid>
                                        <Grid Grid.Column="1" Background="#00A0A0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="70*" />
                                                <RowDefinition Height="30*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                    Text="{Binding rackName}" />

                                                <materialDesign:PackIcon
                                                    Grid.Column="1"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="AliceBlue"
                                                    Kind="VideoInputComponent"
                                                    Opacity="0.3" />

                                            </Grid>


                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                Opacity="0.5"
                                                Text="{Binding rackNote}" />


                                        </Grid>

                                    </Grid>


                                </materialDesign:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </materialDesign:Card>

            </Grid>

        </Expander>



        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="2"
            Height="50"
            Margin="2.5,5,5,2.5"
            Background="#404040">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">


                    <ToggleButton
                        x:Name="ShowModeButton"
                        Width="32"
                        Height="32"
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatListText}"
                        Content="{materialDesign:PackIcon Kind=Apps}"
                        Style="{StaticResource MaterialDesignActionToggleButton}"
                        ToolTip="切换图形/列表显示模式" />

                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Value="100" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="OperationPanel"
                            Grid.Column="0"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <RadioButton
                                x:Name="TempManage"
                                Margin="0"
                                BorderThickness="0"
                                Click="TempManage_OnClick"
                                IsChecked="True"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="链路预览">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="CableData" />

                                </StackPanel>
                            </RadioButton>


                            <RadioButton
                                x:Name="LinkManage"
                                Margin="5,0"
                                Click="LinkManage_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="临时链路关联管理模式"
                                Visibility="Visible">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="EthernetCable" />

                                </StackPanel>
                            </RadioButton>





                            <RadioButton
                                x:Name="LinkClear"
                                Margin="5,0"
                                Click="LinkClear_OnClick"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="链路清除模式"
                                Visibility="Visible">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="LinkVariantOff" />

                                </StackPanel>
                            </RadioButton>


                        </StackPanel>



                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">

                            <Button
                                x:Name="ReSort"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="重置为默认排序">
                                <materialDesign:PackIcon Kind="Restore" />
                            </Button>

                            <Button
                                x:Name="SetButton"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="自定义端口信息标签">
                                <materialDesign:PackIcon Kind="Settings" />
                            </Button>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">



                            <StackPanel
                                x:Name="MultipleAllocationPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <ProgressBar
                                    Width="40"
                                    Height="1"
                                    Opacity="0.3"
                                    Orientation="Vertical"
                                    Value="100" />

                                <Button
                                    x:Name="DeleteSelectedRack"
                                    Margin="0,0"
                                    Click="DeleteSelectedRack_OnClick"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="移除选中设备">
                                    <materialDesign:PackIcon Kind="DeleteOutline" />
                                </Button>

                                <Button
                                    x:Name="ClearRackPanel"
                                    Margin="0,0"
                                    Click="ClearRackPanel_OnClick"
                                    Foreground="OrangeRed"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="重置操作区">
                                    <materialDesign:PackIcon Kind="Autorenew" />
                                </Button>


                                <StackPanel
                                    VerticalAlignment="Center"
                                    d:Visibility="Visible"
                                    Orientation="Horizontal"
                                    Visibility="{Binding Path=IsChecked, ElementName=PermanentManage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar
                                        Width="40"
                                        Height="1"
                                        Opacity="0.3"
                                        Orientation="Vertical"
                                        Value="100" />

                                    <Button
                                        x:Name="ClearSelect"
                                        Margin="0,0"
                                        Click="ClearSelect_OnClick"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="清空已选端口">
                                        <materialDesign:PackIcon Kind="FileDocumentRemoveOutline" />
                                    </Button>

                                    <Button
                                        x:Name="SaveLinkConfig"
                                        Margin="0,0"
                                        Click="SaveLinkConfig_OnClick"
                                        IsEnabled="{Binding Path=IsChecked, ElementName=AutoSaveLinkConfig, Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="保存链路配置">
                                        <materialDesign:PackIcon Kind="ContentSave" />
                                    </Button>

                                    <ToggleButton
                                        x:Name="AutoSaveLinkConfig"
                                        Width="26"
                                        Height="26"
                                        Margin="10,0"
                                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=ContentSaveMoveOutline}"
                                        Content="{materialDesign:PackIcon Kind=Numeric1CircleOutline}"
                                        Style="{StaticResource MaterialDesignActionToggleButton}"
                                        ToolTip="启用连续自动保存链路配置" />

                                </StackPanel>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    d:Visibility="Visible"
                                    Orientation="Horizontal"
                                    Visibility="{Binding Path=IsChecked, ElementName=LinkClear, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar
                                        Width="40"
                                        Height="1"
                                        Opacity="0.3"
                                        Orientation="Vertical"
                                        Value="100" />
                                    <ToggleButton
                                        x:Name="PerLink"
                                        Width="26"
                                        Height="26"
                                        Margin="10,0"
                                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=LinkEdit}"
                                        Click="PerLink_OnClick"
                                        Content="{materialDesign:PackIcon Kind=LinkVariant}"
                                        Foreground="MediumVioletRed"
                                        Style="{StaticResource MaterialDesignActionToggleButton}"
                                        ToolTip="清除永久链路配置" />

                                    <ToggleButton
                                        x:Name="TempLink"
                                        Width="26"
                                        Height="26"
                                        Margin="10,0"
                                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=LinkEdit}"
                                        Click="TempLink_OnClick"
                                        Content="{materialDesign:PackIcon Kind=LinkVariant}"
                                        Foreground="LawnGreen"
                                        Style="{StaticResource MaterialDesignActionToggleButton}"
                                        ToolTip="清除临时链路配置" />

                                </StackPanel>

                            </StackPanel>


                        </StackPanel>
                    </Grid>



                </StackPanel>



            </Grid>

        </materialDesign:Card>




        <materialDesign:Card
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="2.5,2.5,2.5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{StaticResource NodifyEditor.BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="ItemCount"
                        Grid.Row="0"
                        Height="20"
                        Margin="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        d:Text="12"
                        FontSize="16"
                        FontWeight="ExtraBold"
                        Foreground="AliceBlue" />

                    <nodify:NodifyEditor
                        x:Name="RackPanel"
                        Grid.Row="0"
                        AllowDrop="True"
                        Background="{StaticResource SmallGridLinesDrawingBrush}"
                        MaxViewportZoom="2.5"
                        MinViewportZoom="0.5">
                        <nodify:NodifyEditor.ItemContainerStyle>
                            <Style TargetType="{x:Type nodify:ItemContainer}">
                                <Setter Property="Location" Value="{Binding Location}" />
                            </Style>
                        </nodify:NodifyEditor.ItemContainerStyle>

                    </nodify:NodifyEditor>

                    <Grid
                        Grid.Row="0"
                        Panel.ZIndex="-2"
                        Background="{StaticResource LargeGridLinesDrawingBrush}" />

                    <materialDesign:TransitioningContent
                        x:Name="GraphPanel"
                        Grid.Row="1"
                        Margin="0"
                        Background="#333333"
                        OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom,
                                                                        Duration=0:0:0.2}"
                        Visibility="{Binding Path=IsChecked, ElementName=LinkManage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>

                            <ListBox
                                x:Name="RoutePanel"
                                dd:DragDrop.IsDragSource="True"
                                dd:DragDrop.IsDropTarget="True">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>

                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <linkPage:NodePort Margin="5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>



                            <!--<ScrollViewer
                                d:Height="160"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">

                                <ItemsControl x:Name="RoutePanel" Padding="0">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal" />

                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <linkPage:NodePort Margin="5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>-->


                        </Grid>
                    </materialDesign:TransitioningContent>
                </Grid>

                <Expander
                    Grid.Column="1"
                    materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
                    Background="#333333"
                    ExpandDirection="Right"
                    IsExpanded="True"
                    Visibility="{Binding Path=IsChecked, ElementName=LinkManage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="AliceBlue"
                            RenderTransformOrigin=".5,.5"
                            Text="关联端口">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Expander.Header>

                    <materialDesign:Card
                        Margin="0,0,5,0"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Background="#333333">
                        <TabControl
                            Width="300"
                            Margin="0"
                            HorizontalContentAlignment="Stretch"
                            materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                            Background="#333333">
                            <TabItem Header="设备端口">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="5,5,0,2.5"
                                        Orientation="Vertical">


                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ClearSearchKeyWord2" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                                                </Button>
                                                <TextBox
                                                    x:Name="SearchKeyWord2"
                                                    Grid.Column="1"
                                                    MinWidth="200"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    materialDesign:HintAssist.Hint="搜索设备关键字"
                                                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                    BorderThickness="0"
                                                    Opacity="0.3" />
                                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                                                </Button>
                                            </Grid>
                                        </materialDesign:ColorZone>



                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">

                                            <ComboBox
                                                x:Name="DeviceGroups"
                                                Margin="5,5,2.5,2.5"
                                                Padding="5,10"
                                                materialDesign:HintAssist.Hint="选择设备分组"
                                                BorderThickness="0"
                                                DisplayMemberPath="AssetType"
                                                MaxDropDownHeight="300"
                                                SelectionChanged="DeviceGroups_OnSelectionChanged"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        </materialDesign:ColorZone>

                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">
                                            <ComboBox
                                                x:Name="AssetsComboBox"
                                                Margin="5,5,2.5,2.5"
                                                Padding="5,10"
                                                materialDesign:HintAssist.Hint="选择设备"
                                                BorderThickness="0"
                                                DisplayMemberPath="AssetNumber"
                                                MaxDropDownHeight="300"
                                                SelectionChanged="AssetsComboBox_OnSelectionChanged"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        </materialDesign:ColorZone>


                                    </StackPanel>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="5,2.5,0,0"
                                        VerticalAlignment="Stretch">
                                        <materialDesign:ColorZone
                                            Margin="2.5,0,0,0"
                                            VerticalAlignment="Stretch"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">

                                            <ScrollViewer
                                                VerticalAlignment="Stretch"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">

                                                <WrapPanel
                                                    x:Name="DevicePortPanel"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />



                                            </ScrollViewer>




                                        </materialDesign:ColorZone>
                                    </Grid>


                                </Grid>



                            </TabItem>

                            <TabItem Header="墙面端口">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="5,5,0,2.5"
                                        Orientation="Vertical">

                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ClearSearchKeyWord3" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                                                </Button>
                                                <TextBox
                                                    x:Name="SearchKeyWord3"
                                                    Grid.Column="1"
                                                    MinWidth="200"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    materialDesign:HintAssist.Hint="搜索关键字"
                                                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                    BorderThickness="0"
                                                    Opacity="0.3" />
                                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                                                </Button>
                                            </Grid>
                                        </materialDesign:ColorZone>

                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">
                                            <ComboBox
                                                x:Name="BuildingsComboBox"
                                                Margin="5,5,2.5,2.5"
                                                Padding="5,10"
                                                materialDesign:HintAssist.Hint="选择建筑物"
                                                BorderThickness="0"
                                                DisplayMemberPath="Building"
                                                MaxDropDownHeight="300"
                                                SelectionChanged="BuildingsComboBox_OnSelectionChanged"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        </materialDesign:ColorZone>


                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">
                                            <ComboBox
                                                x:Name="FloorComboBox"
                                                Margin="5,5,2.5,2.5"
                                                Padding="5,10"
                                                materialDesign:HintAssist.Hint="选择楼层"
                                                BorderThickness="0"
                                                DisplayMemberPath="Floor"
                                                MaxDropDownHeight="300"
                                                SelectionChanged="FloorComboBox_OnSelectionChanged"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        </materialDesign:ColorZone>

                                        <materialDesign:ColorZone
                                            Height="50"
                                            Margin="2.5,5,0,2.5"
                                            VerticalAlignment="Center"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">

                                            <ComboBox
                                                x:Name="RoomComboBox"
                                                Margin="5,5,2.5,2.5"
                                                Padding="5,10"
                                                materialDesign:HintAssist.Hint="选择房间"
                                                BorderThickness="0"
                                                DisplayMemberPath="RoomNumber"
                                                MaxDropDownHeight="300"
                                                SelectionChanged="RoomComboBox_OnSelectionChanged"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        </materialDesign:ColorZone>


                                    </StackPanel>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="5,2.5,0,0"
                                        VerticalAlignment="Stretch">
                                        <materialDesign:ColorZone
                                            Margin="2.5,0,0,0"
                                            VerticalAlignment="Stretch"
                                            materialDesign:ElevationAssist.Elevation="Dp1"
                                            Background="#404040"
                                            CornerRadius="5"
                                            Mode="Standard">

                                            <ScrollViewer
                                                VerticalAlignment="Stretch"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">

                                                <WrapPanel
                                                    x:Name="PortManagePanel"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />

                                            </ScrollViewer>

                                        </materialDesign:ColorZone>
                                    </Grid>


                                </Grid>


                            </TabItem>
                        </TabControl>
                    </materialDesign:Card>



                </Expander>

            </Grid>
        </materialDesign:Card>






    </Grid>
</UserControl>
