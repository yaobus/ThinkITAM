<UserControl
    x:Class="ThinkITAM.FunctionPage.PresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presetPage="clr-namespace:ThinkITAM.UserControls.PresetPage"
    MinWidth="1200"
    MinHeight="700"
    d:Background="DimGray"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PresetPage_OnLoaded"
    mc:Ignorable="d">




    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="5,5,2.5,5">


            <ListView
                x:Name="PresetTreeView"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="PresetTreeView_OnSelectionChanged">

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="SitemapOutline" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="组织机构管理" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="AccountGroup" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="人员信息管理" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="MapOutline" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="地点位置预设" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="ViewCarouselOutline" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="机房机柜管理" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>


                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="OfficeBuilding" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="建筑信息管理" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="Devices" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="资产分组预设" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="GoogleChrome" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="快捷访问预设" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

                <ListViewItem Margin="0">
                    <Grid>
                        <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">

                            <materialDesign:ColorZone
                                Width="295"
                                Height="50"
                                Padding="8"
                                Mode="PrimaryDark">

                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <materialDesign:PackIcon
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Kind="SettingsBox" />

                                    <TextBlock
                                        Margin="10"
                                        VerticalAlignment="Center"
                                        Text="系统参数设置" />


                                </StackPanel>
                            </materialDesign:ColorZone>
                        </materialDesign:TransitioningContent>
                    </Grid>
                </ListViewItem>

            </ListView>




        </materialDesign:Card>


        <StackPanel
            x:Name="PresetSubPanel"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="0"
            SizeChanged="PresetSubPanel_OnSizeChanged" />





    </Grid>
</UserControl>
