<UserControl
    x:Class="ThinkITAM.FunctionPage.IndexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:indexPage="clr-namespace:ThinkITAM.UserControls.IndexPage"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="1200"
    MinHeight="700"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ClearSearchKeyWord"
                    Click="ClearSearchKeyWord_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                    materialDesign:HintAssist.HintOpacity="0.3"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    PreviewKeyDown="SearchKeyWord_OnPreviewKeyDown" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Click="SearchButton_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5">

            <ListView
                x:Name="GroupsListView"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="GroupsListView_OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>

                        <indexPage:GroupInfo />

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="2.5,2.5,2.5,5">

            <ScrollViewer
                Grid.Row="1"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="IndexPanel" Padding="10">
                    <!--  设置 ItemsPanel 为 WrapPanel  -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <indexPage:IndexTag Margin="10" DataContext="{Binding}" />

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </ScrollViewer>
        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="AddButton"
                    Grid.Column="0"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="AddButton_OnClick"
                    Cursor="Hand"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="{DynamicResource IpAdd}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="ServerPlusOutline" />

                </Button>

                <Button
                    x:Name="EditButton"
                    Grid.Column="1"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="PencilBoxOutline" />
                </Button>





                <Button
                    x:Name="DeleteButton"
                    Grid.Column="2"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="DeleteButton_OnClick"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Foreground="#Cf3539"
                        Kind="DeleteOutline" />

                </Button>

            </Grid>
        </materialDesign:Card>

        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>
    </Grid>
</UserControl>
