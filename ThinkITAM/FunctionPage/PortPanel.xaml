<UserControl
    x:Class="ThinkITAM.FunctionPage.PortPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:portPanel="clr-namespace:ThinkITAM.UserControls.PortPanel"
    xmlns:portPanelViewModel="clr-namespace:ThinkITAM.ViewModels.PortPanel"
    MinWidth="1200"
    MinHeight="700"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PortPanel_OnLoaded"
    mc:Ignorable="d">
    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ClearSearchKeyWord" Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    Opacity="0.3" />
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5">


            <TreeView
                x:Name="BuildingTreeView"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItemChanged="BuildingTreeView_OnSelectedItemChanged" />




        </materialDesign:Card>

        <Expander
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
            ExpandDirection="Right"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock RenderTransformOrigin=".5,.5" Text="房间列表">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <Grid>

                <materialDesign:Card Margin="2.5,2.5,2.5,5">

                    <ListView
                        x:Name="RoomListView"
                        AllowDrop="True"
                        IsManipulationEnabled="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="RoomListView_OnSelectionChanged">
                        <ListView.DataContext>
                            <portPanelViewModel:RoomClass />
                        </ListView.DataContext>

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

                                    <Grid Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Background="DarkCyan">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="ExtraBlack"
                                                Foreground="AliceBlue"
                                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                Text="{Binding Index}" />
                                        </Grid>

                                        <Grid Grid.Column="1" Background="#00A0A0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="20*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">

                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="AliceBlue"
                                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                    Text="房间号:" />
                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="AliceBlue"
                                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                    Text="{Binding RoomNumber}" />

                                            </StackPanel>

                                            <Grid Grid.Row="1" Background="MediumSeaGreen">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="端口总数:" />
                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding PortCount}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="AliceBlue"
                                                    Opacity="0.5 "
                                                    Text="{Binding RoomNote}" />


                                            </Grid>
                                        </Grid>

                                    </Grid>


                                </materialDesign:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </materialDesign:Card>

            </Grid>

        </Expander>



        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!--<Button
                x:Name="AddButton"
                Grid.Column="0"
                Margin="10"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="AddButton_OnClick"
                IsEnabled="True"
                Style="{StaticResource MaterialDesignFlatLightButton}">
                <materialDesign:PackIcon
                Width="20"
                Height="20"
                Kind="PlusBoxOutline" />
                </Button>-->

                <materialDesign:PopupBox
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    Padding="0"
                    BorderThickness="0">

                    <materialDesign:PopupBox.ToggleContent>

                        <materialDesign:ColorZone
                            Width="80"
                            Height="32"
                            Background="Transparent"
                            ClipToBounds="False"
                            CornerRadius="5">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="PlusBoxOutline" />


                        </materialDesign:ColorZone>




                    </materialDesign:PopupBox.ToggleContent>

                    <StackPanel>
                        <Button
                            x:Name="AddBuildingButton"
                            Width="80"
                            Margin="0,10,0,5"
                            Padding="0"
                            Click="AddBuildingButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="{DynamicResource PpAddBuilding}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="House" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource PpBuilding}" />
                            </StackPanel>

                        </Button>
                        <Button
                            x:Name="AddButton"
                            Width="80"
                            Margin="0,5"
                            Padding="0"
                            Click="AddButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="{DynamicResource PpAddRoomPort}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ViewCarousel" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource PpRoomPort}" />
                            </StackPanel>

                        </Button>

                    </StackPanel>
                </materialDesign:PopupBox>



                <Button
                    x:Name="EditButton"
                    Grid.Column="1"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="PencilBoxOutline" />
                </Button>





                <Button
                    x:Name="DeleteButton"
                    Grid.Column="2"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Foreground="#CF3539"
                        Kind="DeleteOutline" />

                </Button>

            </Grid>
        </materialDesign:Card>




        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="2"
            Height="50"
            Margin="2.5,5,5,2.5"
            Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">


                    <ToggleButton
                        x:Name="ShowModeButton"
                        Width="32"
                        Height="32"
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatListText}"
                        Content="{materialDesign:PackIcon Kind=Apps}"
                        Style="{StaticResource MaterialDesignActionToggleButton}"
                        ToolTip="切换图形/列表显示模式" />

                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Value="100" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="OperationPanel"
                            Grid.Column="0"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <RadioButton
                                x:Name="TempManage"
                                Margin="0"
                                BorderThickness="0"
                                IsChecked="True"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="临时链路管理">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="EthernetCable" />

                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="PermanentManage"
                                Margin="5,0"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="永久链路关联管理">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="LinkVariant" />

                                </StackPanel>
                            </RadioButton>


                            <RadioButton
                                x:Name="LinkManage"
                                Margin="5,0"
                                IsChecked="False"
                                Style="{StaticResource MaterialDesignChoiceChipSecondaryRadioButton}"
                                ToolTip="链路查看模式"
                                Visibility="Visible">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="VectorPolyline" />

                                </StackPanel>
                            </RadioButton>
                            <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />
                        </StackPanel>



                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <Button
                                x:Name="ReSort"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="重置为默认排序">
                                <materialDesign:PackIcon Kind="Restore" />
                            </Button>

                            <Button
                                x:Name="SetButton"
                                Margin="5,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="自定义端口信息标签">
                                <materialDesign:PackIcon Kind="Settings" />
                            </Button>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">



                            <StackPanel
                                x:Name="MultipleAllocationPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">



                                <TextBlock
                                    x:Name="NumberBlock"
                                    Margin="15,0,5,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    d:Text="5"
                                    FontSize="22"
                                    FontWeight="Black"
                                    Foreground="AliceBlue"
                                    ToolTip="当前选中的IP数量" />


                                <Button
                                    x:Name="MultipleAllocationButton"
                                    Margin="0"
                                    Foreground="Red"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="一键分配所选地址">
                                    <materialDesign:PackIcon Kind="Delete" />
                                </Button>

                                <Button
                                    x:Name="ClearRackPanel"
                                    Margin="0"
                                    Foreground="OrangeRed"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="清空画布">
                                    <materialDesign:PackIcon Kind="Autorenew" />
                                </Button>

                            </StackPanel>


                        </StackPanel>
                    </Grid>



                </StackPanel>



            </Grid>

        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="2"
            Margin="2.5,2.5,5,2.5">

            <Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">


                    <ItemsControl x:Name="PortManagePanel" Padding="10">
                        <!--  设置 ItemsPanel 为 WrapPanel  -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <portPanel:PanelPort Margin="10" />

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>




                </ScrollViewer>




            </Grid>
        </materialDesign:Card>



    </Grid>
</UserControl>
