<UserControl
    x:Class="ThinkITAM.FunctionPage.PortPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.Functions.FunctionClass"
    xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:portPanel="clr-namespace:ThinkITAM.UserControls.PortPanel"
    xmlns:portPanelViewModel="clr-namespace:ThinkITAM.ViewModels.PortPanel"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PortPanel_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <functionClass:CustomColorIndexToColor x:Key="CustomColorIndexToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ClearSearchKeyWord"
                    Click="ClearSearchKeyWord_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    KeyDown="SearchKeyWord_OnKeyDown"
                    Opacity="0.3" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Click="SearchButton_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5">


            <TreeView
                x:Name="BuildingTreeView"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItemChanged="BuildingTreeView_OnSelectedItemChanged" />




        </materialDesign:Card>

        <Expander
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            materialDesign:ExpanderAssist.VerticalHeaderPadding="0,0,0,0"
            ExpandDirection="Right"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock RenderTransformOrigin=".5,.5" Text="房间列表">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <Grid>

                <materialDesign:Card Margin="2.5,2.5,2.5,5">

                    <ListView
                        x:Name="RoomListView"
                        AllowDrop="True"
                        IsManipulationEnabled="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="RoomListView_OnSelectionChanged">
                        <ListView.DataContext>
                            <portPanelViewModel:RoomClass />
                        </ListView.DataContext>

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

                                    <Grid Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Background="DarkCyan">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="ExtraBlack"
                                                Foreground="AliceBlue"
                                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                Text="{Binding Index}" />
                                        </Grid>

                                        <Grid Grid.Column="1" Background="#00A0A0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="20*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">

                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="AliceBlue"
                                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                    Text="房间号:" />
                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="AliceBlue"
                                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                    Text="{Binding RoomNumber}" />

                                            </StackPanel>

                                            <Grid Grid.Row="1" Background="MediumSeaGreen">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="端口总数:" />
                                                    <TextBlock
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="AliceBlue"
                                                        Opacity="0.5"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding PortCount}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="AliceBlue"
                                                    Opacity="0.5 "
                                                    Text="{Binding RoomNote}" />


                                            </Grid>
                                        </Grid>

                                    </Grid>


                                </materialDesign:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </materialDesign:Card>

            </Grid>

        </Expander>



        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>




                <Button
                    x:Name="AddBuildingButton"
                    Grid.Column="0"
                    Margin="0,10,0,5"
                    Padding="0"
                    Click="AddBuildingButton_OnClick"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="{DynamicResource PpAddBuilding}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            Kind="House" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource PpAddBuilding}"
                            Visibility="Collapsed" />
                    </StackPanel>

                </Button>

                <Button
                    x:Name="AddButton"
                    Grid.Column="1"
                    Margin="0,10,0,5"
                    Padding="0"
                    Click="AddButton_OnClick"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="{DynamicResource PpAddRoomPort}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Grid Margin="0,0,0,0">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Kind="ApplicationOutline" />
                            <materialDesign:PackIcon
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Ethernet" />

                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource PpAddRoomPort}"
                            Visibility="Collapsed" />
                    </StackPanel>

                </Button>

                <Button
                    x:Name="DeleteBuildingButton"
                    Grid.Column="2"
                    Margin="0,10,0,5"
                    Padding="0"
                    Click="DeleteBuildingButton_OnClick"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="{DynamicResource PpDeleteBuilding}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid Margin="0,0,0,0">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                Kind="DeleteOutline" />

                        </Grid>

                    </StackPanel>

                </Button>

            </Grid>
        </materialDesign:Card>

        <!--<Button
        x:Name="EditButton"
        Grid.Column="1"
        Margin="10"
        materialDesign:ButtonAssist.CornerRadius="5"
        BorderBrush="Transparent"
        BorderThickness="0"
        IsEnabled="False"
        Style="{StaticResource MaterialDesignFlatLightButton}">
        <materialDesign:PackIcon
        Width="20"
        Height="20"
        Kind="PencilBoxOutline" />
        </Button>





        <Button
        x:Name="DeleteButton"
        Grid.Column="2"
        Margin="10"
        materialDesign:ButtonAssist.CornerRadius="5"
        BorderBrush="Transparent"
        BorderThickness="0"
        IsEnabled="False"
        Style="{StaticResource MaterialDesignFlatLightButton}">
        <materialDesign:PackIcon
        Width="20"
        Height="20"
        Foreground="#CF3539"
        Kind="DeleteOutline" />

        </Button>-->







        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="2"
            Height="50"
            Margin="2.5,5,5,2.5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">


                    <ToggleButton
                        x:Name="ShowModeButton"
                        Width="32"
                        Height="32"
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=FormatListText}"
                        Click="ShowModeButton_OnClick"
                        Content="{materialDesign:PackIcon Kind=Apps}"
                        Style="{StaticResource MaterialDesignActionToggleButton}"
                        ToolTip="切换图形/列表显示模式" />

                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Value="100" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding IsChecked, ElementName=ShowModeButton, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Button
                                x:Name="SetButton"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="5,0"
                                materialDesign:ElevationAssist.Elevation="Dp1"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="SetButton_OnClick"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="{DynamicResource DpmSetButton}">
                                <materialDesign:PackIcon Kind="TagEditOutline" />
                            </Button>

                            <ProgressBar
                                Width="40"
                                Height="1"
                                Opacity="0.3"
                                Orientation="Vertical"
                                Value="100" />

                            <StackPanel
                                x:Name="MultipleAllocationPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">



                                <TextBlock
                                    x:Name="NumberBlock"
                                    Width="32"
                                    Margin="15,0,5,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    d:Text="99"
                                    FontSize="22"
                                    FontWeight="Black"
                                    ToolTip="当前选中的端口数量" />

                                <Button
                                    x:Name="MultipleButton"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="MultipleButton_OnClick"
                                    Foreground="LawnGreen"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}">
                                    <materialDesign:PackIcon Kind="Play" />
                                </Button>

                                <Button
                                    x:Name="MultipleDeleteButton"
                                    Width="32"
                                    Height="32"
                                    Margin="5,0"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="DeleteButton_OnClick"
                                    Foreground="Red"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="删除所选端口">
                                    <materialDesign:PackIcon Kind="Delete" />
                                </Button>


                            </StackPanel>


                        </StackPanel>
                    </Grid>



                </StackPanel>



            </Grid>

        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="2.5,2.5,5,2.5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    x:Name="PortScrollViewer"
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Visible">


                    <ItemsControl x:Name="PortManagePanel" Padding="10">
                        <!--  设置 ItemsPanel 为 WrapPanel  -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <portPanel:PanelPort Margin="10" />

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>




                </ScrollViewer>


                <DataGrid
                    x:Name="PanelPortListView"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    d:Visibility="Visible"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    HorizontalScrollBarVisibility="Auto"
                    MouseDoubleClick="PanelPortListView_OnMouseDoubleClick"
                    SelectionChanged="PanelPortListView_OnSelectionChanged"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="OrderBoolAscendingVariant" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{DynamicResource NmpDgSelect}" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ToggleButton
                                            x:Name="SelectToggleButton"
                                            Grid.Column="0"
                                            Padding="0"
                                            BorderThickness="0"
                                            Checked="SelectToggleButton_OnChecked"
                                            IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Unchecked="SelectToggleButton_OnUnchecked">
                                            <materialDesign:PackIcon Kind="CheckboxBlankOutline" />

                                            <ToggleButton.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignActionLightToggleButton}" TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="LightSeaGreen" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>

                                        </ToggleButton>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Index">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Numeric1Box" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="索引" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding Index}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortIndex">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Identifier" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口ID" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding PortIndex}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortType">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="SerialPort" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口类型" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding PortType}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortGroup">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Group" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口群组" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding PortGroup}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortColor">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Palette" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口颜色" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid d:Background="Green" Background="{Binding PortColor, Converter={StaticResource CustomColorIndexToColor}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortTag">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="TagOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口标签" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding PortTag}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PortStatus">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="InformationVariant" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="端口状态" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding PortStatus}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="OnTheLine">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="LinkVariant" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="所在链路" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding OnTheLine}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="TagA">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="TagHeartOutline" />
                                    <Label
                                        x:Name="LabelA"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Content="TagA"
                                        FontSize="14" />

                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding TagA}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="TagB">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="TagHeartOutline" />
                                    <Label
                                        x:Name="LabelB"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Content="TagB"
                                        FontSize="14" />

                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="ExtraBold"
                                            Text="{Binding TagB}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="TagC">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
