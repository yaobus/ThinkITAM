<UserControl
    x:Class="ThinkITAM.FunctionPage.AssetManage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThinkITAM.UserControls.Asset"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:local3="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="768"
    d:Width="1366"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AssetManage_OnLoaded"
    mc:Ignorable="d">



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>




        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Height="50"
            Margin="5,5,2.5,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ClearSearchKeyWord"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Click="ClearSearchKeyWord_OnClick"
                    >
                    <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                </Button>
                <TextBox
                    x:Name="SearchKeyWord"
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    Opacity="0.3"
                    KeyDown="SearchKeyWord_OnKeyDown"
                    />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Click="SearchButton_OnClick"
                    >
                    <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                </Button>
            </Grid>
        </materialDesign:Card>






        <materialDesign:Card
            Grid.Row="1"
            Grid.RowSpan="1"
            Grid.Column="0"
            Margin="5,2.5,2.5,2.5">


            <TreeView
                x:Name="AssetTreeView"
                Grid.Row="0"
                IsManipulationEnabled="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItemChanged="AssetTreeView_OnSelectedItemChanged" />




        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,2.5,2.5,5"
            Visibility="Visible">
            <Grid
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <Button
                    x:Name="AddButton"
                    Grid.Column="0"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="AddButton_OnClick"
                    Cursor="Hand"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="新增分组">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="ViewGridPlus" />

                </Button>

                <Button
                    x:Name="EditButton"
                    Grid.Column="1"
                    Margin="10"
                    Visibility="Collapsed"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Kind="PencilBoxOutline" />
                </Button>





                <Button
                    x:Name="DeleteButton"
                    Visibility="Collapsed"
                    Margin="10"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Foreground="#Cf3539"
                        Kind="DeleteOutline" />

                </Button>

            </Grid>
        </materialDesign:Card>



        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="1"
            Height="50"

            Margin="2.5,5,5,2.5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>



                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="资产类型"
                    Orientation="Horizontal">

                    <Button
                        x:Name="ScanButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#52c7b8"
                        BorderBrush="Transparent"
                        Content="{materialDesign:PackIcon QrcodeScan}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="扫描资产二维码"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="AddAssetButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#aeea00"
                        BorderBrush="Transparent"
                        Click="AddAssetButton_OnClick"
                        Content="{materialDesign:PackIcon ViewGridPlus}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="添加资产" />


                    <Button
                        x:Name="EditAssetButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#52c7b8"
                        BorderBrush="Transparent"
                        Click="EditAssetButton_OnClick"
                        Content="{materialDesign:PackIcon PencilBoxOutline}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="编辑资产信息" />

                    <Button
                        x:Name="DeleteAssetButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#Cf3539"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Content="{materialDesign:PackIcon DeleteOutline}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        Click="DeleteAssetButton_OnClick"
                        />

                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">

                        <ProgressBar
                            Width="40"
                            Height="1"
                            Opacity="0.3"
                            Orientation="Vertical"
                            Value="100" />

                        <ComboBox
                            x:Name="AddressBox"
                            Width="120"
                            Height="32"
                            Margin="5"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="ShapeOutline"
                            ItemsSource="{Binding ShortStringList}"
                            MaxDropDownHeight="300"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.SelectedItem>
                                <Binding
                                    Mode="TwoWay"
                                    Path="SelectedValidationOutlined"
                                    UpdateSourceTrigger="PropertyChanged" />
                            </ComboBox.SelectedItem>
                        </ComboBox>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            materialDesign:HintAssist.Hint="设备类型"
                            Orientation="Horizontal">

                            <ComboBox
                                x:Name="DomainComboBox"
                                Width="120"
                                Height="32"
                                Margin="5"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="FilterOutline"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBox.SelectedItem>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="SelectedValidationOutlined"
                                        UpdateSourceTrigger="PropertyChanged" />
                                </ComboBox.SelectedItem>


                            </ComboBox>
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            materialDesign:HintAssist.Hint="搜索关键词"
                            Orientation="Horizontal">

                            <TextBox
                                x:Name="KeyWord"
                                Width="120"
                                Height="32"
                                Margin="5"
                                Padding="0"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.FloatingScale="0"
                                materialDesign:HintAssist.Hint="搜索关键词"
                                AcceptsReturn="False"
                                Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                TextWrapping="NoWrap" />

                        </StackPanel>


                        <ToggleButton
                            x:Name="Accurate"
                            Width="26"
                            Height="26"
                            Margin="5"
                            materialDesign:ElevationAssist.Elevation="Dp5"
                            materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=Equal}"
                            Content="{materialDesign:PackIcon Kind=ApproximatelyEqual}"
                            IsChecked="False"
                            Style="{StaticResource MaterialDesignActionToggleButton}"
                            ToolTip="模糊/精确" />



                        <Button
                            x:Name="SearchButton2"
                            Width="50"
                            Height="30"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="给我搜">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Search" />
                        </Button>

                        <Button
                            x:Name="SearchClear"
                            Width="50"
                            Height="30"
                            Margin="5"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="清空搜索"
                            Visibility="Visible">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="ClearCircleOutline" />
                        </Button>



                        <Button
                            x:Name="ExportButton"
                            Width="50"
                            Height="30"
                            Margin="5"
                            Padding="0"
                            HorizontalAlignment="Right"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="页面数据导出(不可作为数据源反向导入)">


                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="TableArrowRight" />
                        </Button>


                        <Button
                            x:Name="ExportNetwork"
                            Width="50"
                            Height="30"
                            Margin="5"
                            Padding="0"
                            HorizontalAlignment="Right"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="导出网段信息报表">


                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Kind="ApplicationExport" />
                        </Button>




                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <Button
                        x:Name="AssetNumber"
                        Margin="5,0"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="当前选中的资产数量">
                        <TextBlock
                            x:Name="NumberBlock"
                            d:Text="5"
                            FontSize="20"
                            FontWeight="ExtraBlack"
                            Foreground="LawnGreen" />
                    </Button>
                    <Button
                        x:Name="QrCodeExport"
                        Width="50"
                        Height="30"
                        Margin="5"
                        Padding="0"
                        HorizontalAlignment="Right"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        BorderThickness="0"
                        Click="QrCodeExport_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="资产标签导出">

                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="TagArrowRight" />



                    </Button>
                </StackPanel>






            </Grid>

        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="2.5,2.5,5,5">

            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" MaxHeight="400" />
                </Grid.RowDefinitions>


                <DataGrid
                    x:Name="AssetDataGrid"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0"
                    GridLinesVisibility="None"
                    IsReadOnly="True"
                    MouseDoubleClick="AssetDataGrid_OnMouseDoubleClick"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectionChanged="AssetDataGrid_OnSelectionChanged"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                    <CheckBox
                                        x:Name="HeaderCheckBox"
                                        Width="24"
                                        Height="24"
                                        Click="HeaderCheckBox_OnClick"
                                        IsThreeState="True" />

                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="选择"
                                        ToolTip="选择端口" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Top">
                                        <ToggleButton
                                            x:Name="SelectToggleButton"
                                            Padding="0"
                                            BorderThickness="0"
                                            Checked="SelectToggleButton_OnChecked"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Unchecked="SelectToggleButton_OnUnchecked">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="CheckboxBlankOutline" />

                                            <ToggleButton.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignActionLightToggleButton}" TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="LightSeaGreen" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>

                                        </ToggleButton>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Numeric1Box" />
                                    <TextBlock Text="序号" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Index" />


                            </DataGridTextColumn.Binding>

                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Laptop" />
                                    <TextBlock Text="资产类型" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="AssetType" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Monitor" />
                                    <TextBlock Text="设备类型" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="DeviceType" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="TagText" />
                                    <TextBlock Text="资产编号" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="AssetNumber" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="CalendarText" />
                                    <TextBlock Text="购置日期" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="PurchaseDate" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="CurrencyUsd" />
                                    <TextBlock Text="购置价格" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="PurchasePrice" StringFormat="C" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>



                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Factory" />
                                    <TextBlock Text="制造厂商" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Manufacturer" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Devices" />
                                    <TextBlock Text="型号" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Model" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="BarcodeScanner" />
                                    <TextBlock Text="序列号" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="SerialNumber" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Settings" />
                                    <TextBlock Text="配置信息" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Configuration" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="MapMarker" />
                                    <TextBlock Text="存放位置" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Location" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="SitemapOutline" />
                                    <TextBlock Text="责任人单位" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="UserOrganization" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="BallotOutline" />
                                    <TextBlock Text="责任人部门" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="UserDepartment" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>



                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Account" />
                                    <TextBlock Text="责任人" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="User" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Phone" />
                                    <TextBlock Text="责任人电话" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="UserPhone" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="AccountCircle" />
                                    <TextBlock Text="使用人" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Consumer" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="CheckCircle" />
                                    <TextBlock Text="资产状态" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="AssetStatus" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Calendar" />
                                    <TextBlock Text="已用年限" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="UsedYear" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Delete" />
                                    <TextBlock Text="报废日期" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="ScrapDate" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Note" />
                                    <TextBlock Text="备注信息" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Notes" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Tag" />
                                    <TextBlock x:Name="TagA" Text="自定义标签A" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="TagA" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>


                        <DataGridTextColumn>
                            <DataGridTextColumn.Header>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,5,0" Kind="Tag" />
                                    <TextBlock x:Name="TagB" Text="自定义标签B" />
                                </StackPanel>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
