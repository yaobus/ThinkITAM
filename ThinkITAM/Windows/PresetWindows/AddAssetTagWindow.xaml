<Window
    x:Class="ThinkITAM.Windows.PresetWindows.AddAssetTagWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PresetWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产类型及编号预设"
    Width="400"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddAssetTagWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加资产类型及编号预设" />

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical">



            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="资产类型:" />
                <ComboBox
                    x:Name="AssetType"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    SelectedItem="{Binding AssetType }"
                    SelectionChanged="AssetType_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="设备类型:" />
                <ComboBox
                    x:Name="DeviceType"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    SelectedItem="{Binding DeviceType}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="编号前缀:" />
                <TextBox
                    x:Name="AssetTag"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    Text="{Binding NumberPrefix}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="SortNumerically"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="备注信息:" />
                <TextBox
                    x:Name="Note"
                    Width="300"
                    Height="28"
                    Padding="3"
                    Text="{Binding Note}"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



        </StackPanel>
        <Button
            x:Name="SaveButton"
            Grid.Row="2"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            Click="SaveButton_OnClick"
            Content="保存" />
    </Grid>
</Window>
