<Window
    x:Class="ThinkITAM.Windows.PresetWindows.AddBuildingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PresetWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加建筑信息"
    Width="400"
    Height="450"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddBuildingWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="OfficeBuilding" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加建筑信息" />

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical">

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="建筑名称:" />
                <TextBox
                    x:Name="BuildingName"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    Text="{Binding Building}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="OfficeBuilding"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="所在地址:" />
                <ComboBox
                    x:Name="AddressCombobox"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                    DisplayMemberPath="Location"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="联系人员:" />
                <ComboBox
                    x:Name="PeopleCombobox"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="People"
                    DisplayMemberPath="Name"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    SelectionChanged="PeopleCombobox_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="联系电话:" />
                <TextBox
                    x:Name="Phone"
                    Width="300"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    Text="{Binding Phone}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Phone"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="备注信息:" />
                <TextBox
                    x:Name="Note"
                    Width="300"
                    Height="28"
                    Padding="3"
                    Text="{Binding Note}"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



        </StackPanel>

        <Button
            x:Name="SaveButton"
            Grid.Row="2"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            Click="SaveButton_OnClick"
            Content="保存" />
    </Grid>

</Window>
