<Window
    x:Class="ThinkITAM.Windows.PresetWindows.AddPeopleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PresetWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加用户信息"
    Width="600"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddPeopleWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="BadgeAccountHorizontalOutline" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加用户信息" />

        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                Orientation="Vertical">

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="用户编号:" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            x:Name="UserNumberPrefix"
                            Width="120"
                            Height="28"
                            Padding="3"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="False"
                            materialDesign:TextFieldAssist.LeadingIcon="Numeric9BoxMultipleOutline"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <TextBox
                            x:Name="UserNumber"
                            Width="92"
                            Height="28"
                            Margin="5,0"
                            Padding="3"
                            VerticalAlignment="Center"
                            Text="{Binding UserNumber}"
                            materialDesign:TextFieldAssist.HasLeadingIcon="False"
                            materialDesign:TextFieldAssist.LeadingIcon="Numeric9BoxMultipleOutline"
                            MouseDoubleClick="UserNumber_OnMouseDoubleClick"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            ToolTip="双击自动获取最小可用编号" />


                        <Button
                            x:Name="EditPrefixButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Click="EditPrefixButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}"
                            ToolTip="设置编号前缀">

                            <materialDesign:PackIcon Kind="RenameOutline" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="用户姓名:" />
                    <TextBox
                        x:Name="User"
                        Width="250"
                        Height="28"
                        Padding="3"
                        Text="{Binding Name}"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="联系电话:" />
                    <TextBox
                        x:Name="Phone"
                        Width="250"
                        Height="28"
                        Padding="3"
                        Text="{Binding Phone}"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Phone"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="备注信息:" />
                    <TextBox
                        x:Name="Note"
                        Width="250"
                        Height="28"
                        Padding="3"
                        Text="{Binding Note}"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>






            </StackPanel>


            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="一级组织:" />
                    <ComboBox
                        x:Name="Organization"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="SourceCommitStartNextLocal"
                        IsEditable="True"
                        MaxDropDownHeight="300"
                        SelectedItem="{Binding Organization, Mode=TwoWay}"
                        SelectionChanged="Organization_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="二级组织:" />
                    <ComboBox
                        x:Name="Department"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="SourceMerge"
                        IsEditable="True"
                        MaxDropDownHeight="300"
                        SelectedItem="{Binding Department, Mode=TwoWay}"
                        SelectionChanged="Department_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="三级组织:" />
                    <ComboBox
                        x:Name="Groups"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="GraphOutline"
                        IsEditable="True"
                        MaxDropDownHeight="300"
                        SelectedItem="{Binding Group, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>



            </StackPanel>
        </Grid>

        <Button
            x:Name="SaveButton"
            Grid.Row="2"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            Click="SaveButton_OnClick"
            Content="保存" />

        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>


        <materialDesign:DialogHost
            x:Name="SavePrefixDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            CloseOnClickAway="True"
            DialogClosed="SavePrefixDialogHost_OnDialogClosed"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">
                    <TextBlock
                        MaxWidth="400"
                        FontSize="14"
                        Text="输入编号前缀" />
                    <TextBox
                        x:Name="NameTextBox"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        FontSize="14" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SavePrefixButton"
                            Margin="0,8,8,0"
                            Click="SavePrefixButton_OnClick"
                            Content="保存"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Margin="0,8,8,0"
                            Click="CancelButton_OnClick"
                            Content="关闭"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>


    </Grid>
</Window>
