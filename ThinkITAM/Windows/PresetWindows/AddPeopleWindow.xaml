<Window
    x:Class="ThinkITAM.Windows.PresetWindows.AddPeopleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PresetWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加用户信息"
    Width="500"
    Height="500"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddPeopleWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="BadgeAccountHorizontalOutline" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加用户信息" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,10"
            Orientation="Vertical">

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="用户编号:" />
                <TextBox
                    x:Name="UserNumberPrefix"
                    Width="120"
                    Height="28"
                    Margin="10,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="False"
                    materialDesign:TextFieldAssist.LeadingIcon="Numeric9BoxMultipleOutline"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox
                    x:Name="UserNumber"
                    Width="100"
                    Height="28"
                    Margin="10,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="False"
                    materialDesign:TextFieldAssist.LeadingIcon="Numeric9BoxMultipleOutline"
                    MouseDoubleClick="UserNumber_OnMouseDoubleClick"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    ToolTip="双击自动获取最小可用编号" />


                <Button
                    x:Name="EditPrefixButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Click="EditPrefixButton_OnClick"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    ToolTip="设置编号前缀">

                    <materialDesign:PackIcon Kind="RenameOutline" />
                </Button>

            </StackPanel>

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="用户姓名:" />
                <TextBox
                    x:Name="User"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="一级组织:" />
                <ComboBox
                    x:Name="Organization"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="SourceCommitStartNextLocal"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    SelectionChanged="Organization_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="二级组织:" />
                <ComboBox
                    x:Name="Department"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="SourceMerge"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    SelectionChanged="Department_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="三级组织:" />
                <ComboBox
                    x:Name="Groups"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="GraphOutline"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="联系电话:" />
                <TextBox
                    x:Name="Phone"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Phone"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="备注信息:" />
                <TextBox
                    x:Name="Note"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="0,20,65,0"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="保存" />
        </StackPanel>

        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="2"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>


        <materialDesign:DialogHost
            x:Name="SavePrefixDialogHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            d:Visibility="Collapsed"
            CloseOnClickAway="True"
            DialogClosed="SavePrefixDialogHost_OnDialogClosed"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">
                    <TextBlock
                        MaxWidth="400"
                        FontSize="14"
                        Text="输入编号前缀" />
                    <TextBox
                        x:Name="NameTextBox"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        FontSize="14" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SavePrefixButton"
                            Margin="0,8,8,0"
                            Click="SavePrefixButton_OnClick"
                            Content="保存"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Margin="0,8,8,0"
                            Click="CancelButton_OnClick"
                            Content="关闭"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>


    </Grid>
</Window>
