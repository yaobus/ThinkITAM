<Window
    x:Class="ThinkITAM.Windows.PresetWindows.AddPortWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PresetWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加访问端口"
    Width="440"
    Height="320"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddPortWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*" />
            <ColumnDefinition Width="191*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="GoogleChrome" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加访问端口" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,20,0,20"
            Orientation="Vertical">

            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="访问端口:" />
                <TextBox
                    x:Name="Port"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="GoogleChrome"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="端口备注:" />
                <TextBox
                    x:Name="Note"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Note"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            </StackPanel>

            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="0,20,60,0"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="保存" />
        </StackPanel>
    </Grid>

</Window>
