<Window
    x:Class="ThinkITAM.Windows.Selection.SelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionPage="clr-namespace:ThinkITAM.FunctionPage"
    xmlns:local="clr-namespace:ThinkITAM.Windows.Selection"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="IT Asset Manage"
    Width="1920"
    Height="1080"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="SelectionWindow_OnLoaded"
    ResizeMode="CanResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>



        <Style x:Key="NetworkAddressManagePageStyle" TargetType="functionPage:NetworkAddressManagePage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>


        <Style x:Key="DevicePortManageStyle" TargetType="functionPage:DevicePortManage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>



        <Style x:Key="IndexPageStyle" TargetType="functionPage:IndexPage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />

        </Style>

        <Style x:Key="PresetPageStyle" TargetType="functionPage:PresetPage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>

        <Style x:Key="AssetPageStyle" TargetType="functionPage:AssetManage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>

        <Style x:Key="DashboardStyle" TargetType="functionPage:Dashboard">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>

        <Style x:Key="LinkUserControlPageStyle" TargetType="functionPage:LinkUserControl">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>



        <Style x:Key="PortPanelStyle" TargetType="functionPage:PortPanel">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>


        <Style x:Key="ToolsPageStyle" TargetType="functionPage:ToolsPage">
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
        </Style>
        <!--
        <Style x:Key="CabinetManageStyle" TargetType="userPages:CabinetManage">
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        </Style>
        <Style x:Key="ModelPresetStyle" TargetType="userPages:ModelPreset">
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        </Style>
        <Style x:Key="HumanGreetingStyle" TargetType="userPages:HumanGreeting">
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
        </Style>-->


    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#454545" />
        <ListView
            x:Name="MenuList"
            Grid.Column="0"
            Width="45"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="MenuList_OnSelectionChanged">
            <ListViewItem Margin="0,2">


                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        x:Name="MenuIcon"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Kind="MenuClose" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="功能选择列表" />


                </StackPanel>




            </ListViewItem>



            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="ViewDashboardVariant" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="资产信息总览" />


                </StackPanel>

            </ListViewItem>

            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="IpNetworkOutline" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="网段资源管理" />


                </StackPanel>

            </ListViewItem>
            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="Ethernet" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="设备端口管理" />


                </StackPanel>

            </ListViewItem>
            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="StarOutline" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="索引标签管理" />


                </StackPanel>

            </ListViewItem>



            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="RelationOnlyOneToOnlyOne" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="链路信息管理" />


                </StackPanel>

            </ListViewItem>


            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="Warehouse" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="资产信息管理" />


                </StackPanel>

            </ListViewItem>

            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Kind="PaletteSwatch" />

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="预设信息管理" />

                </StackPanel>

            </ListViewItem>


            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <Grid>
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Kind="ApplicationOutline" />
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="Ethernet" />

                    </Grid>

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="面板端口管理" />

                </StackPanel>

            </ListViewItem>

            <ListViewItem Margin="0,2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                    <Grid>
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Kind="ToolboxOutline" />
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="Ethernet" />

                    </Grid>

                    <TextBlock
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="运维工具箱" />

                </StackPanel>

            </ListViewItem>

        </ListView>


        <StackPanel
            x:Name="MenuGrid"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Width="38"
            HorizontalAlignment="Left"
            Visibility="Collapsed">

            <TabControl
                x:Name="TopControl"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Background="Transparent"
                SelectionChanged="TopControl_OnSelectionChanged"
                Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                <TabItem Width="{Binding ElementName=MenuGrid, Path=Width}" ToolTip="资源总览">
                    <TabItem.Header>
                        <StackPanel
                            x:Name="MenuPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Left"
                                Kind="ViewDashboardVariant" />

                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="AliceBlue"
                                Text="资产信息总览" />


                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem
                    Width="{Binding ElementName=MenuGrid, Path=Width}"
                    HorizontalAlignment="Left"
                    ToolTip="网段资源管理">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Left"
                                Kind="IpNetworkOutline" />
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="AliceBlue"
                                Text="网段管理" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <TabItem
                    Width="{Binding ElementName=MenuGrid, Path=Width}"
                    HorizontalAlignment="Left"
                    ToolTip="设备端口管理">
                    <TabItem.Header>
                        <StackPanel
                            Width="auto"
                            Height="auto"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Kind="Ethernet" />
                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="AliceBlue"
                                Text="设备端口管理" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <TabItem
                    Width="{Binding ElementName=MenuGrid, Path=Width}"
                    HorizontalAlignment="Left"
                    IsEnabled="True"
                    IsSelected="False"
                    ToolTip="端口上的快速访问标签合集">
                    <TabItem.Header>
                        <StackPanel
                            Width="auto"
                            Height="auto"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Kind="ChemicalWeapon" />
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="AliceBlue"
                                Text="索引管理" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <TabItem
                    Width="{Binding ElementName=MenuGrid, Path=Width}"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    IsSelected="False"
                    ToolTip="机柜布局管理">
                    <TabItem.Header>
                        <StackPanel
                            Width="auto"
                            Height="auto"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Kind="ViewCarouselOutline" />
                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="AliceBlue"
                                Text="链路管理" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem
                    Width="{Binding ElementName=MenuGrid, Path=Width}"
                    HorizontalAlignment="Left"
                    IsSelected="False"
                    ToolTip="资产管理">
                    <TabItem.Header>
                        <StackPanel
                            Width="auto"
                            Height="auto"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Kind="Warehouse" />
                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="AliceBlue"
                                Text="资产仓储管理" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

            </TabControl>

            <Button
                x:Name="QrcodeScan"
                Height="71"
                Margin="5"
                HorizontalAlignment="Left"
                BorderThickness="0"
                Click="QrcodeScan_OnClick"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="扫描资产二维码"
                Visibility="Collapsed">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="CadetBlue"
                    Kind="QrcodeScan" />
            </Button>




        </StackPanel>


        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <WrapPanel x:Name="FunctionPanel" Margin="0" />



        </Grid>




    </Grid>
</Window>
