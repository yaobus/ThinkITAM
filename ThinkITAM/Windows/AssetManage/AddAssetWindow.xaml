<Window
    x:Class="ThinkITAM.Windows.AssetManage.AddAssetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.AssetManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产"
    Width="1000"
    Height="725"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddAssetWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">0,16</Thickness>
    </Window.Resources>

    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="40"
                    Height="40"
                    Kind="NewspaperPlus" />

                <TextBlock
                    Margin="10"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="添加资产" />

            </StackPanel>

            <Button
                x:Name="SetButton"
                Grid.Column="1"
                Click="SetButton_OnClick"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="自定义标签">
                <materialDesign:PackIcon Kind="Settings" />
            </Button>

        </Grid>

        <Grid Grid.Row="1">
            <WrapPanel HorizontalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="10,0">
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetType}" />
                            <ComboBox
                                x:Name="AssetType"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                MaxDropDownHeight="300"
                                SelectedItem="{Binding AssetType, Mode=TwoWay}"
                                SelectionChanged="AssetType_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />


                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawDeviceType}" />
                            <ComboBox
                                x:Name="DeviceType"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                MaxDropDownHeight="300"
                                SelectedItem="{Binding DeviceType, Mode=TwoWay}"
                                SelectionChanged="DeviceType_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />


                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetNumber}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="AssetTag"
                                    Width="150"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding AssetTag, Mode=TwoWay}" />

                                <TextBox
                                    x:Name="AssetNumber"
                                    Width="85"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding TagNumber, Mode=TwoWay}" />
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Kind="Info"
                                    ToolTip="{DynamicResource AawAssetTooltip}" />
                            </StackPanel>

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetModel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="Model"
                                    Width="150"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Model, Mode=TwoWay}" />
                                <ComboBox
                                    x:Name="ModelsComboBox"
                                    Width="85"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    materialDesign:HintAssist.Hint="{DynamicResource AawAssetModelPreset}"
                                    MaxDropDownHeight="300"
                                    MouseDoubleClick="ModelsComboBox_OnMouseDoubleClick"
                                    SelectionChanged="ModelsComboBox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Kind="Info"
                                    ToolTip="{DynamicResource AawAssetTooltip}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="10,5" Orientation="Vertical">


                            <Label
                                HorizontalAlignment="left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetStorageAddress}" />
                            <ComboBox
                                x:Name="PresetAddress"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="Location"
                                IsEditable="True"
                                MaxDropDownHeight="300"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding Location, Mode=TwoWay}" />

                        </StackPanel>


                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetBuyDate}" />
                            <DatePicker
                                x:Name="BuyDate"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Language="zh-CN"
                                MouseDoubleClick="BuyDate_OnMouseDoubleClick"
                                SelectedDateChanged="BuyDate_OnSelectedDateChanged"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Text="{Binding PurchaseDate, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetBuyPrice}" />
                            <TextBox
                                x:Name="Price"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="CurrencyCny"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding PurchasePrice, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetMaker}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="Maker"
                                    Width="240"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="factory"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Manufacturer, Mode=TwoWay}" />
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Kind="Info"
                                    ToolTip="{DynamicResource AawAssetTooltip}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetSerialNumber}" />
                            <TextBox
                                x:Name="SerialNumber"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Counter"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SerialNumber, Mode=TwoWay}" />
                        </StackPanel>


                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0">
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="*资产状态:" />
                            <ComboBox
                                x:Name="AssetStatus"
                                Width="240"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                SelectedIndex="0"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding AssetStatus, Mode=TwoWay}">
                                <ComboBoxItem Content="使用中" />
                                <ComboBoxItem Content="闲置中" />
                                <ComboBoxItem Content="维修中" />
                                <ComboBoxItem Content="待报废" />
                                <ComboBoxItem Content="已报废" />
                                <ComboBoxItem Content="其他" />
                            </ComboBox>

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetAssignedTo}" />


                            <StackPanel Orientation="Horizontal">

                                <TextBox
                                    x:Name="People"
                                    Width="195"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding User}" />
                                <Button
                                    x:Name="FindUser"
                                    Width="40"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Padding="0"
                                    Click="FindUser_OnClick">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountSearchOutline" />
                                    </StackPanel>

                                </Button>
                            </StackPanel>

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetUserOrganization}" />
                            <TextBox
                                x:Name="Organization"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UserOrganization, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetUserDepartment}" />
                            <TextBox
                                x:Name="Department"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UserDepartment, Mode=TwoWay}" />


                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetUserGroup}" />
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="Group"
                                    Width="240"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="User"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding UserGroup, Mode=TwoWay}" />

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetUserUnit}" />
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="Unit"
                                    Width="240"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="User"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Unit, Mode=TwoWay}" />

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetPhone}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="Phone"
                                    Width="240"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding UserPhone, Mode=TwoWay}" />

                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Kind="Info"
                                    ToolTip="{DynamicResource AawAssetTooltip}" />
                            </StackPanel>

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetUser}" />
                            <TextBox
                                x:Name="Consumer"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="People"
                                MouseDoubleClick="Consumer_OnMouseDoubleClick"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Consumer, Mode=TwoWay}" />


                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetServiceLife}" />
                            <TextBox
                                x:Name="ServiceLife"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TimeOfDay"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UsedYear, Mode=TwoWay}" />


                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0">

                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelX"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetScrapDate}" />
                            <DatePicker
                                x:Name="ScrapDate"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Language="zh-CN"
                                MouseDoubleClick="ScrapDate_OnMouseDoubleClick"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Text="{Binding ScrapDate, Mode=TwoWay}" />


                        </StackPanel>

                        <StackPanel Margin="10,5" Orientation="Vertical">

                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource AawAssetDescription}" />
                            <TextBox
                                x:Name="Description"
                                Width="240"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Notebook"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Notes, Mode=TwoWay}" />


                        </StackPanel>


                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelA"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagA}" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="TagA"
                                    Width="240"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding TagA, Mode=TwoWay}" />


                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Kind="Info"
                                    ToolTip="{DynamicResource AawAssetTooltip}" />


                            </StackPanel>

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelB"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagB}" />
                            <TextBox
                                x:Name="TagB"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagB, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelC"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagC}" />
                            <TextBox
                                x:Name="TagC"
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagC, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelD"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagD}" />
                            <TextBox
                                x:Name="TagD"
                                Grid.Row="3"
                                Grid.Column="1"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagD, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelE"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagE}" />
                            <TextBox
                                x:Name="TagE"
                                Grid.Row="4"
                                Grid.Column="1"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagE, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">
                            <Label
                                x:Name="LabelF"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource NmpDgTagF}" />
                            <TextBox
                                x:Name="TagF"
                                Width="240"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagF, Mode=TwoWay}" />

                        </StackPanel>
                        <StackPanel Margin="10,5" Orientation="Vertical">


                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Content="{DynamicResource AawAssetParameter}" />
                            <TextBox
                                x:Name="Parameter"
                                Width="240"
                                Height="28"
                                MaxHeight="90"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                materialDesign:TextFieldAssist.HasLeadingIcon="False"
                                materialDesign:TextFieldAssist.LeadingIcon="BallotOutline"
                                AcceptsReturn="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Configuration, Mode=TwoWay}"
                                VerticalScrollBarVisibility="Auto" />


                        </StackPanel>
                    </StackPanel>





                </Grid>

            </WrapPanel>

        </Grid>


        <Grid Grid.Row="2" VerticalAlignment="Bottom">

            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="10,10"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="{DynamicResource LucLinkSave}" />
        </Grid>

    </Grid>
</Window>
