<Window
    x:Class="ThinkITAM.Windows.AssetManage.AddAssetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.AssetManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产"
    Width="1150"
    Height="650"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddAssetWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">0,16</Thickness>
    </Window.Resources>

    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="40"
                    Height="40"
                    Kind="NewspaperPlus" />

                <TextBlock
                    Margin="10"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="添加资产" />

            </StackPanel>

            <Button
                x:Name="SetButton"
                Grid.Column="1"
                Click="SetButton_OnClick"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="自定义标签">
                <materialDesign:PackIcon Kind="Settings" />
            </Button>

        </Grid>

        <Grid Grid.Row="1">

            <WrapPanel HorizontalAlignment="Center">
                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="*资产类型:" />
                        <ComboBox
                            x:Name="AssetType"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MaxDropDownHeight="300"
                            SelectionChanged="AssetType_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding AssetType, Mode=TwoWay}" />



                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="*设备类型:" />
                        <ComboBox
                            x:Name="DeviceType"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MaxDropDownHeight="300"
                            SelectionChanged="DeviceType_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding DeviceType, Mode=TwoWay}" />



                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="*资产编号:" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="AssetTag"
                                Width="150"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding AssetTag, Mode=TwoWay}" />

                            <TextBox
                                x:Name="AssetNumber"
                                Width="85"
                                Height="28"
                                Margin="5,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagNumber, Mode=TwoWay}" />
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该字段会在资产信息卡显示" />
                        </StackPanel>

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="*规格型号:" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="Model"
                                Width="150"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Model, Mode=TwoWay}" />
                            <ComboBox
                                x:Name="PresetModel"
                                Width="85"
                                Height="28"
                                Margin="5,0,0,0"
                                Padding="0"
                                materialDesign:HintAssist.Hint="预设型号"
                                MaxDropDownHeight="300"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该字段会在资产信息卡显示" />
                        </StackPanel>



                        <Label
                            Grid.Row="4"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="存放地点:" />
                        <ComboBox
                            x:Name="PresetAddress"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.Hint="地点"
                            DisplayMemberPath="Location"
                            IsEditable="True"
                            MaxDropDownHeight="300"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding Location, Mode=TwoWay}" />



                        <Label
                            Grid.Row="5"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="购置日期:" />
                        <DatePicker
                            x:Name="BuyDate"
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MouseDoubleClick="BuyDate_OnMouseDoubleClick"
                            SelectedDateChanged="BuyDate_OnSelectedDateChanged"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Text="{Binding PurchaseDate, Mode=TwoWay}" />



                        <Label
                            Grid.Row="6"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="购置价格:" />
                        <TextBox
                            x:Name="Price"
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="CurrencyCny"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding PurchasePrice, Mode=TwoWay}" />



                        <Label
                            Grid.Row="7"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="制造商:" />
                        <StackPanel
                            Grid.Row="7"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="Maker"
                                Width="240"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="factory"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Manufacturer, Mode=TwoWay}" />
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该字段会在资产信息卡显示" />
                        </StackPanel>


                        <Label
                            Grid.Row="8"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="序列号:" />
                        <TextBox
                            x:Name="SerialNumber"
                            Grid.Row="8"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Counter"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SerialNumber, Mode=TwoWay}" />



                        <Label
                            Grid.Row="9"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="备注信息:" />
                        <TextBox
                            x:Name="Description"
                            Grid.Row="9"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Notebook"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Notes, Mode=TwoWay}" />




                    </Grid>

                    <Grid Grid.Column="1" HorizontalAlignment="Right">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />

                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="*资产状态:" />
                        <ComboBox
                            x:Name="AssetStatus"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            SelectedIndex="0"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding Status, Mode=TwoWay}">
                            <ComboBoxItem Content="使用中" />
                            <ComboBoxItem Content="闲置中" />
                            <ComboBoxItem Content="维修中" />
                            <ComboBoxItem Content="待报废" />
                            <ComboBoxItem Content="已报废" />
                            <ComboBoxItem Content="其他" />
                        </ComboBox>


                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="责任人组织:" />
                        <ComboBox
                            x:Name="UserOrganization"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MaxDropDownHeight="300"
                            SelectionChanged="UserOrganization_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding UserOrganization, Mode=TwoWay}" />


                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="部门:" />
                        <ComboBox
                            x:Name="UserDepartment"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MaxDropDownHeight="300"
                            SelectionChanged="UserDepartment_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding UserDepartment, Mode=TwoWay}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="群组:" />
                        <ComboBox
                            x:Name="UserGroup"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MaxDropDownHeight="300"
                            SelectionChanged="UserGroup_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="{Binding UserGroup, Mode=TwoWay}" />



                        <Label
                            Grid.Row="4"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="责任人:" />
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ComboBox
                                x:Name="AssignedTo"
                                Width="240"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="User"
                                DisplayMemberPath="Name"
                                MaxDropDownHeight="300"
                                SelectionChanged="AssignedTo_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Text="{Binding User, Mode=TwoWay}" />
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该字段会在资产信息卡显示" />
                        </StackPanel>


                        <Label
                            Grid.Row="5"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="责任人电话:" />
                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="Phone"
                                Width="240"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UserPhone, Mode=TwoWay}" />

                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该字段会在资产信息卡显示" />
                        </StackPanel>

                        <Label
                            Grid.Row="6"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="使用人:" />
                        <TextBox
                            x:Name="Consumer"
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="People"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Consumer, Mode=TwoWay}" />


                        <Label
                            Grid.Row="7"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="已用年限:" />
                        <TextBox
                            x:Name="ServiceLife"
                            Grid.Row="7"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TimeOfDay"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding UsedYear, Mode=TwoWay}" />



                        <Label
                            x:Name="LabelX"
                            Grid.Row="8"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="报废日期:"
                            ToolTip="自定义字段B" />
                        <DatePicker
                            x:Name="ScrapDate"
                            Grid.Row="8"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            MouseDoubleClick="ScrapDate_OnMouseDoubleClick"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Text="{Binding ScrapDate, Mode=TwoWay}" />






                    </Grid>



                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <Label
                            x:Name="LabelA"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签A:"
                            ToolTip="自定义标签A" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="TagA"
                                Width="240"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding TagA, Mode=TwoWay}" />


                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Kind="Info"
                                ToolTip="该自定义字段会在资产信息卡显示" />


                        </StackPanel>

                        <Label
                            x:Name="LabelB"
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签B:"
                            ToolTip="自定义标签B" />
                        <TextBox
                            x:Name="TagB"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding TagB, Mode=TwoWay}" />


                        <Label
                            x:Name="LabelC"
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签C:"
                            ToolTip="自定义标签C" />
                        <TextBox
                            x:Name="TagC"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding TagC, Mode=TwoWay}" />


                        <Label
                            x:Name="LabelD"
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签D:"
                            ToolTip="自定义标签D" />
                        <TextBox
                            x:Name="TagD"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding TagD, Mode=TwoWay}" />


                        <Label
                            x:Name="LabelE"
                            Grid.Row="4"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签E:"
                            ToolTip="自定义标签E" />
                        <TextBox
                            x:Name="TagE"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding TagE, Mode=TwoWay}" />


                        <Label
                            x:Name="LabelF"
                            Grid.Row="5"
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="自定义标签F:"
                            ToolTip="自定义标签F" />
                        <TextBox
                            x:Name="TagF"
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="240"
                            Height="28"
                            Margin="0,0,30,0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="TagHeartOutline"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding TagF, Mode=TwoWay}" />


                        <Label
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="配置信息:" />
                        <TextBox
                            x:Name="Parameter"
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="240"
                            Height="90"
                            Margin="0,10,30,0"
                            Padding="3"
                            VerticalAlignment="Top"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="BallotOutline"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Configuration, Mode=TwoWay}"
                            VerticalScrollBarVisibility="Auto" />




                        <Grid
                            Grid.Row="7"
                            Grid.Column="1"
                            VerticalAlignment="Bottom">

                            <Button
                                x:Name="SaveButton"
                                Width="150"
                                Margin="10,5"
                                HorizontalAlignment="Right"
                                Click="SaveButton_OnClick"
                                Content="保存" />
                        </Grid>

                    </Grid>


                </Grid>

            </WrapPanel>


        </Grid>




    </Grid>
</Window>
