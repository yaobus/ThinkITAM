<Window
    x:Class="ThinkITAM.Windows.AssetManage.AddAssetLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.AssetManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignColors="clr-namespace:MaterialDesignColors;assembly=MaterialDesignColors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产履历"
    Width="400"
    Height="450"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    ResizeMode="NoResize"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Thickness x:Key="DefaultMargin">0,12</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="5,0"
                VerticalAlignment="Center"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加资产履历" />

        </StackPanel>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{DynamicResource AalEventDate}" />
                <DatePicker
                    x:Name="EnableDate"
                    Width="300"
                    Height="28"
                    Margin="0,0,0,0"
                    Padding="5,5,0,0"
                    VerticalAlignment="Center"
                    Language="zh-cn"
                    Text="{Binding EventDate}"
                    MouseDoubleClick="EnableDate_OnMouseDoubleClick"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
            </StackPanel>

            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{DynamicResource AalContent}" />
                <TextBox
                    x:Name="Note2"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding EventContent}" />
            </StackPanel>

            <StackPanel
                Margin="0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    Margin="0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{DynamicResource AalAboutUser}" />

                <StackPanel Orientation="Horizontal">

                    <TextBox
                        x:Name="AssetUser"
                        Width="235"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                        BorderThickness="0.5"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding UserName}" />

                    <Button
                        x:Name="FindUser"
                        Width="60"
                        Height="28"
                        Margin="0,0,0,0"
                        Padding="0"
                        BorderThickness="0"
                        Click="FindUser_OnClick"
                        ToolTip="查找用户">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Magnify" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>



            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{DynamicResource AalAboutNote}" />
                <TextBox
                    x:Name="Note"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Note}" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="10,0">


            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="10,10"
                HorizontalAlignment="Right"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedDarkButton}" />
        </Grid>

    </Grid>
</Window>
