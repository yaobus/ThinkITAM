<Window
    x:Class="ThinkITAM.Windows.NetworkManage.IpAddressTagWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IP地址详细信息-自定义字段"
    Width="600"
    Height="380"
    Closing="Window_Closing"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="30"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Kind="ApplicationVariableOutline" />

            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="自定义IP信息字段" />

        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <RadioButton
                x:Name="GlobalRadioButton"
                VerticalAlignment="Center"
                Click="GlobalRadioButton_OnClick"
                Content="全局默认标签"
                IsChecked="True"
                Style="{StaticResource MaterialDesignSecondaryRadioButton}"
                ToolTip="低优先级(存在网段独有标签时将优先显示独有标签)" />

            <RadioButton
                x:Name="LocalRadioButton"
                VerticalAlignment="Center"
                Click="LocalRadioButton_OnClick"
                Content="网段独有标签"
                IsChecked="False"
                Style="{StaticResource MaterialDesignSecondaryRadioButton}"
                ToolTip="高优先级" />


            <Button
                x:Name="ResetButton"
                HorizontalAlignment="Right"
                Click="ResetButton_Click"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="恢复默认标签">
                <materialDesign:PackIcon Kind="BackupRestore" />
            </Button>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center">
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段A:" />
                <TextBox
                    x:Name="TagA"
                    Width="240"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段B:" />
                <TextBox
                    x:Name="TagB"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段C:" />
                <TextBox
                    x:Name="TagC"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>





        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center">

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段D:" />
                <TextBox
                    x:Name="TagD"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段F:" />
                <TextBox
                    x:Name="TagF"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段E:" />
                <TextBox
                    x:Name="TagE"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
        </StackPanel>




        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="10">


            <Button
                x:Name="SaveButton"
                Width="150"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedDarkButton}" />
        </Grid>
    </Grid>
</Window>
