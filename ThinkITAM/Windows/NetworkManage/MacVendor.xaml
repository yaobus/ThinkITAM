<Window
    x:Class="ThinkITAM.Windows.NetworkManage.MacVendor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="通过MAC地址查询制造商"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="MacVendor_OnLoaded"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="5,5,5,2.5"
            BorderThickness="0"
            Style="{StaticResource MaterialDesignOutlinedCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Content="目标MAC:" />







                    </Grid>

                    <Button
                        x:Name="ScanButton"
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Right"
                        Click="ScanButton_OnClick"
                        Content="开始查询"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />

                    <Button
                        x:Name="MacHelp"
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Click="MacHelp_OnClick"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="查看MAC输入帮助">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" />
                    </Button>

                </Grid>

                <TextBox
                    x:Name="MacTextBox"
                    Grid.Row="1"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AcceptsReturn="True"
                    BorderThickness="0.5"
                    HorizontalScrollBarVisibility="Disabled"
                    Opacity="1"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />


            </Grid>







        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="1"
            Margin="5,2.5,5,5"
            BorderThickness="0"
            Style="{StaticResource MaterialDesignOutlinedCard}">

            <DataGrid
                x:Name="MacVendorDataGrid"
                Margin="5,5,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Visibility="Visible">


                <DataGrid.Columns>


                    <DataGridTemplateColumn
                        MinWidth="60"
                        MaxWidth="100"
                        CanUserSort="True"
                        SortMemberPath="Index">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Numbers" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="序号" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding Index}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        MinWidth="150"
                        MaxWidth="200"
                        CanUserSort="True"
                        SortMemberPath="MAC">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="ExpansionCard" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="MAC" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding Mac}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        MinWidth="200"
                        CanUserSort="True"
                        SortMemberPath="Vendor">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="ExpansionCard" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="制造商" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding Vendor}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                </DataGrid.Columns>
            </DataGrid>





        </materialDesign:Card>




        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>

    </Grid>



</Window>
