<Window
    x:Class="ThinkITAM.Windows.NetworkManage.FindUserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="查找用户"
    Width="800"
    Height="450"
    MinHeight="450"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="FindUserWindow_OnLoaded"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical">

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="一级组织:" />
                    <ComboBox
                        x:Name="OrganizationBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        MaxDropDownHeight="300"
                        SelectionChanged="OrganizationBox_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="二级组织:" />
                    <ComboBox
                        x:Name="DepartmentBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        MaxDropDownHeight="300"
                        SelectionChanged="DepartmentBox_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="三级组织:" />
                    <ComboBox
                        x:Name="GroupBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        MaxDropDownHeight="300"
                        SelectionChanged="GroupBox_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="用户姓名:" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            x:Name="UserName"
                            Width="205"
                            Height="28"
                            Margin="0,0,5,0"
                            Padding="3"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="User"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <Button
                            x:Name="SearchButton"
                            Width="40"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="SearchButton_OnClick"
                            Style="{StaticResource MaterialDesignFlatLightButton}">
                            <materialDesign:PackIcon HorizontalAlignment="Center" Kind="Magnify" />
                        </Button>

                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="用户编号:" />
                    <TextBox
                        x:Name="Number"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                </StackPanel>



            </StackPanel>
            <Grid

                Grid.Row="1"
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Width="100"
                    Margin="10,10"
                    HorizontalAlignment="Right"
                    Content="返回" />
                <Button
                    x:Name="SaveButton"
                    Grid.Column="1"
                    Width="100"
                    Margin="10,10"
                    HorizontalAlignment="Right"
                    Click="SaveButton_OnClick"
                    Content="确定" />

            </Grid>
        </Grid>



        <Grid Grid.Column="1">

            <DataGrid
                x:Name="PeopleListView"
                Margin="0,0,0,10"
                d:Visibility="Visible"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                SelectionChanged="PeopleListView_OnSelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Visibility="Visible">


                <DataGrid.Columns>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Index">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="FormatListNumbered" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="序号" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Text="{Binding Index}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Name">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Numeric9BoxMultipleOutline" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="编号" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding UserNumber}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Name">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="AccountOutline" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="姓名" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>



                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Organization">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="SourceCommitStartNextLocal" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="一级组织" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Organization}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Department">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="SourceMerge" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="二级组织" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Department}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Department">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="GraphOutline" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="三级组织" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Group}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Phone">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Phone" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="电话" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Phone}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Description">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="NotebookOutline" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="备注" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Description}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>



                </DataGrid.Columns>

            </DataGrid>


        </Grid>

    </Grid>


</Window>
