<Window
    x:Class="ThinkITAM.Windows.NetworkManage.AddNetworkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加网段"
    Width="880"
    Height="640"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddNetworkWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="40"
                    Height="40"
                    Kind="NewspaperPlus" />

                <TextBlock
                    Margin="10"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="新建网段" />

            </StackPanel>

            <Button
                x:Name="SetButton"
                Grid.Column="1"
                Click="SetButton_OnClick"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="自定义网段信息标签">
                <materialDesign:PackIcon Kind="Settings" />
            </Button>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="网段名称:" />
                    <TextBox
                        x:Name="TbName"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="网段内任意地址:" />
                    <TextBox
                        x:Name="IpTextBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


            </Grid>
            <Grid Grid.Row="1" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="网段备注:" />
                    <TextBox
                        x:Name="Description"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="掩码调整:" />
                    <Slider
                        x:Name="MaskSlider"
                        Width="250"
                        Margin="0,0,30,0"
                        Padding="3"
                        HorizontalAlignment="Right"
                        IsEnabled="True"
                        Maximum="30"
                        Minimum="20"
                        Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                        TickFrequency="1"
                        TickPlacement="Both"
                        ValueChanged="MaskSlider_OnValueChanged"
                        Value="24" />
                </StackPanel>




            </Grid>

            <Grid Grid.Row="2" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelA"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段A:"
                        ToolTip="自定义字段A" />
                    <ComboBox
                        x:Name="TbParent"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEditable="True"
                        SelectionChanged="Parent_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="子网掩码:" />
                    <TextBox
                        x:Name="Netmask"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>

            </Grid>
            <Grid Grid.Row="3" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段B:"
                        ToolTip="自定义字段B" />
                    <ComboBox
                        x:Name="Child"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEditable="True"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="网段地址:" />
                    <TextBox
                        x:Name="Network"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>







            </Grid>
            <Grid Grid.Row="4" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelC"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段C:"
                        ToolTip="自定义字段C" />
                    <TextBox
                        x:Name="TagA"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Tag"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="第一个可用地址:" />
                    <TextBox
                        x:Name="First"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="PageFirst"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>



            </Grid>
            <Grid Grid.Row="5" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelD"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段D:"
                        ToolTip="自定义字段D" />
                    <TextBox
                        x:Name="TagB"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Tag"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="最后一个可用地址:" />
                    <TextBox
                        x:Name="Last"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="PageLast"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>





            </Grid>


            <Grid Grid.Row="6" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelE"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段E:"
                        ToolTip="自定义字段E" />
                    <TextBox
                        x:Name="TagC"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Tag"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="广播地址:" />
                    <TextBox
                        x:Name="Broadcast"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="broadcast"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>




            </Grid>

            <Grid Grid.Row="7" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelF"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段F:"
                        ToolTip="自定义字段F" />
                    <TextBox
                        x:Name="TagD"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Tag"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="可用地址数量:" />
                    <TextBox
                        x:Name="NumBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </StackPanel>


            </Grid>

            <Grid Grid.Row="8" Margin="30,0">


                <Button
                    x:Name="SaveButton"
                    Width="150"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0"
                    Click="SaveButton_OnClick"
                    Content="保存" />
            </Grid>
        </Grid>




    </Grid>
</Window>
