<Window
    x:Class="ThinkITAM.Windows.NetworkManage.PortScanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TCP端口扫描器"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PortScanWindow_OnLoaded"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="5,5,5,2.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <Label
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Content="目标主机:" />




                        <TextBox
                            x:Name="HostTextBox"
                            Grid.Column="3"
                            Height="36"
                            Margin="0,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            BorderThickness="0.5"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />



                    </Grid>

                    <Button
                        x:Name="ScanButton"
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Right"
                        Click="ButtonBase_OnClick"
                        Content="开始扫描"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />

                    <Button
                        x:Name="HostHelp"
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Click="HostHelp_OnClick"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="查看主机输入帮助">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" />
                    </Button>

                </Grid>


                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0"
                        Width="60"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="检测端口:" />





                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <RadioButton
                            x:Name="SshPortRadioButton"
                            Click="SshPortRadioButton_OnClick"
                            Content="22,23"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />
                        <RadioButton
                            x:Name="WebPortRadioButton"
                            Margin="5,0"
                            Click="WebPortRadioButton_OnClick"
                            Content="80,443"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />
                        <RadioButton
                            x:Name="DbPortRadioButton"
                            Margin="5,0"
                            Click="DbPortRadioButton_OnClick"
                            Content="3306,3307"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />
                        <RadioButton
                            x:Name="RdpPortRadioButton"
                            Margin="5,0"
                            Click="RdpPortRadioButton_OnClick"
                            Content="3389"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />
                        <RadioButton
                            x:Name="PresetRadioButton"
                            Margin="5,0"
                            Content="预设方案"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                x:Name="PortPresetComboBox"
                                Width="100"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                DisplayMemberPath="Name"
                                MaxDropDownHeight="300"
                                SelectionChanged="PortPresetComboBox_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        </StackPanel>

                    </StackPanel>

                    <TextBox
                        x:Name="PortTextBox"
                        Grid.Column="2"
                        Height="36"
                        Margin="0,0,0,0"
                        Padding="0"
                        BorderThickness="0.5"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="80,443" />

                    <Button
                        x:Name="SavePresetButton"
                        Grid.Column="3"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Right"
                        Click="SavePresetButton_OnClick"
                        Content="存为预设"
                        Style="{StaticResource MaterialDesignRaisedLightButton}"
                        ToolTip="将需要检测的端口保存到预设库，方便下次使用" />




                    <!--<materialDesign:DialogHost Grid.Column="3" Identifier="RootDialog">
                    <Grid>
                    <Button
                    x:Name="SavePresetButton"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Right"
                    ToolTip="将需要检测的端口保存到预设库，方便下次使用"
                    Content="存为预设"
                    Foreground="AliceBlue"
                    Click="SavePresetButton_OnClick"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" />

                    </Grid>
                    </materialDesign:DialogHost>-->



                    <Button
                        x:Name="PortHelp"
                        Grid.Column="4"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Click="PortHelp_OnClick"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="查看端口输入帮助">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" />
                    </Button>

                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        Width="60"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="检测选项:" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <RadioButton
                            x:Name="PingTestRadioButton"
                            Margin="0,0"
                            Content="在线主机"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />

                        <RadioButton
                            x:Name="AllTestRadioButton"
                            Margin="0,0"
                            Content="全部主机"
                            Style="{StaticResource MaterialDesignLightRadioButton}" />


                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <CheckBox
                            x:Name="HostNameCheckBox"
                            Margin="0,0,5,0"
                            Content="检测主机名和MAC"
                            IsChecked="False"
                            Style="{StaticResource MaterialDesignSecondaryCheckBox}" />

                        <CheckBox
                            x:Name="TimeSetting"
                            Margin="0,0,5,0"
                            Content="自定义超时"
                            IsChecked="False"
                            Style="{StaticResource MaterialDesignSecondaryCheckBox}" />


                        <TextBox
                            x:Name="TimeOutBox"
                            Width="100"
                            Height="36"
                            Margin="5,0"
                            Padding="0"
                            MaxLength="4"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="1000" />
                    </StackPanel>
                    <Button
                        x:Name="Export"
                        Grid.Column="3"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Click="Export_OnClick"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="导出扫描结果">
                        <materialDesign:PackIcon Kind="TrayArrowDown" />
                    </Button>

                </Grid>


            </Grid>







        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Margin="5,2.5,5,2.5">
            <Grid>



                <DataGrid
                    x:Name="HostStatusDataGrid"
                    Margin="0,5,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Visibility="Visible">


                    <DataGrid.Columns>

                        <DataGridTemplateColumn
                            MinWidth="100"
                            MaxWidth="150"
                            CanUserSort="True"
                            SortMemberPath="Index">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Counter" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="序号" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding Index}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            MinWidth="150"
                            MaxWidth="200"
                            CanUserSort="True"
                            SortMemberPath="Name">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Ip" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="主机" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Host}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            MinWidth="150"
                            MaxWidth="200"
                            CanUserSort="True"
                            SortMemberPath="HostName">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Computer" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="主机名" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding HostName}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            MinWidth="150"
                            MaxWidth="200"
                            CanUserSort="True"
                            SortMemberPath="MAC">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="ExpansionCard" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="MAC" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Mac}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            MinWidth="150"
                            MaxWidth="400"
                            CanUserSort="True"
                            SortMemberPath="Vendor">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="ExpansionCard" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="制造商" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Vendor}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn
                            MinWidth="200"
                            MaxWidth="800"
                            CanUserSort="True"
                            SortMemberPath="Ports">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="SerialPort" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="开放端口" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding OpenedPorts}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                    </DataGrid.Columns>
                </DataGrid>


            </Grid>


        </materialDesign:Card>


        <materialDesign:Card Grid.Row="2" Margin="5,2.5,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar
                    x:Name="ScanMainProgressBar"
                    Grid.Row="0"
                    Height="5"
                    Value="0" />
            </Grid>
        </materialDesign:Card>


        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>


        <materialDesign:DialogHost
            x:Name="SavePresetDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            DialogClosed="DialogHost_OnDialogClosed"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">
                    <TextBlock
                        MaxWidth="400"
                        FontSize="14"
                        Text="输入端口方案名称" />
                    <TextBox
                        x:Name="NameTextBox"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        FontSize="14" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SaveButton"
                            Margin="0,8,8,0"
                            Click="SaveButton_OnClick"
                            Content="保存"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Margin="0,8,8,0"
                            Click="CancelButton_OnClick"
                            Content="关闭"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>

    </Grid>


</Window>
