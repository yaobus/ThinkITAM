<Window
    x:Class="ThinkITAM.Windows.NetworkManage.AddressCollectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="将地址添加到收藏夹"
    Width="500"
    Height="580"

    FontFamily="{StaticResource HarmonyOsFontFamily}"

    Loaded="AddressCollectWindow_OnLoaded"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="30"
                    Height="30"
                    Margin="10"
                    VerticalAlignment="Center"
                    Kind="StarPlusOutline" />

                <TextBlock
                    Margin="10"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="添加地址到快捷访问收藏夹" />

            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="要收藏的地址:" />
                <TextBox
                    x:Name="Host"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="IpNetwork"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Host, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="所使用的协议:" />
                <TextBox
                    x:Name="Protocol"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    d:Text="https://"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Protocol"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Protocol, Mode=TwoWay}"
                    ToolTip="https://或者http://" />

            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="特殊端口指定:" />
                <TextBox
                    x:Name="Port"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="MidiPort"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Port, Mode=TwoWay}"
                    ToolTip="80,和443端口无需指定" />

            </StackPanel>

            <StackPanel
                Grid.Row="4"
                Grid.Column="0"
                Margin="10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="选择或创建群组:" />
                <ComboBox
                    x:Name="Groups"
                    Width="220"
                    Height="28"
                    Margin="10,0,0,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="FolderStarMultipleOutline"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    Text="{Binding Group, Mode=TwoWay}" />

                <Button
                    x:Name="DeleteButton"
                    Width="30"
                    Height="30"
                    Margin="0,0,10,0"
                    Padding="0"
                    Click="DeleteButton_OnClick"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="删除当前选中群组">
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="DeleteOutline" />
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Row="5"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="标签名称:" />
                <TextBox
                    x:Name="Name"
                    Width="250"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Notebook"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Name, Mode=TwoWay}" />

            </StackPanel>

            <StackPanel
                Grid.Row="6"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="色彩标签:" />
                <ListBox
                    x:Name="IndexColor"
                    Width="250"
                    Height="30"
                    Margin="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SelectedIndex="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="IndexColor_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignToolToggleListBox}">
                    <ListBoxItem
                        Width="30"
                        Margin="0,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        ToolTip="选择此项将不显示标签">
                        <Grid HorizontalAlignment="Center">
                            <Grid Width="30">
                                <TextBlock
                                    Margin="0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Text="Null" />
                            </Grid>
                        </Grid>



                    </ListBoxItem>
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#FF0080"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#F15A24"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#FBC02D"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#64DD17"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#00A8FF"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#008080"
                        Opacity="1" />
                    <ListBoxItem
                        Width="30"
                        Height="30"
                        Margin="1,0"
                        Background="#362391"
                        Opacity="1" />


                </ListBox>

            </StackPanel>

            <StackPanel
                Grid.Row="7"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    VerticalAlignment="Center"
                    Text="指定打开浏览器:" />
                <ComboBox
                    x:Name="BrowserCombobox"
                    Width="250"
                    Height="32"
                    MinWidth="72"
                    Margin="5,0"
                    Padding="0"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="GoogleChrome"
                    DisplayMemberPath="Browser"
                    SelectedIndex="{Binding Index, Mode=OneWay}"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    ToolTip="选择用来打开地址的浏览器，可在预设页面管理浏览器" />

            </StackPanel>


            <Button
                x:Name="SaveButton"
                Grid.Row="8"
                Width="150"
                Margin="0,0,75,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="SaveButton_OnClick"
                Content="保存" />

        </Grid>

        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="1"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>


        <materialDesign:DialogHost
            x:Name="DeleteDialogHost"
            Grid.Row="0"
            d:Visibility="Collapsed"
            DialogClosed="DeleteDialogHost_OnDialogClosed"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">

                    <TextBlock
                        FontSize="14"
                        FontWeight="ExtraBlack"
                        Text="确定删除群组？" />

                    <TextBlock
                        MaxWidth="400"
                        Margin="0,14,0,0"
                        FontSize="14"
                        Foreground="#CF3539"
                        Text="如果该群组下存在其他地址，删除将导致这些地址无法被找到，是否继续删除？"
                        TextWrapping="Wrap" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="Agree"
                            Margin="0,8,8,0"
                            Click="Agree_OnClick"
                            Content="确定"
                            Foreground="#CF3539"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="Reject"
                            Margin="0,8,8,0"
                            Click="Reject_OnClick"
                            Content="取消"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>


    </Grid>
</Window>
