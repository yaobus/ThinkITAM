<Window
    x:Class="ThinkITAM.Windows.NetworkManage.AddressAllocationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="地址分配"
    Width="650"
    Height="700"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddressAllocationWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
        <converters:AddressStatusToBoolConverter x:Key="AddressStatusToBoolConverter" />
    </Window.Resources>
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="130" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="NowHostName"
                Grid.Row="1"
                Grid.Column="0"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前使用该IP的主机"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Laptop"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />


            <TextBox
                x:Name="NowMacAddress"
                Grid.Row="1"
                Grid.Column="1"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前主机的MAC地址"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="ExpansionCard"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">



                <Button
                    x:Name="StatusPing"
                    Width="24"
                    Height="24"
                    Margin="15,0,15,0"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                    materialDesign:ButtonProgressAssist.Value="-1"
                    Click="StatusPing_OnClick"
                    Content="{materialDesign:PackIcon Radar}"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                    ToolTip="尝试获取主机名和MAC地址" />



                <Button
                    x:Name="CopyHostInfo"
                    Width="32"
                    Height="32"
                    Margin="15,0,15,0"
                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                    Click="CopyHostInfo_Click"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="提取获取到的主机名和MAC地址">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="EyedropperRemove" />
                </Button>




            </StackPanel>


            <TextBox
                x:Name="NowNetworkName"
                Grid.Row="2"
                Grid.Column="0"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前网段名称"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Note"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />



            <TextBox
                x:Name="NowNetwork"
                Grid.Row="2"
                Grid.Column="1"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前网段地址"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Grid Grid.Row="2" Grid.Column="2">



                <TextBox
                    x:Name="NowMaskText"
                    Width="200"
                    Margin="5,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="子网掩码"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Lastpass"
                    IsEnabled="False"
                    Opacity="0.5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />


            </Grid>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="5,0"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <TextBlock
                    FontWeight="ExtraBold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="所选地址:" />
                <TextBlock
                    x:Name="SelectedAddress"
                    d:Text="192.168.0.2"
                    FontWeight="ExtraBold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}" />

            </StackPanel>


        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="所属用户:" />

                    <StackPanel Orientation="Horizontal">

                        <TextBox
                            x:Name="People"
                            Width="195"
                            Height="28"
                            Margin="0,0,5,0"
                            Padding="0"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Name}" />
                        <Button
                            x:Name="FindUser"
                            Width="50"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            Click="FindUser_OnClick">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="AccountSearchOutline" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="关联组织:" />
                    <TextBox
                        x:Name="Organization"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Organization}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="所属部门:"
                        ToolTip="自定义字段A" />
                    <TextBox
                        x:Name="Department"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Department}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="所在群组:" />
                    <TextBox
                        x:Name="Group"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Group}" />

                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="所在单元:" />
                    <TextBox
                        x:Name="Unit"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Unit}" />

                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="联系电话:"
                        ToolTip="联系电话:" />

                    <TextBox
                        x:Name="Phone"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Phone}" />

                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="主机名称:"
                        ToolTip="主机名称" />
                    <TextBox
                        x:Name="HostNameBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Laptop"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding HostName}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="MAC地址:"
                        ToolTip="MAC地址" />
                    <TextBox
                        x:Name="MacAddressBox"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="ExpansionCard"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding MacAddress}" />
                </StackPanel>



            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="设定标签颜色:"
                        ToolTip="自定义端口颜色标签" />

                    <ListBox
                        x:Name="PortColor"
                        Width="250"
                        Height="30"
                        SelectedIndex="{Binding AddressColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="PortColor_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignToolToggleListBox}">
                        <ListBoxItem
                            Width="26"
                            Margin="0,0,1,0"
                            Padding="0"
                            Background="Transparent"
                            Opacity="0.1"
                            ToolTip="选择此项将不显示标签">
                            <Grid HorizontalAlignment="Center">

                                <TextBlock
                                    Margin="2,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Text="Null" />

                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#FF0080"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#F15A24"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#FBC02D"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#64DD17"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#00A8FF"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#008080"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#362391"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0,0,0"
                            Background="#212121"
                            Opacity="0.1" />

                    </ListBox>

                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelA"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段A:"
                        ToolTip="自定义字段A" />
                    <TextBox
                        x:Name="TagA"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagA}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelB"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段B:"
                        ToolTip="自定义字段B" />
                    <TextBox
                        x:Name="TagB"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagB}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelC"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段C:"
                        ToolTip="自定义字段C" />
                    <TextBox
                        x:Name="TagC"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagC}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelD"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段D:"
                        ToolTip="自定义字段D" />
                    <TextBox
                        x:Name="TagD"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagD}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelE"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段E:"
                        ToolTip="自定义字段E" />
                    <TextBox
                        x:Name="TagE"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagE}" />
                </StackPanel>
                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        x:Name="LabelF"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="自定义字段F:"
                        ToolTip="自定义字段F" />
                    <TextBox
                        x:Name="TagF"
                        Width="250"
                        Height="28"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagF}" />
                </StackPanel>

                <StackPanel
                    Margin="{StaticResource DefaultMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="关联资产:"
                        ToolTip="使用该IP地址的资产设备" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            x:Name="LinkAsset"
                            Width="195"
                            Height="28"
                            Margin="0,0,5,0"
                            Padding="3"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="ServerNetwork"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding LinkDevice}" />

                        <Button
                            x:Name="FindAsset"
                            Width="50"
                            Height="28"
                            Margin="0,0,10,0"
                            Padding="0"
                            Click="FindAsset_Click">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="HomeSearchOutline" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </StackPanel>






            </StackPanel>




        </Grid>



        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <CheckBox
                    x:Name="IsAllocation"
                    Margin="20,0,0,0"
                    Content="是否启用分配"
                    Click="IsAllocation_OnClick"
                    IsChecked="{Binding AddressStatus, Converter={StaticResource AddressStatusToBoolConverter}, Mode=OneWay}"
                    Style="{StaticResource MaterialDesignSecondaryCheckBox}" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="10"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    x:Name="ClearButton"
                    Width="150"
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    d:Visibility="Visible"
                    Click="ClearButton_OnClick"
                    Content="清空配置"
                    Visibility="Visible" />

                <Button
                    x:Name="SaveButton"
                    Width="150"
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    Click="SaveButton_OnClick"
                    Content="保存配置" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
