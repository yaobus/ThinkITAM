<Window
    x:Class="ThinkITAM.Windows.NetworkManage.AddNetworkWindowSet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="新增网段窗口-自定义字段"
    Width="630"
    Height="380"
    Closing="AddNetworkWindowSet_OnClosing"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddNetworkWindowSet_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="30"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Kind="ApplicationVariableOutline" />

            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="自定义网段信息字段" />

        </StackPanel>

        <Button
            x:Name="ResetButton"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Click="ResetButton_OnClick"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="恢复默认标签">
            <materialDesign:PackIcon Kind="BackupRestore" />
        </Button>


        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center">
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段A:" />
                <TextBox
                    x:Name="TagA"
                    Width="240"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段B:" />
                <TextBox
                    x:Name="TagB"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段C:" />
                <TextBox
                    x:Name="TagC"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>





        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center">

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段D:" />
                <TextBox
                    x:Name="TagD"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>



            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段F:" />
                <TextBox
                    x:Name="TagF"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="自定义字段E:" />
                <TextBox
                    x:Name="TagE"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
        </StackPanel>




        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Margin="10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="10,0,30,0"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedDarkButton}" />
        </StackPanel>


    </Grid>
</Window>
