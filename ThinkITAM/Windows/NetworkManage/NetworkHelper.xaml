<Window
    x:Class="ThinkITAM.Windows.NetworkManage.NetworkHelper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="IP、网段、掩码计算器"
    Width="1000"
    Height="850"
    MinWidth="1000"
    MinHeight="850"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="5,5,5,2.5">

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="10,10,10,10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Kind="IpNetwork" />

                    <TextBlock
                        Margin="10"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="IP网段计算器" />

                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical">

                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="主机地址:" />
                            <TextBox
                                x:Name="IpTextBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="192.168.0.1" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="掩码调整:" />
                            <Slider
                                x:Name="MaskSlider"
                                Width="250"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Right"
                                IsEnabled="True"
                                Maximum="30"
                                Minimum="8"
                                Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                TickFrequency="1"
                                TickPlacement="Both"
                                ValueChanged="MaskSlider_OnValueChanged"
                                Value="24" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="子网掩码:" />
                            <TextBox
                                x:Name="Netmask"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="网段地址:" />
                            <TextBox
                                x:Name="Network"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="第一个地址:" />
                            <TextBox
                                x:Name="First"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="PageFirst"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="最后一个地址:" />
                            <TextBox
                                x:Name="Last"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="PageLast"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>


                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="广播地址:" />
                            <TextBox
                                x:Name="Broadcast"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="broadcast"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="可用地址数量:" />
                            <TextBox
                                x:Name="NumBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Margin="5,2.5,5,2.5">

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="10,10,10,10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Kind="LastPass" />

                    <TextBlock
                        Margin="10"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="子网掩码进制转换器" />

                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical">

                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="掩码位数调整:" />
                            <Slider
                                x:Name="MaskSlider2"
                                Width="250"
                                Margin="0,0,30,0"
                                Padding="3"
                                HorizontalAlignment="Right"
                                IsEnabled="True"
                                Maximum="30"
                                Minimum="8"
                                Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                TickFrequency="1"
                                TickPlacement="Both"
                                ValueChanged="MaskSlider2_OnValueChanged"
                                Value="24" />
                        </StackPanel>
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="子网掩码位数:" />
                            <TextBox
                                x:Name="MaskLengthBox2"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="可用地址数量:" />
                            <TextBox
                                x:Name="AvailableAddressBox"
                                Width="300"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>


                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Dec 十进制：" />
                            <TextBox
                                x:Name="MaskDecBox2"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Hex 十六进制：" />
                            <TextBox
                                x:Name="MaskHexBox2"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Bin 二进制：" />
                            <TextBox
                                x:Name="MaskBinBox2"
                                Width="300"
                                Height="28"
                                Margin="0,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="False"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal" />
                </StackPanel>
            </Grid>

        </materialDesign:Card>


        <materialDesign:Card Grid.Row="2" Margin="5,2.5,5,5">


            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="10,10,10,10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Kind="Hexadecimal" />

                    <TextBlock
                        Margin="10"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="按所需IP数量计算最小网段掩码地址" />

                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical">

                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="需要地址的数量：" />
                            <TextBox
                                x:Name="NeedNumBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextChanged="NeedNumBox_OnTextChanged" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="子网掩码位数:" />
                            <TextBox
                                x:Name="MaskLengthBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="子网掩码:" />
                            <TextBox
                                x:Name="MaskBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="可用地址数:" />
                            <TextBox
                                x:Name="AvailableNumBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Grid>


        </materialDesign:Card>

        <materialDesign:DialogHost
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>
    </Grid>


</Window>
