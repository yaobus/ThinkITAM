<Window
    x:Class="ThinkITAM.Windows.ToolWindows.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.ToolWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="删除确认"
    Width="400"
    Height="270"
    Background="#333333"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <materialDesign:PackIcon
                Width="30"
                Height="30"
                Margin="5"
                Foreground="#Cf3539"
                Kind="Alert" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="ExtraBold"
                Foreground="#Cf3539"
                Text="警告！危险操作！" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Top"
            Orientation="Vertical">

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    Margin="5,5,5,5"
                    Foreground="AliceBlue"
                    Kind="InformationVariantCircleOutline" />
                <TextBlock
                    Margin="0,5,5,5"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#CF3539"
                    Text="此操作将删除整个网段，且无法恢复，是否继续？" />
            </StackPanel>
            <TextBox
                MaxWidth="340"
                MaxHeight="100"
                Margin="30,5,5,5"
                HorizontalAlignment="Left"
                AcceptsReturn="True"
                BorderThickness="0"
                FontSize="16"
                Foreground="AliceBlue"
                IsEnabled="False"
                Text="如果你已知悉此操作的后果，请在下列输入框内输入 YES 然后再点击 “确定”按钮"
                TextWrapping="Wrap" />


            <TextBox
                x:Name="InputBox"
                Width="340"
                Height="40"
                Padding="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="16"
                Foreground="AliceBlue"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="25,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <Button
                    x:Name="YesButton"
                    Width="100"
                    Height="30"
                    Margin="5"
                    HorizontalAlignment="Right"
                    Background="#Cf3539"
                    BorderThickness="0"
                    Click="YesButton_OnClick"
                    Content="确定" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="0,0,25,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <Button
                    x:Name="NoButton"
                    Width="100"
                    Height="30"
                    Margin="5"
                    HorizontalAlignment="Right"
                    BorderThickness="0"
                    Click="NoButton_OnClick"
                    Content="取消" />

            </StackPanel>
        </Grid>
    </Grid>
</Window>
