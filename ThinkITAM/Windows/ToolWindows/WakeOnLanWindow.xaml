<Window
    x:Class="ThinkITAM.Windows.ToolWindows.WakeOnLanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:local="clr-namespace:ThinkITAM.Windows.ToolWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:others="clr-namespace:ThinkITAM.ViewModels.Others"
    Title="网络唤醒"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="WakeOnLanWindow_OnLoaded"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter" />

    </Window.Resources>
    <Window.DataContext>
        <others:WakeOnLanHostViewModel />
    </Window.DataContext>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="5,5,5,2.5"
            HorizontalAlignment="Stretch">

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="10,20,10,10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Kind="PowerSettings" />

                    <TextBlock
                        Margin="10"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="网络唤醒工具" />

                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical">

                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                Width="100"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="IP地址:" />
                            <TextBox
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                IsEnabled="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding ElementName=DiskNumberSlider, Path=Value}" />

                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                Width="100"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="MAC地址:" />
                            <TextBox
                                x:Name="MacBox"
                                Width="250"
                                Height="28"
                                Margin="0,0,30,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="ExpansionCard"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <Button
                                x:Name="AddHostButton"
                                Click="AddHostButton_OnClick"
                                Content="ADD"
                                Style="{StaticResource MaterialDesignRaisedLightButton}" />
                        </StackPanel>

                    </StackPanel>


                    <StackPanel Margin="10" Orientation="Horizontal">

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal" />

                    </StackPanel>




                </StackPanel>
            </Grid>
        </materialDesign:Card>


        <materialDesign:Card Grid.Row="1" Margin="5,2.5,5,5">

            <DataGrid
                x:Name="HostsDataGrid"
                VerticalAlignment="Stretch"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                MouseDoubleClick="HostsDataGrid_OnMouseDoubleClick"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="100"
                        CanUserSort="False"
                        SortMemberPath="CodingType">
                        <DataGridTemplateColumn.Header>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Numbers" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="序号" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Index}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn
                        Width="150"
                        CanUserSort="False"
                        SortMemberPath="SaveDay">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="ExpansionCard" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="MAC地址" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Mac}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="False"
                        SortMemberPath="CameraNumber">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="IpNetworkOutline" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="IP地址" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding IpAddress}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="False"
                        SortMemberPath="CameraNumber">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="LastPass" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="子网掩码" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Netmask}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="120" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="SerialPort" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="端口号" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Port}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="False"
                        SortMemberPath="Resolution">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Group" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="群组" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding HostGroup}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="False"
                        SortMemberPath="Resolution">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Note" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="名称" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="False"
                        SortMemberPath="StorageSpace"
                        Visibility="Collapsed">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Hdd" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="状态" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>




                    <DataGridTemplateColumn Width="140" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="PowerSettings" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="精准唤醒" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button
                                        x:Name="WakeOnLanButton0"
                                        Margin="5,0"
                                        Click="WakeOnLanButton0_OnClick"
                                        Content="精准唤醒"
                                        IsEnabled="{Binding IpAddress, Converter={StaticResource StringToBooleanConverter}}"
                                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="140" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="PowerSettings" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="广播唤醒" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button
                                        x:Name="WakeOnLanButton"
                                        Margin="5,0"
                                        Click="WakeOnLanButton_OnClick"
                                        Content="广播唤醒"
                                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="140" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Kind="Delete" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="删除" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button
                                        x:Name="DeleteButton"
                                        Margin="5,0"
                                        Content="删除"
                                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </materialDesign:Card>
    </Grid>
</Window>
