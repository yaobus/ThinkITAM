<Window
    x:Class="ThinkITAM.Windows.ToolWindows.WakeOnLanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:local="clr-namespace:ThinkITAM.Windows.ToolWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:others="clr-namespace:ThinkITAM.ViewModels.Others"
    xmlns:wakeOnLan="clr-namespace:ThinkITAM.UserControls.WakeOnLan"
    Title="网络唤醒"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="WakeOnLanWindow_OnLoaded"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter" />

    </Window.Resources>
    <Window.DataContext>
        <others:WakeOnLanHostViewModel />
    </Window.DataContext>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="5,5,5,2.5"
            HorizontalAlignment="Stretch">

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,20,10,10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Kind="PowerSettings" />

                    <TextBlock
                        Margin="10"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="网络唤醒工具" />

                </StackPanel>

                <Button
                    x:Name="AddHostButton"
                    Grid.Column="1"
                    Margin="5,0,5,0"
                    Click="AddHostButton_OnClick"
                    Style="{StaticResource MaterialDesignRaisedLightButton}">

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Kind="DesktopClassic" />

                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Text="新增" />

                    </StackPanel>
                </Button>


            </Grid>
        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="1"
            Margin="5,2.5,5,5"
            Background="Transparent">
            <Grid>
                <materialDesign:ColorZone
                    Margin="10"
                    VerticalAlignment="Stretch"
                    d:Background="OliveDrab"
                    CornerRadius="5">
                    <ScrollViewer
                        Margin="-5,0,-5,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl
                            x:Name="HostsPanel"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.IsDropTarget="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <wakeOnLan:HostPanel Margin="10,10" />
                                    </Grid>


                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>



                    </ScrollViewer>

                </materialDesign:ColorZone>



                <DataGrid
                    x:Name="HostsDataGrid"
                    VerticalAlignment="Stretch"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    MouseDoubleClick="HostsDataGrid_OnMouseDoubleClick"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="100"
                            CanUserSort="False"
                            SortMemberPath="CodingType">
                            <DataGridTemplateColumn.Header>
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Numbers" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="序号" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Index}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="120"
                            CanUserSort="False"
                            SortMemberPath="Resolution">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Note" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="名称" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="150"
                            CanUserSort="False"
                            SortMemberPath="SaveDay">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="ExpansionCard" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="MAC地址" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Mac}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn
                            Width="120"
                            CanUserSort="False"
                            SortMemberPath="Resolution">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Group" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="群组" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding HostGroup}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn
                            Width="120"
                            CanUserSort="False"
                            SortMemberPath="StorageSpace"
                            Visibility="Collapsed">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Hdd" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="状态" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Status}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="PowerSettings" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="网络唤醒" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button
                                            x:Name="WakeOnLanButton0"
                                            Margin="5,0"
                                            Click="WakeOnLanButton0_OnClick"
                                            Content="网络唤醒"
                                            IsEnabled="{Binding IpAddress, Converter={StaticResource StringToBooleanConverter}}"
                                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Delete" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="删除" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button
                                            x:Name="DeleteButton"
                                            Margin="5,0"
                                            Content="删除"
                                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Snackbar
            x:Name="Snackbar"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#6fc6c5"
            Foreground="White"
            MessageQueue="{materialDesign:MessageQueue}" />
    </Grid>
</Window>