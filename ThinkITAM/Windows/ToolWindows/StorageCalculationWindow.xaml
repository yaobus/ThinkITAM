<Window
    x:Class="ThinkITAM.Windows.ToolWindows.StorageCalculationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.ToolWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="存储空间计算器"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    SizeChanged="StorageCalculationWindow_OnSizeChanged"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <materialDesign:Card
                Grid.Row="0"
                Margin="5,5,5,2.5"
                HorizontalAlignment="Stretch"
                Background="#404040">

                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="10,20,10,10"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Kind="Nas" />

                        <TextBlock
                            Margin="10"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="RAID存储空间计算器" />

                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical">

                        <StackPanel Margin="10" Orientation="Horizontal">

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="RAID类型:" />
                                <ComboBox
                                    x:Name="RaidComboBox"
                                    Width="250"
                                    Height="32"
                                    Margin="0,0,30,0"
                                    Padding="0"
                                    MaxDropDownHeight="300"
                                    SelectedIndex="0"
                                    SelectionChanged="RaidComboBox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="硬盘总数量:" />
                                <Slider
                                    x:Name="DiskNumberSlider"
                                    Width="250"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    HorizontalAlignment="Right"
                                    IsEnabled="True"
                                    Maximum="48"
                                    Minimum="2"
                                    PreviewMouseUp="DiskNumberSlider_OnPreviewMouseUp"
                                    Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                    TickFrequency="1"
                                    TickPlacement="Both"
                                    ValueChanged="DiskNumberSlider_OnValueChanged"
                                    Value="2" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="热备盘数量:" />
                                <Slider
                                    x:Name="HotBackupSlider"
                                    Width="250"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    HorizontalAlignment="Right"
                                    IsEnabled="True"
                                    Minimum="0"
                                    PreviewMouseUp="HotBackupSlider_OnPreviewMouseUp"
                                    Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                    TickFrequency="1"
                                    TickPlacement="Both"
                                    ValueChanged="HotBackupSlider_OnValueChanged"
                                    Value="0" />
                            </StackPanel>

                        </StackPanel>


                        <StackPanel Margin="10" Orientation="Horizontal">

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="磁盘总数量:" />

                                <TextBox
                                    x:Name="DiskNumber"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ElementName=DiskNumberSlider, Path=Value}" />

                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="卷内磁盘数量:" />

                                <TextBox
                                    x:Name="VolumeDiskNumber"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="热备磁盘数量:" />

                                <TextBox
                                    x:Name="HotBackupDiskNumber"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ElementName=HotBackupSlider, Path=Value}" />

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Margin="10" Orientation="Horizontal">
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="单块硬盘容量:" />

                                <TextBox
                                    x:Name="SpaceBox"
                                    Width="140"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="False"
                                    materialDesign:TextFieldAssist.LeadingIcon="VolumeHigh"
                                    IsEnabled="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="1"
                                    TextChanged="SpaceBox_OnTextChanged" />
                                <ComboBox
                                    x:Name="UnitBox"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,30,0"
                                    Padding="0"
                                    MaxDropDownHeight="300"
                                    SelectedIndex="1"
                                    SelectionChanged="UnitBox_OnSelectionChanged"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="阵列可用空间:" />
                                <TextBox
                                    x:Name="VolumeSpace"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="False"
                                    materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                    Background="#4CAF50"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>


                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="数据保护空间:" />
                                <TextBox
                                    x:Name="ProtectionSpaceTextBox"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="False"
                                    materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                    Background="#00BCD4"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                        </StackPanel>


                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <UniformGrid
                                Grid.Column="0"
                                Width="350"
                                Margin="0,0,30,0"
                                Columns="3"
                                Rows="1">

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Label
                                        Width="60"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="可用容量：" />
                                    <Grid Width="40" Background="#4CAF50" />

                                </StackPanel>

                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Label
                                        Width="60"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="保护容量：" />
                                    <Grid Width="40" Background="#00BCD4" />

                                </StackPanel>

                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Label
                                        Width="60"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="热备容量：" />
                                    <Grid Width="40" Background="#FF9800" />

                                </StackPanel>


                            </UniformGrid>





                        </Grid>

                        <Grid
                            x:Name="SizeGrid"
                            Width="1300"
                            Height="30"
                            Margin="10"
                            HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="AvailableSpace"
                                Grid.Column="0"
                                Background="#4CAF50">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding ElementName=VolumeSpace, Path=Text}" />
                            </Grid>
                            <Grid
                                x:Name="ProtectionSpace"
                                Grid.Column="1"
                                Background="#00BCD4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding ElementName=ProtectionSpaceTextBox, Path=Text}" />
                            </Grid>
                            <Grid
                                x:Name="HotBackupSpace"
                                Grid.Column="2"
                                Background="#FF9800">
                                <TextBlock
                                    x:Name="HotBackupSpaceTextBlock"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                            </Grid>
                        </Grid>

                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card
                Grid.Row="1"
                Margin="5,2.5,5,2.5"
                Background="#404040">

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="10,20,10,10"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Kind="Hdd" />

                        <TextBlock
                            Margin="10"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="监控存储空间计算" />

                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical">

                        <materialDesign:Card>
                            <TabControl HorizontalContentAlignment="Left" Foreground="AliceBlue">
                                <TabItem Foreground="AliceBlue" Header="按分辨率计算">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="10"
                                            Orientation="Horizontal">
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="编码类型:" />
                                                <ComboBox
                                                    x:Name="CodingTypeComboBox"
                                                    Width="150"
                                                    Height="32"
                                                    Margin="0,0,15,0"
                                                    Padding="0"
                                                    MaxDropDownHeight="300"
                                                    SelectedIndex="0"
                                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="摄像头分辨率:" />
                                                <ComboBox
                                                    x:Name="ResolutionComboBox"
                                                    Width="150"
                                                    Height="32"
                                                    Margin="0,0,15,0"
                                                    Padding="0"
                                                    MaxDropDownHeight="300"
                                                    SelectedIndex="0"
                                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="摄像头数量:" />

                                                <TextBox
                                                    x:Name="CameraCountTextBox"
                                                    Width="150"
                                                    Height="28"
                                                    Margin="0,0,15,0"
                                                    Padding="3"
                                                    VerticalAlignment="Center"
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                    materialDesign:TextFieldAssist.LeadingIcon="Cctv"
                                                    IsEnabled="True"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Text="1" />

                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="80"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="存储天数:" />

                                                <TextBox
                                                    x:Name="SaveDayTextBox"
                                                    Width="150"
                                                    Height="28"
                                                    Margin="0,0,15,0"
                                                    Padding="3"
                                                    VerticalAlignment="Center"
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                    materialDesign:TextFieldAssist.LeadingIcon="TimeOfDay"
                                                    IsEnabled="True"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Text="30" />

                                            </StackPanel>
                                            <Button
                                                x:Name="AddButton"
                                                Width="120"
                                                Height="28"
                                                Margin="10,0,0,0"
                                                Click="AddButton_OnClick"
                                                Content="添加"
                                                Style="{StaticResource MaterialDesignOutlinedLightButton}" />
                                            <Button
                                                x:Name="HelpButton"
                                                Margin="10,0"
                                                Click="HelpButton_OnClick"
                                                Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="InformationVariantCircleOutline" />
                                            </Button>
                                        </StackPanel>

                                        <DataGrid
                                            x:Name="CameraDataGrid"
                                            Grid.Row="1"
                                            Height="150"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            SelectionMode="Extended"
                                            SelectionUnit="FullRow">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="CodingType">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="MovieOpenCogOutline" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="编码类型" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding CodingType}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="Resolution">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Cctv" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="摄像头分辨率" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding Resolution}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="CameraNumber">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Cctv" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="摄像头数量" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding CameraNumber}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="SaveDay">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="TimeOfDay" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="存储天数" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding SaveDay}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="StorageSpace">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Hdd" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="所需硬盘空间(GB)" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding StorageSpace}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="140" CanUserSort="False">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Delete" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="删除" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Button
                                                                    x:Name="DeleteButton"
                                                                    Width="100"
                                                                    Click="DeleteButton_OnClick"
                                                                    Content="删除"
                                                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Grid.Row="2">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Width="150"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="所需磁盘总大小(GB):" />

                                                    <TextBox
                                                        x:Name="DiskSpaceCountGB"
                                                        Width="150"
                                                        Height="28"
                                                        Margin="0,0,15,0"
                                                        Padding="3"
                                                        VerticalAlignment="Center"
                                                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                        materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                                        IsEnabled="False"
                                                        Style="{StaticResource MaterialDesignTextBox}" />

                                                </StackPanel>

                                                <StackPanel
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Width="150"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="所需磁盘总大小(TB):" />

                                                    <TextBox
                                                        x:Name="DiskSpaceCountTB"
                                                        Width="150"
                                                        Height="28"
                                                        Margin="0,0,15,0"
                                                        Padding="3"
                                                        VerticalAlignment="Center"
                                                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                        materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                                        IsEnabled="False"
                                                        Style="{StaticResource MaterialDesignTextBox}" />

                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                    </Grid>
                                </TabItem>
                                <TabItem Header="按码率计算">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="10"
                                            Orientation="Horizontal">

                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="视频流码率:" />
                                                <ComboBox
                                                    x:Name="BitRateComboBox"
                                                    Width="150"
                                                    Height="32"
                                                    Margin="0,0,15,0"
                                                    Padding="0"
                                                    MaxDropDownHeight="200"
                                                    SelectedIndex="2"
                                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="摄像头数量:" />

                                                <TextBox
                                                    x:Name="CameraCountTextBox2"
                                                    Width="150"
                                                    Height="28"
                                                    Margin="0,0,15,0"
                                                    Padding="3"
                                                    VerticalAlignment="Center"
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                    materialDesign:TextFieldAssist.LeadingIcon="Cctv"
                                                    IsEnabled="True"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Text="1" />

                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Label
                                                    Width="85"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="存储天数:" />

                                                <TextBox
                                                    x:Name="SaveDayTextBox2"
                                                    Width="150"
                                                    Height="28"
                                                    Margin="0,0,15,0"
                                                    Padding="3"
                                                    VerticalAlignment="Center"
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                    materialDesign:TextFieldAssist.LeadingIcon="TimeOfDay"
                                                    IsEnabled="True"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Text="30" />

                                            </StackPanel>
                                            <Button
                                                x:Name="AddButton2"
                                                Width="120"
                                                Height="28"
                                                Margin="10,0,0,0"
                                                Click="AddButton2_OnClick"
                                                Content="添加"
                                                Style="{StaticResource MaterialDesignOutlinedLightButton}" />
                                            <Button Margin="10,0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="InformationVariantCircleOutline" />
                                            </Button>
                                        </StackPanel>

                                        <DataGrid
                                            x:Name="CameraDataGrid2"
                                            Grid.Row="1"
                                            Height="150"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            SelectionMode="Extended"
                                            SelectionUnit="FullRow">
                                            <DataGrid.Columns>

                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="BitRate">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Cctv" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="视频流码率" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding BitRate}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="CameraNumber">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Cctv" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="摄像头数量" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding CameraNumber}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="SaveDay">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="TimeOfDay" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="存储天数" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding SaveDay}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn
                                                    Width="200"
                                                    CanUserSort="False"
                                                    SortMemberPath="StorageSpace">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Hdd" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="所需硬盘空间(GB)" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="AliceBlue"
                                                                    Text="{Binding StorageSpace}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="140" CanUserSort="False">
                                                    <DataGridTemplateColumn.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="24"
                                                                Height="24"
                                                                Kind="Delete" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Text="删除" />
                                                        </StackPanel>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Button
                                                                    x:Name="DeleteButton2"
                                                                    Width="100"
                                                                    Click="DeleteButton2_OnClick"
                                                                    Content="删除"
                                                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Grid.Row="2">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Width="150"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="所需磁盘总大小(GB):" />

                                                    <TextBox
                                                        x:Name="DiskSpaceCountGB2"
                                                        Width="150"
                                                        Height="28"
                                                        Margin="0,0,15,0"
                                                        Padding="3"
                                                        VerticalAlignment="Center"
                                                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                        materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                                        IsEnabled="False"
                                                        Style="{StaticResource MaterialDesignTextBox}" />

                                                </StackPanel>

                                                <StackPanel
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Width="150"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="所需磁盘总大小(TB):" />

                                                    <TextBox
                                                        x:Name="DiskSpaceCountTB2"
                                                        Width="150"
                                                        Height="28"
                                                        Margin="0,0,15,0"
                                                        Padding="3"
                                                        VerticalAlignment="Center"
                                                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                        materialDesign:TextFieldAssist.LeadingIcon="Hdd"
                                                        IsEnabled="False"
                                                        Style="{StaticResource MaterialDesignTextBox}" />

                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </materialDesign:Card>



                    </StackPanel>
                </Grid>

            </materialDesign:Card>


            <materialDesign:Card
                Grid.Row="2"
                Margin="5,2.5,5,5"
                Background="#404040"
                Visibility="Collapsed">


                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="10,20,10,10"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Kind="Hexadecimal" />

                        <TextBlock
                            Margin="10"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="按所需IP数量计算最小网段掩码地址" />

                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical">

                        <StackPanel Margin="10" Orientation="Horizontal">

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="需要地址的数量：" />
                                <TextBox
                                    x:Name="NeedNumBox"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="子网掩码位数:" />
                                <TextBox
                                    x:Name="MaskLengthBox"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="子网掩码:" />
                                <TextBox
                                    x:Name="MaskBox"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="LastPass"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="10" Orientation="Horizontal">

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="网段可用地址数:" />
                                <TextBox
                                    x:Name="AvailableNumBox"
                                    Width="250"
                                    Height="28"
                                    Margin="0,0,30,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                    IsEnabled="False"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Grid>


            </materialDesign:Card>


            <materialDesign:Snackbar
                x:Name="Snackbar"
                Grid.Row="0"
                Grid.RowSpan="3"
                d:Visibility="Collapsed"
                MessageQueue="{materialDesign:MessageQueue}" />
            <materialDesign:DialogHost
                Grid.Row="0"
                Grid.RowSpan="3"
                d:Visibility="Collapsed"
                Identifier="MessageDialogHost">
                <!--  DialogHost的内容  -->
            </materialDesign:DialogHost>
        </Grid>
    </ScrollViewer>
</Window>
