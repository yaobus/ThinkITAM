<Window
    x:Class="ThinkITAM.Windows.PortPanel.PanelPortTagModify"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.PortPanel"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="标签设置"
    Width="500"
    Height="250"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PanelPortTagModify_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="20"
            Text="目标端口:" />

        <TextBlock
            x:Name="TitleTextBlock"
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="20"
            Text="设定标签:" />

        <materialDesign:ColorZone
            Grid.Row="1"
            Grid.Column="1"
            Height="50"
            Margin="2.5,5,15,2.5"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="#404040"
            CornerRadius="5"
            Mode="Standard">

            <TextBox
                x:Name="TagTextBox"
                Width="340"
                Height="50"
                Margin="5,0"
                Padding="0"
                d:Text="TAG-ABCD"
                BorderThickness="0"
                FontSize="16"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        </materialDesign:ColorZone>
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Width="340">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Button
                x:Name="CancelButton"
                Grid.Column="0"
                Width="100"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Click="CancelButton_OnClick"
                Content="取消"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />

            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                Width="100"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
        </Grid>

    </Grid>
</Window>
