<Window
    x:Class="ThinkITAM.Windows.Bookmark.GroupOrderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:local="clr-namespace:ThinkITAM.Windows.Bookmark"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="拖动分组以重新排序"
    Width="300"
    Height="300"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="GroupOrderWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid
            x:Name="GroupsListView"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,0,10"
            d:Visibility="Collapsed"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserAddRows="False"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            Visibility="Visible">
            <DataGrid.Columns>



                <DataGridTemplateColumn
                    Width="100"
                    CanUserSort="True"
                    SortMemberPath="DisplayOrder"
                    Visibility="Collapsed">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="IpOutline" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="排序" />
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="ExtraBold"
                                    Text="{Binding DisplayOrder}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>



                <DataGridTemplateColumn
                    Width="150"
                    CanUserSort="True"
                    SortMemberPath="GroupName">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="BallotOutline" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="分组名称" />
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding TypeGroup}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>



            </DataGrid.Columns>
        </DataGrid>


        <Grid Grid.Row="1">


            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="10"
                HorizontalAlignment="Right"
                BorderThickness="0"
                Click="SaveButton_OnClick"
                Content="保存" />
        </Grid>
    </Grid>
</Window>
