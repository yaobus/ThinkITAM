<Window
    x:Class="ThinkITAM.Windows.Bookmark.AddGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.Bookmark"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加分组"
    Width="300"
    Height="200"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">0,16</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="设定分组名称:" />


                <TextBox
                    x:Name="TypeGroup"
                    Width="230"
                    Height="28"
                    Padding="2,0,0,0"
                    HorizontalAlignment="Left"
                    d:Text="TAG-ABCD"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Button
                x:Name="CancelButton"
                Grid.Column="0"
                Width="100"
                Margin="10"
                HorizontalAlignment="Stretch"
                Click="CancelButton_OnClick"
                Content="取消"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />

            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                Width="100"
                Margin="10"
                HorizontalAlignment="Stretch"
                Click="SaveButton_OnClick"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
        </Grid>

    </Grid>
</Window>
