<Window
    x:Class="ThinkITAM.Windows.AboutWindow.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.AboutWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="我要反馈"
    Width="800"
    Height="450"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    ResizeMode="NoResize"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <StackPanel VerticalAlignment="Center" Orientation="Vertical">

        <Image
            Margin="10"
            Source="/Resources/Image/QR.png"
            Stretch="None" />
        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            Opacity="0.5"
            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
            Text="进入QQ群反馈（请备注ThinkITAM）" />
    </StackPanel>
</Window>
