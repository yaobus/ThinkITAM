<Window
    x:Class="ThinkITAM.Windows.AboutWindow.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.AboutWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DonatePage"
    Width="800"
    Height="450"
    ResizeMode="NoResize"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <Image
                Margin="10"
                Source="/Resources/Image/WeChat.png"
                Stretch="None" />
        </StackPanel>



        <Image
            Grid.Column="1"
            Margin="10"
            Source="/Resources/Image/AliPay.png"
            Stretch="None" />
    </Grid>
</Window>
