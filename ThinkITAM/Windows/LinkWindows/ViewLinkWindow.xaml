<Window x:Class="ThinkITAM.Windows.LinkWindows.ViewLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
        xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource HarmonyOsFontFamily}"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        MaxHeight="200"
        MaxWidth="1000"
        SizeToContent="WidthAndHeight"
        >
    <Grid>
        <ListBox
            x:Name="ViewNodePanel"
            Grid.Column="0"
            BorderThickness="1"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <linkPage:NodePort Margin="5,0" />
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </Grid>
</Window>
