<Window
    x:Class="ThinkITAM.Windows.LinkWindows.TestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TestWindow"
    Width="1280"
    Height="720"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="TestWindow_OnLoaded"
    MouseWheel="Panel_OnMouseWheel"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <StackPanel
            x:Name="Panel"
            Grid.Row="0"
            Orientation="Vertical">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
            </StackPanel.LayoutTransform>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Height="60"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBox
                x:Name="SlotNumBox"
                Width="100"
                Height="32"
                Margin="10,0"
                Padding="0"
                Background="CadetBlue"
                Style="{StaticResource MaterialDesignOutlinedTextBox}">
                4
            </TextBox>

            <ComboBox
                x:Name="ColorBox"
                Width="100"
                SelectedIndex="0">
                <ComboBoxItem Background="AliceBlue" />
                <ComboBoxItem Background="DarkCyan" />
                <ComboBoxItem Background="OrangeRed" />
                <ComboBoxItem Background="YellowGreen" />
                <ComboBoxItem Background="MediumVioletRed" />
            </ComboBox>

            <TextBox
                x:Name="NumBox"
                Width="100"
                Height="32"
                Margin="10,0"
                Padding="0"
                Background="CadetBlue"
                Style="{StaticResource MaterialDesignOutlinedTextBox}">
                24
            </TextBox>
            <TextBox
                x:Name="TypeBox"
                Width="100"
                Height="32"
                Margin="10,0"
                Padding="0"
                Background="CadetBlue"
                Style="{StaticResource MaterialDesignOutlinedTextBox}">
                SC
            </TextBox>
            <Button
                x:Name="AddButton"
                Width="120"
                Margin="10"
                Click="AddButton_OnClick"
                Content="ADD" />

        </StackPanel>

    </Grid>
</Window>
