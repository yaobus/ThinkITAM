<Window
    x:Class="ThinkITAM.Windows.LinkWindows.TagModifyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="标签设置"
    Width="400"
    Height="250"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="TagModifyWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    Margin="0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="目标端口:" />

                <TextBlock
                    x:Name="TitleTextBlock"
                    Width="300"
                    Height="32"
                    Padding="6,8,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:Text="ABCD" />

            </StackPanel>
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="设定标签:" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="TagTextBox"
                        Grid.Column="0"
                        Width="300"
                        Height="32"
                        Padding="6,0,0,0"
                        d:Text="ABCD"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <Button
                        x:Name="ClearInput"
                        Grid.Column="1"
                        Width="45"
                        Padding="0"
                        HorizontalAlignment="Right"
                        BorderThickness="1"
                        Click="ClearInput_OnClick"
                        Style="{StaticResource MaterialDesignOutlinedLightButton}"
                        ToolTip="清空输入框内容"
                        Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="DeleteOutline" />
                    </Button>

                </Grid>


            </StackPanel>

        </StackPanel>



        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Button
                x:Name="CancelButton"
                Grid.Column="0"
                Width="100"
                Margin="10"
                HorizontalAlignment="Stretch"
                Click="CancelButton_OnClick"
                Content="取消"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />

            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                Width="100"
                Margin="10"
                HorizontalAlignment="Stretch"
                Click="SaveButton_OnClick"
                Content="保存"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
        </Grid>

    </Grid>

</Window>
