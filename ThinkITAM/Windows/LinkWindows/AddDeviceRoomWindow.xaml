<Window
    x:Class="ThinkITAM.Windows.LinkWindows.AddDeviceRoomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产类型及编号预设"
    Width="400"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddDeviceRoomWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="5,0"
                VerticalAlignment="Center"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加配线间/机房" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="机房名称:" />

                <TextBox
                    x:Name="DeviceRoom"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="House"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">

                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="所在位置:" />

                <ComboBox
                    x:Name="AddressCombobox"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                    IsEditable="True"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="责任人:" />

                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Orientation="Horizontal">

                    <TextBox
                        x:Name="PeopleName"
                        Width="145"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Account"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                    <ComboBox
                        x:Name="PeopleCombobox"
                        Width="145"
                        Height="28"
                        Margin="5,0"
                        Padding="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="选择预设人员"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="People"
                        IsEditable="True"
                        MaxDropDownHeight="300"
                        SelectionChanged="PeopleCombobox_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />




                </StackPanel>

            </StackPanel>
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    Grid.Row="4"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="联系电话:" />
                <TextBox
                    x:Name="Phone"
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Phone"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    Grid.Row="5"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="备注信息:" />
                <TextBox
                    x:Name="Note"
                    Grid.Row="5"
                    Grid.Column="1"
                    Width="300"
                    Height="28"
                    Margin="0,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


        </StackPanel>



        <Button
            x:Name="SaveButton"
            Grid.Row="2"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            BorderThickness="0"
            Click="SaveButton_OnClick"
            Content="保存" />

    </Grid>
</Window>
