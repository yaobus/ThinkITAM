<Window
    x:Class="ThinkITAM.Windows.LinkWindows.AddDeviceRoomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加资产类型及编号预设"
    Width="500"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddDeviceRoomWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="5,0"
                VerticalAlignment="Center"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加配线间/机房" />

        </StackPanel>

        <Label
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="机房名称:" />

        <TextBox
            x:Name="DeviceRoom"
            Grid.Row="1"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="House"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />


        <Label
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="所在位置:" />

        <ComboBox
            x:Name="AddressCombobox"
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
            IsEditable="True"
            MaxDropDownHeight="300"
            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

        <Label
            Grid.Row="3"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="责任人:" />

        <StackPanel
            Grid.Row="3"
            Grid.Column="1"
            Orientation="Horizontal">

            <TextBox
                x:Name="PeopleName"
                Width="145"
                Height="28"
                Margin="10,0,5,0"
                Padding="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Account"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <ComboBox
                x:Name="PeopleCombobox"
                Width="145"
                Height="28"
                Margin="5,0"
                Padding="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="选择预设人员"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="People"
                IsEditable="True"
                MaxDropDownHeight="300"
                SelectionChanged="PeopleCombobox_OnSelectionChanged"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />




        </StackPanel>



        <Label
            Grid.Row="4"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="联系电话:" />
        <TextBox
            x:Name="Phone"
            Grid.Row="4"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="Phone"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <Label
            Grid.Row="5"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="备注信息:" />
        <TextBox
            x:Name="Note"
            Grid.Row="5"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <Button
            x:Name="SaveButton"
            Grid.Row="6"
            Grid.Column="1"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            Click="SaveButton_OnClick"
            Content="保存" />

    </Grid>
</Window>
