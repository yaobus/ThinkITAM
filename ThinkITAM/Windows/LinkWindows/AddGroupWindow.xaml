<Window
    x:Class="ThinkITAM.Windows.LinkWindows.AddGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加机柜(或分组)"
    Width="400"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddGroupWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="5,0"
                VerticalAlignment="Center"
                Kind="ViewCarouselOutline" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加机柜/自定义分组" />

        </StackPanel>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel
                Grid.Row="1"
                Margin="{StaticResource DefaultMargin}"
                Orientation="Vertical">

                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="所在机房:" />

                <ComboBox
                    x:Name="RoomCombobox"
                    Width="300"
                    Height="28"
                    Margin="0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                    DisplayMemberPath="Name"
                    MaxDropDownHeight="300"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                Orientation="Vertical">

                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="机柜/分组名称:" />
                <TextBox
                    x:Name="GroupNameTextBox"
                    Width="300"
                    Height="28"
                    Margin="0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="ViewCarouselOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Name}" />
            </StackPanel>

            <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="位置信息:" />


                <TextBox
                    x:Name="Position"
                    Width="300"
                    Height="28"
                    Margin="0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Position}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Margin="{StaticResource DefaultMargin}"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="备注信息:" />

                <TextBox
                    x:Name="Note"
                    Width="300"
                    Height="28"
                    Margin="0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Layers"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Note}" />
            </StackPanel>
        </StackPanel>
        <Button
            x:Name="SaveButton"
            Grid.Row="2"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            BorderThickness="0"
            Click="SaveButton_OnClick"
            Content="保存" />

    </Grid>

</Window>
