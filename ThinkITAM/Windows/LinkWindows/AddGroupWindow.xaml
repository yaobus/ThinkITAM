<Window
    x:Class="ThinkITAM.Windows.LinkWindows.AddGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加机柜(或分组)"
    Width="500"
    Height="350"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddGroupWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="5,0"
                VerticalAlignment="Center"
                Kind="ViewCarouselOutline" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="添加机柜/自定义分组" />

        </StackPanel>



        <Label
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="所在机房:" />

        <ComboBox
            x:Name="RoomCombobox"
            Grid.Row="1"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
            DisplayMemberPath="Name"
            MaxDropDownHeight="300"
            Style="{StaticResource MaterialDesignOutlinedComboBox}" />



        <Label
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="机柜/分组名称:" />
        <TextBox
            x:Name="GroupNameTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="Phone"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <Label
            Grid.Row="3"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="位置信息:" />


        <TextBox
            x:Name="Note"
            Grid.Row="4"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <Label
            Grid.Row="4"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="备注信息:" />

        <TextBox
            x:Name="Position"
            Grid.Row="3"
            Grid.Column="1"
            Width="300"
            Height="28"
            Margin="10,0"
            Padding="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            materialDesign:TextFieldAssist.HasLeadingIcon="True"
            materialDesign:TextFieldAssist.LeadingIcon="Layers"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />


        <Button
            x:Name="SaveButton"
            Grid.Row="5"
            Grid.Column="1"
            Width="150"
            Margin="10"
            HorizontalAlignment="Right"
            BorderThickness="0"
            Click="SaveButton_OnClick"
            Content="保存" />

    </Grid>

</Window>
