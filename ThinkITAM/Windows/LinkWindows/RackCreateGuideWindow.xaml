<Window
    x:Class="ThinkITAM.Windows.LinkWindows.RackCreateGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.LinkWindows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="机架式配线架设计器"
    Width="900"
    Height="650"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="RackCreateGuideWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,5,2.5,5"
            HorizontalAlignment="Stretch">

            <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">

                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="所在机房:" />

                        <ComboBox
                            x:Name="RoomCombobox"
                            Width="230"
                            Height="40"
                            Padding="0"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Name"
                            MaxDropDownHeight="300"
                            SelectionChanged="RoomCombobox_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ToolTip="选择设备所在机房" />


                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="所在机柜:" />
                        <ComboBox
                            x:Name="CabinetCombobox"
                            Width="230"
                            Height="40"
                            Padding="0"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Name"
                            IsEnabled="False"
                            MaxDropDownHeight="300"
                            SelectionChanged="CabinetCombobox_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ToolTip="选择设备所在机柜" />


                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">

                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="机架名称:" />
                        <TextBox
                            x:Name="RackName"
                            Width="230"
                            Height="40"
                            Margin="0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="InfoBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            ToolTip="设置机架名称" />
                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="槽位类型:" />


                        <ComboBox
                            x:Name="PortTypeCombobox"
                            Width="230"
                            Height="40"
                            Padding="0"
                            HorizontalAlignment="Left"
                            SelectionChanged="PortTypeCombobox_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ToolTip="选择端口的类型">
                            <ComboBoxItem Content="Eth" />
                            <ComboBoxItem Content="SC" />
                            <ComboBoxItem Content="FC" />
                            <ComboBoxItem Content="LC" />
                            <ComboBoxItem Content="Empty" />


                        </ComboBox>

                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="槽位数量:" />



                        <Slider
                            x:Name="SlotNumSlider"
                            Width="230"
                            Height="40"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Maximum="12"
                            Minimum="1"
                            Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                            TickFrequency="1"
                            TickPlacement="Both"
                            ValueChanged="SlotNumSlider_OnValueChanged"
                            Value="1" />
                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="槽位选择:" />


                        <ComboBox
                            x:Name="SlotCombobox"
                            Width="230"
                            Height="40"
                            Padding="0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            SelectionChanged="SlotCombobox_OnSelectionChanged"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ToolTip="选择需要配置的槽位" />
                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="端口数量:" />


                        <Slider
                            x:Name="PortNumSlider"
                            Width="230"
                            Height="40"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Maximum="24"
                            Minimum="1"
                            Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                            TickFrequency="1"
                            TickPlacement="Both"
                            Value="12" />

                    </StackPanel>

                    <StackPanel Margin="{StaticResource DefaultMargin}" Orientation="Vertical">


                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="槽位标签:" />


                        <TextBox
                            x:Name="SlotName"
                            Width="230"
                            Height="40"
                            Margin="0"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="InfoBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="Slot-"
                            ToolTip="槽位名称" />

                    </StackPanel>
                </StackPanel>




                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="SaveRack"
                        Grid.Column="0"
                        Height="32"
                        Margin="10,0,0,10"
                        HorizontalAlignment="Stretch"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderThickness="0"
                        Click="SaveRack_OnClick"
                        Content="保存设备" />

                    <Button
                        x:Name="AddSlotButton"
                        Grid.Column="1"
                        Height="32"
                        Margin="10,0,10,10"
                        HorizontalAlignment="Stretch"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderThickness="0"
                        Click="AddSlotButton_OnClick"
                        Content="添加到配置单" />


                </Grid>



            </Grid>

        </materialDesign:Card>


        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="1"
            Margin="2.5,5,2.5,5"
            HorizontalAlignment="Stretch">

            <DataGrid
                x:Name="SlotDataGrid"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn>
                        <DataGridTextColumn.Header>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,5,0" Kind="Numeric1Box" />
                                <TextBlock Text="槽位号" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="SlotIndex" />
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn>
                        <DataGridTextColumn.Header>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,5,0" Kind="Numeric1Box" />
                                <TextBlock Text="端口类型" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="SlotType" />


                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn>
                        <DataGridTextColumn.Header>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,5,0" Kind="Numeric1Box" />
                                <TextBlock Text="槽位标签" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="SlotName" />


                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn>
                        <DataGridTextColumn.Header>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,5,0" Kind="Numeric1Box" />
                                <TextBlock Text="端口数" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="PortCount" />


                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>


                </DataGrid.Columns>

            </DataGrid>

        </materialDesign:Card>


    </Grid>
</Window>
