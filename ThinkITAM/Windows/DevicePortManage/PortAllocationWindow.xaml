<Window
    x:Class="ThinkITAM.Windows.DevicePortManage.PortAllocationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devicePortManage="clr-namespace:ThinkITAM.UserControls.DevicePortManage"
    xmlns:local="clr-namespace:ThinkITAM.Windows.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="端口分配"
    Width="880"
    Height="680"
    d:Background="#383838"
    d:Foreground="AliceBlue"
    Closed="PortAllocationWindow_OnClosed"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PortAllocationWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">


    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>

                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="Collapsed">



                <Button
                    x:Name="StatusPing"
                    Width="24"
                    Height="24"
                    Margin="15,0,15,0"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                    materialDesign:ButtonProgressAssist.Value="-1"
                    Content="{materialDesign:PackIcon Radar}"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                    ToolTip="尝试获取主机名和MAC地址" />



                <Button
                    x:Name="CopyHostInfo"
                    Width="32"
                    Height="32"
                    Margin="15,0,15,0"
                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="提取获取到的主机名和MAC地址">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="EyedropperRemove" />
                </Button>




            </StackPanel>


            <TextBox
                x:Name="DeviceName"
                Grid.Row="1"
                Grid.Column="0"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前设备名称"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Note"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />



            <TextBox
                x:Name="DeviceNumber"
                Grid.Row="1"
                Grid.Column="1"
                Width="200"
                Margin="5,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="当前设备编号"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="IpNetworkOutline"
                IsEnabled="False"
                Opacity="0.5"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <TextBox
                    x:Name="Model"
                    Grid.Column="0"
                    Width="200"
                    Padding="5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="当前设备型号"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Lastpass"
                    IsEnabled="False"
                    Opacity="0.5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal" />

            </Grid>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontWeight="ExtraBold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="所选端口: " />
                <TextBlock
                    x:Name="SelectedPort"
                    d:Text="G 0/0/1"
                    FontWeight="ExtraBold"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}" />

            </StackPanel>


        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="端口模式:" />
                    <ComboBox
                        x:Name="PortMode"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEditable="False"
                        MaxDropDownHeight="300"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Text="{Binding Mode, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelA"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段A:"
                        ToolTip="自定义字段A" />
                    <TextBox
                        x:Name="TagA"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagA, Mode=TwoWay}" />
                </StackPanel>



            </Grid>
            <Grid Grid.Row="1" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="端口状态:" />
                    <ComboBox
                        x:Name="PortStatus"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        IsEditable="True"
                        SelectedIndex="{Binding Status, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>



                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段B:"
                        ToolTip="自定义字段B" />
                    <TextBox
                        x:Name="TagB"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagB, Mode=TwoWay}" />
                </StackPanel>



            </Grid>

            <Grid Grid.Row="2" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="IdLabel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="VlanId:"
                        ToolTip="自定义字段A" />
                    <TextBox
                        x:Name="VlanId"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding VlanId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelC"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段C:"
                        ToolTip="自定义字段C" />
                    <TextBox
                        x:Name="TagC"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagC, Mode=TwoWay}" />
                </StackPanel>

            </Grid>
            <Grid Grid.Row="3" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="端口备注:" />
                    <TextBox
                        x:Name="PortName"
                        Width="250"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Laptop"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding PortName, Mode=TwoWay}" />
                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelD"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段D:"
                        ToolTip="自定义字段D" />
                    <TextBox
                        x:Name="TagD"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagD, Mode=TwoWay}" />
                </StackPanel>



            </Grid>
            <Grid
                Grid.Row="4"
                Margin="30,0"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="颜色标签:"
                        ToolTip="自定义端口颜色标签" />

                    <ListBox
                        x:Name="PortColor"
                        Width="250"
                        Height="30"
                        Margin="0,0,10,0"
                        SelectedIndex="{Binding AddressColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="PortColor_OnSelectionChanged"
                        Style="{StaticResource MaterialDesignToolToggleListBox}">
                        <ListBoxItem
                            Width="26"
                            Margin="0,0,1,0"
                            Padding="0"
                            Background="Transparent"
                            Opacity="0.1"
                            ToolTip="选择此项将不显示标签">
                            <Grid HorizontalAlignment="Center">

                                <TextBlock
                                    Margin="2,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Text="Null" />

                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#FF0080"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#F15A24"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#FBC02D"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#64DD17"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#00A8FF"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#008080"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0"
                            Background="#362391"
                            Opacity="0.1" />
                        <ListBoxItem
                            Width="26"
                            Margin="1,0,0,0"
                            Background="#212121"
                            Opacity="0.1" />

                    </ListBox>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelE"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段E:"
                        ToolTip="自定义字段E" />
                    <TextBox
                        x:Name="TagE"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagE, Mode=TwoWay}" />
                </StackPanel>



            </Grid>
            <Grid Grid.Row="5" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="关联设备:"
                        ToolTip="改端口连接的设备:" />

                    <TextBox
                        x:Name="DeviceLink"
                        Width="195"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding DeviceLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        x:Name="FindAsset"
                        Width="50"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        Click="FindAsset_OnClick">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Magnify" />
                        </StackPanel>

                    </Button>


                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        x:Name="LabelF"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="自定义字段F:"
                        ToolTip="自定义字段F" />
                    <TextBox
                        x:Name="TagF"
                        Width="250"
                        Height="28"
                        Margin="0,0,30,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding TagF, Mode=TwoWay}" />
                </StackPanel>




            </Grid>
            <Grid Grid.Row="6" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="关联链路:"
                        ToolTip="改端口连接的设备:" />

                    <TextBox
                        x:Name="LineLink"
                        Width="195"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Note"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding LineLink, Mode=TwoWay}" />

                    <Button
                        x:Name="FindLine"
                        Width="50"
                        Height="28"
                        Margin="0,0,10,0"
                        Padding="0"
                        Click="FindLine_OnClick"
                        IsEnabled="True">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Magnify" />
                        </StackPanel>

                    </Button>


                </StackPanel>




            </Grid>




            <Grid Grid.Row="7" Margin="30,0">

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button
                        x:Name="ClearButton"
                        Width="150"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Right"
                        d:Visibility="Visible"
                        Content="清空配置"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="SaveButton"
                        Width="150"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Right"
                        Click="SaveButton_OnClick"
                        Content="保存配置" />
                </StackPanel>
            </Grid>
        </Grid>




    </Grid>
</Window>
