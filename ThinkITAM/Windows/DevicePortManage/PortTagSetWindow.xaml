<Window
    x:Class="ThinkITAM.Windows.DevicePortManage.PortTagSetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="端口标签-自定义字段"
    Width="600"
    Height="380"
    d:Background="#383838"
    d:Foreground="AliceBlue"
    Closing="PortTagSetWindow_OnClosing"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PortTagSetWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="30"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Kind="ApplicationVariableOutline" />

            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="{DynamicResource PawCustomTitle}" />

        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <RadioButton
                x:Name="GlobalRadioButton"
                VerticalAlignment="Center"
                Click="GlobalRadioButton_OnClick"
                Content="{DynamicResource PawGlobalTag}"
                IsChecked="False"
                Style="{StaticResource MaterialDesignSecondaryRadioButton}"
                ToolTip="{DynamicResource PawGlobalTagTooltip}" />

            <RadioButton
                x:Name="LocalRadioButton"
                VerticalAlignment="Center"
                Click="LocalRadioButton_OnClick"
                Content="{DynamicResource PawOnlyTag}"
                IsChecked="False"
                Style="{StaticResource MaterialDesignSecondaryRadioButton}"
                ToolTip="{DynamicResource PawOnlyTagTooltip}" />


            <Button
                x:Name="ResetButton"
                HorizontalAlignment="Right"
                Click="ResetButton_OnClick"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="{DynamicResource DcgCustomTagReset}">
                <materialDesign:PackIcon Kind="BackupRestore" />
            </Button>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center">
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagA}" />
                <TextBox
                    x:Name="TagA"
                    Width="240"
                    Height="28"
                    Margin="10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagB}" />
                <TextBox
                    x:Name="TagB"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagC}" />
                <TextBox
                    x:Name="TagC"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>





        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center">

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagD}" />
                <TextBox
                    x:Name="TagD"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagE}" />
                <TextBox
                    x:Name="TagE"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>

            <StackPanel Margin="10,5" Orientation="Vertical">
                <Label
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource NmpDgTagF}" />
                <TextBox
                    x:Name="TagF"
                    Width="240"
                    Height="28"
                    Margin="10,0,10,0"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>


        </StackPanel>



        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="10,0">


            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="10"
                HorizontalAlignment="Right"
                Click="SaveButton_OnClick"
                Content="{DynamicResource ApwSave}"
                Style="{StaticResource MaterialDesignRaisedDarkButton}" />
        </Grid>
    </Grid>
</Window>
