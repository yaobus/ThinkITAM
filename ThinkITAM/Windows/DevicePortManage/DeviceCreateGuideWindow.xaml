<Window
    x:Class="ThinkITAM.Windows.DevicePortManage.DeviceCreateGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设备设计器"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="DeviceCreateGuideWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Thickness x:Key="DefaultMargin">0,12</Thickness>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="220" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>



        <Grid Grid.Row="0">


            <materialDesign:ColorZone
                Grid.ColumnSpan="2"
                Padding="16,5"
                Mode="PrimaryDark">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>



                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="*资产类型:" />
                            <TextBox
                                x:Name="AssetType"
                                Width="165"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding AssetType}" />
                            <Button
                                x:Name="FindAsset"
                                Width="60"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                Click="FindAsset_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="查找资产">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Magnify" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="*设备类型:" />
                            <TextBox
                                x:Name="DeviceType"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding DeviceType}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="*资产编号:" />
                            <TextBox
                                x:Name="AssetNumber"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding AssetNumber}" />

                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="*规格型号:" />
                            <TextBox
                                x:Name="Model"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Ticket"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Model}" />



                        </StackPanel>


                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="*设备名称:" />
                            <TextBox
                                x:Name="Description"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="InfoBox"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="责任人:" />

                            <TextBox
                                x:Name="User"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="User"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding User}" />
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="责任人电话:" />
                            <TextBox
                                x:Name="UserPhone"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UserPhone}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="启用日期:" />
                            <DatePicker
                                x:Name="EnableDate"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                Language="zh-cn"
                                MouseDoubleClick="EnableDate_OnMouseDoubleClick"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        </StackPanel>


                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="使用单位:" />
                            <TextBox
                                x:Name="UseDepartment"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Company"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="设备安装位置:" />
                            <TextBox
                                x:Name="Address"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelA"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签A:" />
                            <TextBox
                                x:Name="TagA"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelB"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签B:" />
                            <TextBox
                                x:Name="TagB"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>



                    </StackPanel>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelC"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签C:" />
                            <TextBox
                                x:Name="TagC"
                                Width="230"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <Button
                                x:Name="SetButton"
                                Width="32"
                                Height="28"
                                Margin="0,0,-32,0"
                                Padding="0"
                                Click="SetButton_OnClick"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="自定义标签">
                                <materialDesign:PackIcon Kind="Settings" />
                            </Button>
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelD"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签D:" />
                            <TextBox
                                x:Name="TagD"
                                Width="230"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelE"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签E:" />
                            <TextBox
                                x:Name="TagE"
                                Width="230"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                x:Name="LabelF"
                                MaxWidth="90"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="自定义标签F:" />
                            <TextBox
                                x:Name="TagF"
                                Width="230"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TagHeart"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>







                    </StackPanel>


                </Grid>






            </materialDesign:ColorZone>

        </Grid>

        <materialDesign:Snackbar
            Grid.Row="1"
            Margin="0,0,0,10"
            MessageQueue="{Binding MessageQueue}" />


        <Grid Grid.Row="1">

            <materialDesign:ColorZone
                Grid.ColumnSpan="2"
                Padding="16"
                Background="Transparent"
                Mode="PrimaryDark">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>




                    <StackPanel Grid.Column="0" VerticalAlignment="Top">


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="预设模板:" />
                            <ComboBox
                                x:Name="PresetList"
                                Width="165"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="0"
                                IsEnabled="False"
                                MaxDropDownHeight="300"
                                SelectionChanged="PresetList_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            <Button
                                x:Name="LoadPreset"
                                Width="60"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                Click="LoadPreset_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="查找该型号是否存在预设端口方案">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Magnify" />
                                </StackPanel>
                            </Button>
                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="端口类型:" />
                            <ComboBox
                                x:Name="PortType"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                MaxDropDownHeight="300"
                                SelectedIndex="0"
                                SelectionChanged="PortType_OnSelectionChanged"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="以太网口" />
                                <ComboBoxItem Content="光纤网口" />
                                <ComboBoxItem Content="管理网口" />
                                <ComboBoxItem Content="硬盘插槽" />
                            </ComboBox>

                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="槽位编号:" />
                            <ComboBox
                                x:Name="SlotNumber"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                MaxDropDownHeight="200"
                                SelectedIndex="0"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="9" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="11" />
                                <ComboBoxItem Content="" />

                            </ComboBox>

                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="端口标签:" />
                            <ComboBox
                                x:Name="PortTag"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                IsEditable="True"
                                MaxDropDownHeight="200"
                                SelectedIndex="2"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="端口编号:" />
                            <ComboBox
                                x:Name="PortPrefix"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                IsEditable="True"
                                MaxDropDownHeight="300"
                                SelectedIndex="0"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        </StackPanel>


                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="编号范围:" />
                            <TextBox
                                x:Name="FirstNumber"
                                Width="60"
                                Height="28"
                                Margin="0,0,5,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="FirstPage"
                                KeyDown="FirstNumber_OnKeyDown"
                                LostFocus="FirstNumber_OnLostFocus"
                                PreviewTextInput="FirstNumber_OnPreviewTextInput"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="0" />
                            <TextBlock
                                Width="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="---" />
                            <TextBox
                                x:Name="LastNumber"
                                Width="60"
                                Height="28"
                                Margin="5,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="LastPage"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <TextBlock
                                Width="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="Σ" />
                            <TextBox
                                x:Name="PortCount"
                                Width="60"
                                Height="28"
                                Margin="5,0,10,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="端口数量:" />
                            <Slider
                                x:Name="PortSlider"
                                Width="230"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                materialDesign:SliderAssist.HideActiveTrack="True"
                                Maximum="52"
                                Minimum="0"
                                Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                TickFrequency="{Binding DiscreteHorizontal.TickFrequency}"
                                TickPlacement="BottomRight"
                                ValueChanged="PortSlider_OnValueChanged"
                                Value="0" />

                        </StackPanel>

                        <StackPanel
                            Margin="{StaticResource DefaultMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">



                            <Button
                                x:Name="ClearPortButton"
                                Width="120"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                Click="ClearPortButton_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="清空设备预览区的配置">
                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="DeleteOutline" />
                                    <TextBlock Text="清空设计" />
                                </StackPanel>


                            </Button>



                            <Button
                                x:Name="AddPortButton"
                                Width="120"
                                Height="28"
                                Margin="0,0,20,0"
                                Padding="0"
                                Click="AddPortButton_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="添加端口到设备预览区">
                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="ViewGridPlusOutline" />
                                    <TextBlock Text="添加端口" />
                                </StackPanel>

                            </Button>



                        </StackPanel>

                        <StackPanel
                            Margin="0,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">



                            <Button
                                x:Name="SavePreset"
                                Width="120"
                                Height="28"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="SavePreset_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="保存该型号设备对应的配置信息到数据库">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Kind="ContentSaveCogOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="保存预设" />

                                </StackPanel>
                            </Button>


                            <Button
                                x:Name="SaveButton"
                                Width="120"
                                Height="28"
                                Margin="0,0,20,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="SaveButton_OnClick"
                                Foreground="AliceBlue"
                                ToolTip="应用设备配置，将创建预览区对应的设备到数据库中">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MotionPlayOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="应用设计" />

                                </StackPanel>
                            </Button>


                        </StackPanel>

                    </StackPanel>



                    <ScrollViewer
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <WrapPanel
                            x:Name="PreviewPlan"
                            Margin="5"
                            IsEnabled="False" />
                    </ScrollViewer>



                </Grid>






            </materialDesign:ColorZone>

        </Grid>





    </Grid>
</Window>
