<Window
    x:Class="ThinkITAM.Windows.DevicePortManage.DeviceEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="编辑设备信息"
    Width="650"
    Height="580"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="DeviceEditWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="20,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="编辑设备信息" />

        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">


            <TextBlock
                Margin="10"
                d:Text="N-SW-HX01"
                FontSize="16"
                Opacity="0.5"
                Text="{Binding AssetNumber}" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            Orientation="Vertical">

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    Margin="0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="设备名称:" />
                <TextBox
                    x:Name="Description"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Description}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    Margin="0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="启用日期:" />
                <DatePicker
                    x:Name="EnableDate"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="0"
                    Language="zh-cn"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    Text="{Binding EnableDate}" />
            </StackPanel>


            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="使用单位:"
                    ToolTip="使用单位" />
                <ComboBox
                    x:Name="UseDepartment"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    SelectionChanged="UseDepartment_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    Text="{Binding UseDepartment}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="安装位置:"
                    ToolTip="使用单位" />
                <ComboBox
                    x:Name="Address"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    Text="{Binding Address}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelA"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段A:"
                    ToolTip="自定义字段A" />
                <ComboBox
                    x:Name="TagA"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    SelectionChanged="TagA_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            Orientation="Vertical">

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelB"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段B:"
                    ToolTip="自定义字段B" />
                <ComboBox
                    x:Name="TagB"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>


            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelC"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段C:"
                    ToolTip="自定义字段C" />
                <TextBox
                    x:Name="TagC"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagA}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelD"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段D:"
                    ToolTip="自定义字段D" />
                <TextBox
                    x:Name="TagD"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagB}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelE"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段E:"
                    ToolTip="自定义字段E" />
                <TextBox
                    x:Name="TagE"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagC}" />
            </StackPanel>

            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelF"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    Content="自定义字段F:"
                    ToolTip="自定义字段F" />
                <TextBox
                    x:Name="TagF"
                    Width="250"
                    Height="28"
                    Margin="5,0,10,10"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagD}" />
            </StackPanel>



        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="20,10">

            <Button
                x:Name="SaveButton"
                Width="150"
                Margin="0,0,30,0"
                HorizontalAlignment="Right"
                BorderThickness="0"
                Content="保存" 
                Click="SaveButton_OnClick"
                />

        </StackPanel>
    </Grid>
</Window>
