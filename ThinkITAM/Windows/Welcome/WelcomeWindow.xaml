<Window
    x:Class="ThinkITAM.Windows.Welcome.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.Welcome"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    Title="Welcome"
    Width="810"
    Height="500"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="WelcomeWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock
                Margin="10,20,10,10"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="欢迎使用ThinkITAM预览版" />
            <TextBlock
                Margin="10,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HarmonyOsFontFamily}"
                FontSize="14"
                Foreground="Red"
                Opacity="0.8"
                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                Text="本软件为免费软件，如果您花钱购买了本软件，请联系卖家退款!" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="QrGrid"
                Grid.Column="1"
                Visibility="Visible">
                <Image
                    Margin="10"
                    Source="/Resources/Image/QR.png"
                    Stretch="None" />
                <Label
                    Margin="20,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Content="ThinkITAM反馈交流群"
                    FontSize="14" />


            </Grid>




            <Grid Grid.Column="0" Margin="10">


                <wpf:MarkdownViewer
                    x:Name="UpdateInfo"
                    FontSize="20"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" />


            </Grid>

        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <CheckBox
                x:Name="ShowWelcomeBox"
                Margin="10"
                Content="不再显示"
                FontSize="14"
                IsChecked="False"
                Style="{StaticResource MaterialDesignSecondaryCheckBox}" />

            <Button
                x:Name="CloseButton"
                Margin="10"
                Click="CloseButton_OnClick"
                Content="我已知晓并愿意承担使用风险"
                FontSize="14" />


        </StackPanel>

    </Grid>
</Window>
