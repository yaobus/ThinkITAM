<Window
    x:Class="ThinkITAM.Windows.Computer.ComputerEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="编辑终端信息"
    Width="600"
    Height="400"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="ComputerEditWindow_OnLoaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Thickness x:Key="DefaultMargin">10,3</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <materialDesign:PackIcon
                Width="40"
                Height="40"
                Kind="NewspaperPlus" />

            <TextBlock
                Margin="10"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="编辑终端信息" />

        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock
                Margin="10"
                d:Text="255.255.255.252"
                FontSize="16"
                Opacity="0.5"
                Text="{Binding Network}" />

            <TextBlock
                Margin="10"
                d:Text="255.255.255.252"
                FontSize="16"
                Opacity="0.5"
                Text="{Binding Netmask}" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="网段名称:" />
                <TextBox
                    x:Name="TbName"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Name}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="网段备注:" />
                <TextBox
                    x:Name="Description"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="AlphaNCircleOutline"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Description}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelA"
                    VerticalAlignment="Center"
                    Content="自定义字段A:"
                    ToolTip="自定义字段A" />
                <ComboBox
                    x:Name="TagA"
                    Width="250"
                    Height="28"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    SelectedItem="{Binding TagA}"
                    SelectionChanged="TbParent_OnSelectionChanged"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelB"
                    VerticalAlignment="Center"
                    Content="自定义字段B:"
                    ToolTip="自定义字段B" />
                <ComboBox
                    x:Name="TagB"
                    Width="250"
                    Height="28"
                    Padding="0"
                    BorderThickness="0.5"
                    IsEditable="True"
                    SelectedItem="{Binding TagB}" />
            </StackPanel>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelC"
                    VerticalAlignment="Center"
                    Content="自定义字段C:"
                    ToolTip="自定义字段C" />
                <TextBox
                    x:Name="TagC"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagC}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelD"
                    VerticalAlignment="Center"
                    Content="自定义字段D:"
                    ToolTip="自定义字段D" />
                <TextBox
                    x:Name="TagD"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagD}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelE"
                    VerticalAlignment="Center"
                    Content="自定义字段E:"
                    ToolTip="自定义字段E" />
                <TextBox
                    x:Name="TagE"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagE}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource DefaultMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Label
                    x:Name="LabelF"
                    VerticalAlignment="Center"
                    Content="自定义字段F:"
                    ToolTip="自定义字段F" />
                <TextBox
                    x:Name="TagF"
                    Width="250"
                    Height="28"
                    Padding="3"
                    VerticalAlignment="Center"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Tag"
                    BorderThickness="0.5"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding TagF}" />
            </StackPanel>



        </StackPanel>

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10">

            <Button
                x:Name="SaveButton"
                Width="150"
                HorizontalAlignment="Right"
                BorderThickness="0"
                Click="SaveButton_OnClick"
                Content="保存" />

        </Grid>
    </Grid>
</Window>
