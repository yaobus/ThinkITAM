<Window
    x:Class="ThinkITAM.Windows.Scan.ScanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.Windows.Scan"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="QR Code Scanner"
    Width="800"
    Height="450"
    d:Background="#383838"
    Background="#383838"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal">


            <StackPanel x:Name="Panel" Orientation="Horizontal" />


        </StackPanel>


        <Image
            Name="videoImage"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Stretch="UniformToFill" />

        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1">
            <ComboBox
                x:Name="ComboBox"
                Height="40"
                Margin="5"
                Padding="0"
                BorderThickness="1"
                SelectionChanged="ComboBox_OnSelectionChanged"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            <TextBox
                x:Name="FilePath"
                Height="40"
                Margin="5"
                Padding="0"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SelectFileButton"
                    Grid.Column="0"
                    Width="80"
                    Margin="5"
                    Click="SelectFileButton_OnClick"
                    Content="浏览" />
                <Button
                    x:Name="ReadButton"
                    Grid.Column="1"
                    Width="80"
                    Margin="5"
                    Click="ReadButton_OnClick"
                    Content="识别" />

            </Grid>


            <StackPanel Grid.Row="1" Orientation="Vertical">

                <TextBox
                    x:Name="AssetCodeSource"
                    Height="40"
                    Margin="5"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox
                    x:Name="AssetCode"
                    Height="40"
                    Margin="5"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <Button
                    x:Name="Button"
                    Width="60"
                    Margin="10"
                    Click="Button_OnClick"
                    Content="计算" />
                <Button
                    x:Name="Button2"
                    Width="60"
                    Margin="10"
                    Click="Button2_OnClick"
                    Content="校验" />
            </StackPanel>
        </StackPanel>



    </Grid>
</Window>
