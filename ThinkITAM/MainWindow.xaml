<Window
    x:Class="ThinkITAM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="810"
    Height="500"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="MainWindow_OnLoaded"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone
            Margin="10"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp2"
            CornerRadius="5"
            Mode="Standard">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="ProjectListView"
                    Grid.Row="0"
                    Grid.Column="0"
                    AllowDrop="True"
                    IsManipulationEnabled="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
                                <Grid Height="50">

                                    <Grid Background="DarkCyan">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="70*" />
                                            <RowDefinition Height="30*" />
                                        </Grid.RowDefinitions>


                                        <Grid Grid.Row="0" Margin="5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                Text="{Binding NickName}" />

                                            <materialDesign:PackIcon
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="AliceBlue"
                                                Kind="VideoInputComponent"
                                                Opacity="0.3" />

                                        </Grid>


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.5"
                                            Text="{Binding rackNote}" />


                                    </Grid>

                                </Grid>


                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <Grid Grid.Row="1">

                    <Button
                        Content="{DynamicResource AddProject}"
                        Style="{StaticResource MaterialDesignFlatLightButton}"
                        ToolTip="MaterialDesignFlatLightButton" />
                </Grid>
            </Grid>
        </materialDesign:ColorZone>


        <Grid Grid.Column="1">

            <ComboBox
                x:Name="LanguageComboBox"
                Width="100"
                Margin="5"
                Padding="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                BorderThickness="1"
                FontSize="12"
                MaxDropDownHeight="300"
                SelectionChanged="LanguageComboBox_OnSelectionChanged"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="简体中文" />
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="English" />
            </ComboBox>
        </Grid>
    </Grid>


</Window>
