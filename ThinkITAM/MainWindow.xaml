<Window
    x:Class="ThinkITAM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ThinkITAM"
    Width="810"
    Height="500"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="MainWindow_OnLoaded"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone
            x:Name="ProjectZone"
            Grid.Column="1"
            Margin="10"

            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            Mode="Standard">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="ProjectListView"
                    Grid.Row="0"
                    Grid.Column="0"
                    AllowDrop="True"
                    IsManipulationEnabled="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
                                <Grid Height="50">

                                    <Grid Background="DarkCyan">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="70*" />
                                            <RowDefinition Height="30*" />
                                        </Grid.RowDefinitions>


                                        <Grid Grid.Row="0" Margin="5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                Text="{Binding NickName}" />

                                            <materialDesign:PackIcon
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="AliceBlue"
                                                Kind="VideoInputComponent"
                                                Opacity="0.3" />

                                        </Grid>


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.5"
                                            Text="{Binding rackNote}" />


                                    </Grid>

                                </Grid>


                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <Grid Grid.Row="1" Margin="0,5">

                    <Button
                        x:Name="AddProjectButton"
                        Margin="0"
                        Content="{DynamicResource AddProject}"
                        Style="{StaticResource MaterialDesignRaisedLightButton}"
                        Click="AddProjectButton_OnClick"
                        />


                </Grid>
            </Grid>
        </materialDesign:ColorZone>

        <materialDesign:ColorZone
            x:Name="SetPasswordZone"
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            d:Visibility="Collapsed"
            Mode="Standard">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel
                        Margin="10,5"
                        Orientation="Vertical">
                        <Label
                            Margin="0,5"
                            Content="{DynamicResource SetPassword}"/>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}"
                            />

                    </StackPanel>

                    <StackPanel
                        Margin="10,5"
                        Orientation="Vertical">
                        <Label
                            Margin="0,5"
                            Content="{DynamicResource SetPasswordAgain}"/>
                        <PasswordBox
                            x:Name="PasswordBoxAgain"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}"
                            />

                    </StackPanel>



                    <StackPanel
                        Margin="10,5"
                        Orientation="Vertical">
                        <Label
                            Margin="0,5"
                            Content=""/>
                        <Button
                            x:Name="SavePasswordButton"
                            Margin="0,0"
                            Content="{DynamicResource SavePassword}"
                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                            Click="SavePasswordButton_OnClick"
                            />
                    </StackPanel>
                </StackPanel>


            </Grid>
        </materialDesign:ColorZone>

        <materialDesign:ColorZone
            x:Name="LoginZone"
            Grid.Column="1"
            Margin="10"
            d:Visibility="Collapsed"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            Mode="Standard">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel
                        Margin="10,5"
                        Orientation="Vertical">
                        <Label
                            Margin="0,5"
                            Content="{DynamicResource InputPassword}"/>
                        <PasswordBox
                            x:Name="InputPasswordBox"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}"
                            />

                    </StackPanel>



                    <StackPanel
                        Margin="10,5"
                        Orientation="Vertical">
                        <Label
                            Margin="0,5"
                            Content=""/>
                        <Button
                            x:Name="LoginButton"
                            Margin="0,0"
                            Content="{DynamicResource Login}"
                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                            Click="LoginButton_OnClick"
                            />
                    </StackPanel>
                </StackPanel>


            </Grid>
        </materialDesign:ColorZone>


        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <ToggleButton
                x:Name="ThemeToggleButton"
                Margin="5"
                Height="25"
                Width="25"
                VerticalAlignment="Top"
                Foreground="AliceBlue"
                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=WeatherNight}"
                Content="{materialDesign:PackIcon Kind=WhiteBalanceSunny}"
                Style="{StaticResource MaterialDesignActionToggleButton}"
                Click="ThemeToggleButton_OnClick"
                />
            <ComboBox
                x:Name="LanguageComboBox"
                Width="120"
                Margin="5"
                Padding="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                BorderThickness="0"
                FontSize="12"
                materialDesign:HintAssist.Hint="Language"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Language"
                MaxDropDownHeight="300"
                SelectionChanged="LanguageComboBox_OnSelectionChanged"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="简体中文" />
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="English" />
            </ComboBox>
        </StackPanel>

        <!--  提示信息  -->
        <materialDesign:DialogHost
            Grid.Column="0"
            Grid.ColumnSpan="2"
            d:Visibility="Collapsed"
            Identifier="MessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>
    </Grid>


</Window>
