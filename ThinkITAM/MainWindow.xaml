<Window
    x:Class="ThinkITAM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataBaseConfig="clr-namespace:ThinkITAM.ViewModels.DataBaseConfig"
    xmlns:local="clr-namespace:ThinkITAM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignColors="clr-namespace:MaterialDesignColors;assembly=MaterialDesignColors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ThinkITAM"
    Width="810"
    Height="500"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="MainWindow_OnLoaded"
    Style="{StaticResource ResourceKey=MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:IndexToBoolConverter x:Key="IndexToBoolConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <materialDesign:ColorZone
            x:Name="ProjectZone"
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Stretch"
            d:Visibility="Visible"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            Mode="Standard"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    x:Name="ProjectListView"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    AllowDrop="True"
                    IsManipulationEnabled="True"
                    MouseDoubleClick="ProjectListView_OnMouseDoubleClick"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="ProjectListView_OnSelectionChanged">
                    <ListView.DataContext>
                        <dataBaseConfig:DataBaseConfigViewModel />
                    </ListView.DataContext>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp2">
                                <materialDesign:ColorZone Padding="0" Mode="PrimaryLight">

                                    <Grid Width="300" Height="50">


                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="70*" />
                                            <RowDefinition Height="30*" />
                                        </Grid.RowDefinitions>


                                        <Grid Grid.Row="0" Margin="5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                Text="{Binding NickName}" />

                                        </Grid>


                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.5"
                                            Text="{Binding Path}"
                                            ToolTip="{Binding Path}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.5"
                                            Text="{Binding Host}" />

                                    </Grid>

                                </materialDesign:ColorZone>
                            </materialDesign:Card>


                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <Grid Grid.Row="1" Margin="0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="AddProjectButton"
                        Grid.Row="0"
                        Margin="0,5"
                        Click="AddProjectButton_OnClick"
                        Content="{DynamicResource AddProject}"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />

                    <Button
                        x:Name="DelProjectButton"
                        Grid.Row="1"
                        Margin="0,5"
                        Click="DelProjectButton_OnClick"
                        Content="{DynamicResource DelProject}"
                        IsEnabled="{Binding SelectedIndex, ElementName=ProjectListView, Converter={StaticResource IndexToBoolConverter}}"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />


                </Grid>
            </Grid>
        </materialDesign:ColorZone>

        <materialDesign:ColorZone
            x:Name="SetPasswordZone"
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Bottom"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            Mode="Standard"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="10,5" Orientation="Vertical">
                        <Label Margin="0,5" Content="{DynamicResource SetPassword}" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}" />

                    </StackPanel>

                    <StackPanel Margin="10,5" Orientation="Vertical">
                        <Label Margin="0,5" Content="{DynamicResource SetPasswordAgain}" />
                        <PasswordBox
                            x:Name="PasswordBoxAgain"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}" />

                    </StackPanel>



                    <StackPanel Margin="10,5" Orientation="Vertical">
                        <Label Margin="0,5" Content="" />
                        <Button
                            x:Name="SavePasswordButton"
                            Margin="0,0"
                            Click="SavePasswordButton_OnClick"
                            Content="{DynamicResource SavePassword}"
                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                    </StackPanel>
                </StackPanel>


            </Grid>
        </materialDesign:ColorZone>

        <materialDesign:ColorZone
            x:Name="LoginZone"
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp1"
            CornerRadius="5"
            Mode="Standard"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="10,5" Orientation="Vertical">
                        <Label Margin="0,5" Content="{DynamicResource InputPassword}" />
                        <PasswordBox
                            x:Name="InputPasswordBox"
                            Padding="0,5"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Password"
                            KeyDown="InputPasswordBox_OnKeyDown"
                            Style="{StaticResource MaterialDesignFilledPasswordBox}" />

                    </StackPanel>



                    <StackPanel Margin="10,5" Orientation="Vertical">
                        <Label Margin="0,5" Content="" />
                        <Button
                            x:Name="LoginButton"
                            Margin="0,0"
                            Click="LoginButton_OnClick"
                            Content="{DynamicResource Login}"
                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                    </StackPanel>
                </StackPanel>


            </Grid>
        </materialDesign:ColorZone>


        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <ToggleButton
                x:Name="ThemeToggleButton"
                Width="25"
                Height="25"
                Margin="5"
                VerticalAlignment="Top"
                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=WeatherNight}"
                Click="ThemeToggleButton_OnClick"
                Content="{materialDesign:PackIcon Kind=WhiteBalanceSunny}"
                Foreground="AliceBlue"
                Style="{StaticResource MaterialDesignActionToggleButton}" />
            <ComboBox
                x:Name="LanguageComboBox"
                Width="120"
                Margin="5"
                Padding="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                materialDesign:HintAssist.Hint="Language"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Language"
                BorderThickness="0"
                FontSize="12"
                MaxDropDownHeight="300"
                SelectionChanged="LanguageComboBox_OnSelectionChanged"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="简体中文" />
                <ComboBoxItem
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="English" />
            </ComboBox>
        </StackPanel>

        <!--  提示信息  -->
        <materialDesign:DialogHost
            Grid.Column="0"
            Grid.ColumnSpan="2"
            d:Visibility="Collapsed"
            Identifier="MainWindowMessageDialogHost">
            <!--  DialogHost的内容  -->
        </materialDesign:DialogHost>
    </Grid>


</Window>
