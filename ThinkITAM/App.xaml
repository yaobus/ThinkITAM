<Application
    x:Class="ThinkITAM.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ThinkITAM"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme BaseTheme="Light" ColorAdjustment="{materialDesign:ColorAdjustment}" />

                <!--  Set your base theme  -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesign3.defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Light.xaml" />

                <ResourceDictionary Source="Language/zh-CN.xaml" />
                <ResourceDictionary Source="Language/en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>



            <FontFamily x:Key="HarmonyOsFontFamily">pack://application:,,,/Resources/fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC Regular</FontFamily>
            <FontFamily x:Key="HarmonyOsFontFamilyMedium">pack://application:,,,/Resources/fonts/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC Medium</FontFamily>
            <FontFamily x:Key="HarmonyOsFontFamilyBold">pack://application:,,,/Resources/fonts/HarmonyOS_Sans_SC_Bold.ttf#HarmonyOS Sans SC Bold</FontFamily>
            <FontFamily x:Key="HarmonyOsFontFamilyLight">pack://application:,,,/Resources/fonts/HarmonyOS_Sans_SC_Light.ttf#HarmonyOS Sans SC Light</FontFamily>



        </ResourceDictionary>
    </Application.Resources>
</Application>
