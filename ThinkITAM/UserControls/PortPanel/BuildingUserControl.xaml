<UserControl
    x:Class="ThinkITAM.UserControls.PortPanel.BuildingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.PortPanel"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="260"
    Height="50"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="#009688" />

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Background="#008080" />

                <TextBlock
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="22"
                    FontWeight="ExtraBlack"
                    Foreground="AliceBlue"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="{Binding Index}" />

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55*" />
                        <ColumnDefinition Width="45*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="建筑物"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Building}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        d:Text="备注信息"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Opacity="0.1"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Note}" />

                </Grid>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.75"/>
                               <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <TextBlock
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:Text="自定义分组"
                            FontWeight="Bold"
                            Foreground="AliceBlue"
                            Opacity="0.3"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding Address}"
                            Visibility="Visible" />



                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        d:Text="1/2/3"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Opacity="0.3"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding Count}"
                        Visibility="Visible" >
                        
                    </TextBlock>
                </Grid>
            </Grid>

        </materialDesign:Card>
    </materialDesign:TransitioningContent>


</UserControl>
