<UserControl
    x:Class="ThinkITAM.UserControls.PortPanel.PanelPort"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:linkManage="clr-namespace:ThinkITAM.ViewModels.LinkManage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Width="50"
    Height="93"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="Port_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>

        <converters:IntToFalseIfNegativeOneConverter x:Key="IntToFalseIfNegativeOneConverter" />
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <DataTemplate x:Key="Eth">
            <local:Eth />
        </DataTemplate>
        <DataTemplate x:Key="SC">
            <local:SC />
        </DataTemplate>
        <DataTemplate x:Key="FC">
            <local:FC />
        </DataTemplate>
        <DataTemplate x:Key="LC">
            <Grid RenderTransformOrigin="0.5,0.5">
                <!--  设置中心点旋转  -->
                <Grid.RenderTransform>
                    <RotateTransform Angle="90" />
                </Grid.RenderTransform>

                <!--  原始内容  -->
                <local:LC />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="17" />
            <RowDefinition Height="8" />
            <RowDefinition Height="18" />
        </Grid.RowDefinitions>
        <Button
            x:Name="PortButton"
            Grid.Row="0"
            Width="50"
            Height="50"
            Padding="0"
            Background="Transparent"
            BorderBrush="AliceBlue"
            BorderThickness="0.25"
            Click="PortButton_OnClick"
            Foreground="AliceBlue"
            Style="{StaticResource MaterialDesignFlatLightButton}">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Click="MenuItem_OnClick"
                        Header="{DynamicResource PpDeletePort}"
                        Tag="Delete" />
                </ContextMenu>
            </Button.ContextMenu>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PortType}" Value="Eth">
                                <Setter Property="ContentTemplate" Value="{StaticResource Eth}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PortType}" Value="SC">
                                <Setter Property="ContentTemplate" Value="{StaticResource SC}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PortType}" Value="FC">
                                <Setter Property="ContentTemplate" Value="{StaticResource FC}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PortType}" Value="LC">
                                <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                            </DataTrigger>


                            <!--  新增的 DataTrigger 根据 Parameter 是否为空来设置按钮颜色  -->
                            <DataTrigger Binding="{Binding OnTheLine, Converter={StaticResource IntToFalseIfNegativeOneConverter}, Mode=TwoWay}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding OnTheLine, Converter={StaticResource IntToFalseIfNegativeOneConverter}, Mode=TwoWay}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>


                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </Button>

        <Grid Grid.Row="1" Margin="0">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="A-1"
                FontSize="12"
                FontWeight="Bold"
                Text="{Binding PortIndex}" />


        </Grid>
        <Grid
            Grid.Row="3"
            Width="50"
            Margin="0,1"
            Opacity="0.8">

            <Button
                x:Name="TagButton"
                Height="16"
                Padding="0"
                VerticalAlignment="Center"
                d:Content="TAG-A"
                BorderThickness="0"
                Click="TagButton_OnClick"
                Content="{Binding PortTag}"
                FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                FontSize="12"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="{Binding PortTag}" />


        </Grid>

        <Grid
            Grid.Row="2"
            Width="50"
            Margin="0"
            Background="{Binding PortColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}"
            Opacity="0.8">

            <Button
                x:Name="ColorTagSet"
                Height="8"
                Padding="0"
                BorderThickness="0"
                Click="ColorTagSet_OnClick"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="点击修改颜色标记" />


        </Grid>
    </Grid>
</UserControl>
