<UserControl
    x:Class="ThinkITAM.UserControls.WakeOnLan.HostUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.WakeOnLan"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="200"
    Height="50"
    Background="transparent"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:HostOnlineStatusToColorConverter x:Key="HostOnlineStatusToColorConverter" />
        <converters:HostOnlineStatusToPackIcon x:Key="HostOnlineStatusToPackIcon" />
        <converters:PinToStartIntToVisibilityConverter x:Key="PinToStartIntToVisibilityConverter" />
    </UserControl.Resources>

    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.2}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

            <Button
                x:Name="WolButton"
                Width="200"
                Height="50"
                Padding="0"
                Click="WolButton_OnClick"
                ContextMenuOpening="WolButton_OnContextMenuOpening"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="{Binding TpWakeOnLanTooltip}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Click="MenuItem_OnClick"
                            Header="移除主机"
                            Tag="DeleteHost" />
                        <MenuItem
                            Click="MenuItem_OnClick"
                            Header="编辑主机"
                            Tag="EditHost" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Width="200">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Background="{Binding Status, Converter={StaticResource HostOnlineStatusToColorConverter}}">

                        <materialDesign:PackIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="AliceBlue"
                            Kind="{Binding Status, Converter={StaticResource HostOnlineStatusToPackIcon}}" />

                    </Grid>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Background="#01847f" />



                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0">
                            <Border.OpacityMask>
                                <LinearGradientBrush x:Name="MaskBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="0.75" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="TextBlock"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    d:Text="快速访问标签"
                                    FontWeight="Bold"
                                    Foreground="AliceBlue"
                                    SizeChanged="TextBlock_OnSizeChanged"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="{Binding Name}"
                                    ToolTip="{Binding Name}" />

                            </Grid>
                        </Border>


                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">


                        <TextBlock
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:Text="00:11:22:33:44:55"
                            FontWeight="Bold"
                            Foreground="AliceBlue"
                            Opacity="0.5"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding MAC}" />


                    </Grid>


                </Grid>


            </Button>

        </materialDesign:Card>
    </materialDesign:TransitioningContent>


</UserControl>
