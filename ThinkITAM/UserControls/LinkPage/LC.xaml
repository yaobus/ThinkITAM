<UserControl
    x:Class="ThinkITAM.UserControls.LinkPage.LC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:linkManage="clr-namespace:ThinkITAM.ViewModels.LinkManage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Width="34"
    Height="36"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <linkManage:PortClass />
    </UserControl.DataContext>
    <UserControl.Resources>
        <system:Double x:Key="ControlSize">6</system:Double>
        <system:Double x:Key="ControlSize2">34</system:Double>
        <Brush x:Key="Color">#ff5959</Brush>
    </UserControl.Resources>
    <Grid Width="18" Height="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Background="{DynamicResource Color}" />

        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Width="18"
            Height="25"
            BorderBrush="{DynamicResource Color}"
            BorderThickness="1" />


        <Grid Grid.Row="0">
            <Border
                Width="1"
                Height="1"
                Margin="6,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource Color}" />

            <Border
                Width="2"
                Height="2"
                Margin="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource Color}" />

            <materialDesign:PackIcon
                Width="{StaticResource ControlSize}"
                Height="{StaticResource ControlSize}"
                Margin="5,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="AliceBlue"
                Kind="CircleOutline"
                Opacity="0.5" />


            <Border
                Width="2"
                Height="2"
                Margin="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Color}" />


            <Border
                Width="1"
                Height="1"
                Margin="6,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Color}" />

        </Grid>


        <Grid Grid.Row="2">
            <Border
                Width="1"
                Height="1"
                Margin="6,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource Color}" />

            <Border
                Width="2"
                Height="2"
                Margin="1,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource Color}" />

            <materialDesign:PackIcon
                Width="{StaticResource ControlSize}"
                Height="{StaticResource ControlSize}"
                Margin="5,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="AliceBlue"
                Kind="CircleOutline"
                Opacity="0.5" />


            <Border
                Width="2"
                Height="2"
                Margin="1,0,0,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Color}" />


            <Border
                Width="1"
                Height="1"
                Margin="6,1,0,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Color}" />

        </Grid>



    </Grid>
</UserControl>
