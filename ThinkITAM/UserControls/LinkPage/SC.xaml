<UserControl
    x:Class="ThinkITAM.UserControls.LinkPage.SC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:linkManage="clr-namespace:ThinkITAM.ViewModels.LinkManage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Width="34"
    Height="34"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <system:Double x:Key="ControlSize">10</system:Double>
        <system:Double x:Key="ControlSize2">34</system:Double>
    </UserControl.Resources>
    <UserControl.DataContext>
        <linkManage:PortClass />
    </UserControl.DataContext>
    <Grid>



        <materialDesign:PackIcon
            Width="{StaticResource ControlSize2}"
            Height="{StaticResource ControlSize2}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Kind="HexagonOutline"
            Opacity="0.8"
            Visibility="Collapsed" />

        <Border
            Width="25"
            Height="18"
            BorderBrush="DeepSkyBlue"
            BorderThickness="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HarmonyOsFontFamilyMedium}"
                Foreground="DeepSkyBlue"
                Text="I   I" />

        </Border>
        <materialDesign:PackIcon
            Width="{StaticResource ControlSize}"
            Height="{StaticResource ControlSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="Gray"
            Kind="CircleOutline"
            Opacity="1" />
    </Grid>
</UserControl>
