<UserControl
    x:Class="ThinkITAM.UserControls.LinkPage.Port"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:linkManage="clr-namespace:ThinkITAM.ViewModels.LinkManage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Width="34"
    Height="65"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="Port_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter" />
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:IntToFalseIfNegativeOneConverter x:Key="IntToFalseIfNegativeOneConverter" />
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <DataTemplate x:Key="Eth">
            <local:Eth />
        </DataTemplate>
        <DataTemplate x:Key="SC">
            <local:SC />
        </DataTemplate>
        <DataTemplate x:Key="FC">
            <local:FC />
        </DataTemplate>
        <DataTemplate x:Key="LC">
            <local:LC />
        </DataTemplate>

        <LinearGradientBrush x:Key="AnimatedBrush" StartPoint="0 0" EndPoint="1 0">
            <GradientStop Offset="0" Color="#00FFFF" />
            <GradientStop Offset="0.5" Color="#FFFF00" />
            <GradientStop Offset="1" Color="#FF0000" />
        </LinearGradientBrush>

        <Storyboard x:Key="AnimateBorder" RepeatBehavior="Forever">
            <!--  修改 StartPoint 和 EndPoint  -->
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 0"
                Duration="0:0:2" />

            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 0"
                Duration="0:0:2" />
        </Storyboard>


    </UserControl.Resources>

    <UserControl.DataContext>
        <linkManage:PortClass />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>
        <Button
            x:Name="PortButton"
            Grid.Row="0"
            Width="34"
            Height="36"
            Padding="0"
            d:BorderThickness="3"
            BorderBrush="{StaticResource AnimatedBrush}"
            BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToBorderThicknessConverter}}"
            Click="PortButton_OnClick">

            <Button.Style>
                <!--  继承 MaterialDesignFlatLightButton 并扩展触发器  -->
                <Style BasedOn="{StaticResource MaterialDesignFlatLightButton}" TargetType="Button">
                    <!--  保留 Material Design 的默认属性  -->
                    <Setter Property="BorderBrush" Value="{StaticResource AnimatedBrush}" />
                    <!--  确保动画画刷优先级  -->
                    <Style.Triggers>
                        <!--  当 IsSelected 为 true 时启动动画  -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="AnimateBorderStoryboard" Storyboard="{StaticResource AnimateBorder}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AnimateBorderStoryboard" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                    Text="{Binding NodeIndex}"
                    Visibility="{Binding NodeIndex, Converter={StaticResource IntToVisibilityConverter}}" />
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PortType}" Value="Eth">
                                    <Setter Property="ContentTemplate" Value="{StaticResource Eth}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PortType}" Value="SC">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SC}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PortType}" Value="FC">
                                    <Setter Property="ContentTemplate" Value="{StaticResource FC}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PortType}" Value="LC">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                                </DataTrigger>


                                <!--  新增的 DataTrigger 根据 Parameter 是否为空来设置按钮颜色  -->
                                <DataTrigger Binding="{Binding OnTheLine, Converter={StaticResource IntToFalseIfNegativeOneConverter}, Mode=TwoWay}" Value="False">
                                    <Setter Property="Opacity" Value="0.1" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OnTheLine, Converter={StaticResource IntToFalseIfNegativeOneConverter}, Mode=TwoWay}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>




                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Button>

        <Grid Grid.Row="1" Margin="0">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="Bold"
                Foreground="AliceBlue"
                Text="{Binding PortIndex}" />


        </Grid>

        <Grid
            Grid.Row="2"
            Width="34"
            Margin="0,1"
            Background="AliceBlue"
            Opacity="0.8">

            <Button
                x:Name="TagButton"
                Height="10"
                Padding="0"
                VerticalAlignment="Center"
                d:Content="ABCDEF"
                BorderThickness="0"
                Click="TagButton_OnClick"
                Content="{Binding PortTag}"
                FontSize="8"
                Foreground="DarkCyan"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="{Binding PortTag}" />


        </Grid>

        <Grid
            Grid.Row="3"
            Width="34"
            Margin="0"
            Background="{Binding PortColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}"
            Opacity="0.8">

            <Button
                x:Name="ColorTagSet"
                Height="6"
                Padding="0"
                BorderThickness="0"
                Click="ColorTagSet_OnClick"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                ToolTip="点击修改颜色标记" />


        </Grid>
    </Grid>
</UserControl>
