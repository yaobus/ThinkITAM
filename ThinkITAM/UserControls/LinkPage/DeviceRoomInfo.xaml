<UserControl
    x:Class="ThinkITAM.UserControls.LinkPage.DeviceRoomInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="260"
    Height="50"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="#2daf94">


                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="22"
                        FontWeight="ExtraBlack"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="{Binding Index}" />


                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Background="#008080" />

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="测试机房配线间"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Name}" />

                    <materialDesign:PackIcon
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="AliceBlue"
                        Kind="HomeCityOutline"
                        Opacity="0.3" />

                </Grid>



                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Border.OpacityMask>
                            <LinearGradientBrush x:Name="MaskBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="0.75" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>

                        <Grid>
                            <TextBlock
                                x:Name="TextBlock"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Text="地址:"
                                FontWeight="Bold"
                                Foreground="AliceBlue"
                                Opacity="0.3"
                                SizeChanged="TextBlock_OnSizeChanged"
                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                Text="{Binding Location}"
                                ToolTip="{Binding Location}" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="电话:13000000000"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Opacity="0.5"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding UserPhone}"
                        Visibility="Collapsed" />



                </Grid>

            </Grid>



        </materialDesign:Card>

    </materialDesign:TransitioningContent>


</UserControl>
