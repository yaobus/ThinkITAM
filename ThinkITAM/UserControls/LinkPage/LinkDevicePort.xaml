<UserControl
    x:Class="ThinkITAM.UserControls.LinkPage.LinkDevicePort"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:linkManage="clr-namespace:ThinkITAM.ViewModels.LinkManage"
    xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="70"
    Height="70"
    Background="Transparent"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="LinkDevicePort_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:IntToOpacityConverter x:Key="IntToOpacityConverter" />
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter" />
        <converters:PortTypeToIconKindConverter x:Key="PortTypeToIconKindConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <DataTemplate x:Key="Eth">
            <linkPage:Eth />
        </DataTemplate>
        <DataTemplate x:Key="SC">
            <linkPage:SC />
        </DataTemplate>
        <DataTemplate x:Key="FC">
            <linkPage:FC />
        </DataTemplate>
        <DataTemplate x:Key="LC">
            <Grid RenderTransformOrigin="0.5,0.5">
                <!--  设置中心点旋转  -->
                <Grid.RenderTransform>
                    <RotateTransform Angle="90" />
                </Grid.RenderTransform>

                <!--  原始内容  -->
                <linkPage:LC />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.DataContext>
        <linkManage:PortLinkClass />
    </UserControl.DataContext>

    <materialDesign:TransitioningContent Margin="2.5,0" OpeningEffectsOffset="{materialDesign:IndexedItemOffsetMultiplier 0:0:0.2}">
        <materialDesign:TransitioningContent.OpeningEffects>
            <materialDesign:TransitionEffect Kind="ExpandIn" />
        </materialDesign:TransitioningContent.OpeningEffects>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Button
                    x:Name="EthernetButton"
                    Width="60"
                    Height="45"
                    Padding="0"
                    VerticalAlignment="Top"
                    d:BorderThickness="4"
                    BorderBrush="SeaGreen"
                    BorderThickness="{Binding PortClass.IsSelected, Converter={StaticResource BoolToBorderThicknessConverter}, Mode=TwoWay}"
                    Click="EthernetButton_OnClick"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <Grid>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                            Text="{Binding PortClass.NodeIndex}"
                            Visibility="{Binding PortClass.NodeIndex, Converter={StaticResource IntToVisibilityConverter}}" />


                        <ContentControl
                            Grid.Row="0"
                            Width="34"
                            Height="36"
                            Margin="0"
                            VerticalAlignment="Center"
                            Opacity="{Binding PortClass.OnTheLine, Converter={StaticResource IntToOpacityConverter}}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="Eth">
                                            <Setter Property="ContentTemplate" Value="{StaticResource Eth}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="SC">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="FC">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="LC">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="E">
                                            <Setter Property="ContentTemplate" Value="{StaticResource Eth}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="M">
                                            <Setter Property="ContentTemplate" Value="{StaticResource Eth}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PortClass.PortType}" Value="F">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LC}" />
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>

                        </ContentControl>






                        <!--<materialDesign:PackIcon
                            Grid.Row="0"
                            Width="30"
                            Height="30"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            d:Kind="Ethernet"
                            Opacity="{Binding PortClass.OnTheLine,Converter={StaticResource IntToOpacityConverter}}"
                            Kind="{Binding PortClass.PortType, Converter={StaticResource PortTypeToIconKindConverter}}" >

                        </materialDesign:PackIcon>-->

                    </Grid>

                </Button>


            </Grid>

            <Grid
                Margin="10,1"
                Background="{Binding PortClass.PortColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}"
                Row="1">
                <Button
                    x:Name="ColorTagSet"
                    Height="8"
                    Padding="0"
                    BorderThickness="0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="颜色标记" />

            </Grid>

            <Grid Grid.Row="2">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text="10G "
                        FontSize="12"
                        FontWeight="ExtraBlack"
                        Text="{Binding PortClass.PortTag}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text=" "
                        FontSize="11"
                        FontWeight="ExtraBlack"
                        Text=" " />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="12/0/48"
                        FontSize="12"
                        FontWeight="ExtraBlack"
                        Text="{Binding PortClass.PortIndex}" />
                </StackPanel>


            </Grid>


        </Grid>








    </materialDesign:TransitioningContent>
</UserControl>
