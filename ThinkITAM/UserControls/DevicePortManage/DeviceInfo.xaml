<UserControl
    x:Class="ThinkITAM.UserControls.DevicePortManage.DeviceInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="243"
    Height="50"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="LightSeaGreen" />

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="1"
                    Grid.Column="1"
                    Background="Teal" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="SeaGreen" />

                <TextBlock
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="22"
                    FontWeight="ExtraBlack"
                    Foreground="AliceBlue"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="{Binding Index}" />

                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <Border.OpacityMask>
                            <LinearGradientBrush x:Name="MaskBrush2" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="0.75" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>

                        <Grid Margin="5,0,0,0">
                            <TextBlock
                                x:Name="TextBlock0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Text="接入交换机"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="AliceBlue"
                                SizeChanged="TextBlock0_OnSizeChanged"
                                Text="{Binding Description}"
                                ToolTip="{Binding Description}" />

                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="N-SW-009"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Text="{Binding AssetNumber}"
                        ToolTip="{Binding AssetNumber}" />
                </Grid>




                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0">
                        <Border.OpacityMask>
                            <LinearGradientBrush x:Name="MaskBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="0.75" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid Margin="5,0,0,0">
                            <TextBlock
                                x:Name="TextBlock"
                                MinWidth="90"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Text="服务器网段"
                                Foreground="AliceBlue"
                                Opacity="0.3"
                                SizeChanged="TextBlock_OnSizeChanged"
                                Text="{Binding DeviceType}"
                                ToolTip="{Binding DeviceType}" />
                        </Grid>
                    </Border>


                    <Grid
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch">

                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:Text="S5720-28P-LI-AC"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="AliceBlue"
                            Opacity="0.3"
                            Text="{Binding Model}"
                            ToolTip="{Binding Model}" />


                    </Grid>
                </Grid>


            </Grid>





        </materialDesign:Card>

    </materialDesign:TransitioningContent>


</UserControl>
