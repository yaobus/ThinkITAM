<UserControl
    x:Class="ThinkITAM.UserControls.DevicePortManage.DevicePort"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:linkPage="clr-namespace:ThinkITAM.UserControls.LinkPage"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.DevicePortManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="70"
    Height="86"
    Background="Transparent"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter" />
        <converters:PortTypeToIconKindConverter x:Key="PortTypeToIconKindConverter" />
        <converters:StatusToColorBrushConverter x:Key="StatusToColorBrushConverter" />


        <LinearGradientBrush x:Key="AnimatedBrush" StartPoint="0 0" EndPoint="1 0">
            <GradientStop Offset="0" Color="#00FFFF" />
            <GradientStop Offset="0.5" Color="#FFFF00" />
            <GradientStop Offset="1" Color="#FF0000" />
        </LinearGradientBrush>

        <Storyboard x:Key="AnimateBorder" RepeatBehavior="Forever">
            <!--  修改 StartPoint 和 EndPoint  -->
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 0"
                Duration="0:0:2" />

            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 0"
                Duration="0:0:2" />
        </Storyboard>


    </UserControl.Resources>


    <materialDesign:TransitioningContent Margin="2.5,0" OpeningEffectsOffset="{materialDesign:IndexedItemOffsetMultiplier 0:0:0.2}">
        <materialDesign:TransitioningContent.OpeningEffects>
            <materialDesign:TransitionEffect Kind="ExpandIn" />
        </materialDesign:TransitioningContent.OpeningEffects>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Button
                    x:Name="EthernetButton"
                    Width="60"
                    Height="45"
                    Padding="0"
                    VerticalAlignment="Top"
                    d:BorderThickness="4"
                    Background="Transparent"
                    BorderBrush="{StaticResource AnimatedBrush}"
                    BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToBorderThicknessConverter}, Mode=TwoWay}"
                    Click="EthernetButton_OnClick"
                    Foreground="Azure"
                    ToolTip="{Binding ToolTip}">

                    <Button.Style>
                        <!--  继承 MaterialDesignFlatLightButton 并扩展触发器  -->
                        <Style BasedOn="{StaticResource MaterialDesignFlatLightButton}" TargetType="Button">
                            <!--  保留 Material Design 的默认属性  -->
                            <Setter Property="BorderBrush" Value="{StaticResource AnimatedBrush}" />
                            <!--  确保动画画刷优先级  -->
                            <Style.Triggers>
                                <!--  当 IsSelected 为 true 时启动动画  -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="AnimateBorderStoryboard" Storyboard="{StaticResource AnimateBorder}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="AnimateBorderStoryboard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Grid>

                        <TextBlock
                            Width="12"
                            Height="12"
                            Margin="0,0,-10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            d:Background="Tomato"
                            Visibility="Collapsed" />



                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Width="30"
                            Height="30"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            d:Kind="Ethernet"
                            Foreground="{Binding Status, Converter={StaticResource StatusToColorBrushConverter}}"
                            Kind="{Binding PortType, Converter={StaticResource PortTypeToIconKindConverter}}" />

                    </Grid>

                </Button>


            </Grid>



            <Grid Grid.Row="1" Background="{Binding PingStatusColor}">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text="10G "
                        FontFamily="{StaticResource HarmonyOsFontFamilyMedium}"
                        FontSize="12"
                        Text="{Binding PortSpeed}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text=" "
                        FontSize="11"
                        FontWeight="ExtraBlack"
                        Text=" " />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="12/0/48"
                        FontFamily="{StaticResource HarmonyOsFontFamilyMedium}"
                        FontSize="12"
                        FontWeight="ExtraBlack"
                        Text="{Binding FullPortId}" />
                </StackPanel>


            </Grid>

            <Grid
                Grid.Row="3"

                Margin="7,1"
                Background="AliceBlue"
                Opacity="0.8">

                <Button
                    x:Name="TagButton"
                    Height="14"
                    Padding="0"
                    VerticalAlignment="Center"
                    d:Content="ABCDEF"
                    BorderThickness="0"
                    Content="{Binding PortTag}"
                    FontSize="12"
                    Foreground="DarkCyan"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="{Binding PortTag}" />


            </Grid>


            <Grid
                Margin="7,0"
                Background="{Binding PortColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}"
                Row="2">
                <Button
                    x:Name="ColorTagSet"
                    Height="8"
                    Padding="0"
                    BorderThickness="0"
                    Click="ColorTagSet_OnClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="点击修改颜色标记" />

            </Grid>

        </Grid>








    </materialDesign:TransitioningContent>
</UserControl>
