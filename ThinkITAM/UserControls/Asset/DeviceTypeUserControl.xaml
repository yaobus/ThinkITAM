<UserControl
    x:Class="ThinkITAM.UserControls.Asset.DeviceTypeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.Asset"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="245"
    Height="50"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="33*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>


                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="Turquoise">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="09"
                        FontWeight="ExtraBlack"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="{Binding Index}" />

                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Teal">

                    <TextBlock
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="接入交换机"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignBody1TextBlock}"
                        Text="{Binding DeviceType}" />


                </Grid>






                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="SeaGreen"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Opacity="0.5"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="设备总数:" />

                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Opacity="0.5"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding AssetCount}" />

                </StackPanel>

            </Grid>



        </materialDesign:Card>

    </materialDesign:TransitioningContent>

</UserControl>
