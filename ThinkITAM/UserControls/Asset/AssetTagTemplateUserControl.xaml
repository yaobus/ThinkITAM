<UserControl
    x:Class="ThinkITAM.UserControls.Asset.AssetTagTemplateUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.Asset"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="250"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="0" Background="#2f9f9f">
            <Label
                Margin="10,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold">
                资产基本信息卡
            </Label>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                资产编号
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding AssetNumber}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                生产厂家
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding Manufacturer}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                规格型号
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding Model}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                责任人
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding User}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                联系电话
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding UserPhone}" />
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal">
            <Label
                x:Name="TagA"
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                Content="自定义A"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f" />
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                Text="{Binding TagA}" />
        </StackPanel>

        <Grid
            Grid.Row="3"
            Grid.RowSpan="5"
            Margin="270,-5,0,5">

            <Image
                x:Name="BarcodeImage"
                Width="110"
                Height="110"
                Stretch="UniformToFill" />

            <Label
                HorizontalAlignment="Center"
                FontSize="8.5"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                ITAM资产信息二维码
            </Label>

            <Border
                Width="110"
                BorderBrush="#2f9f9f"
                BorderThickness="0.5"
                CornerRadius="5" />

            <Border
                Width="105"
                Height="105"
                BorderBrush="#2f9f9f"
                BorderThickness="0.3" />

            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="6.9"
                Foreground="#2f9f9f">
                扫描二维码查看更多信息
            </Label>
        </Grid>

        <Label
            Grid.Row="8"
            Margin="0,3,10,0"
            Padding="0"
            HorizontalAlignment="Right"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#2f9f9f"
            Opacity="0.3">
            ThinkITAM
        </Label>
        <Label
            Grid.Row="0"
            Grid.RowSpan="8"
            Width="400"
            Height="250" />
    </Grid>
</UserControl>
