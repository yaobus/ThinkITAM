<UserControl
    x:Class="ThinkITAM.UserControls.Asset.AssetTagTemplateUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.Asset"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="250"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AssetTagTemplateUserControl_OnLoaded"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="0" Background="#2f9f9f">
            <Label
                Margin="10,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                FontSize="20">
                资产基本信息卡
            </Label>

            <Label
                Margin="0,3,10,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="ThinkITAM"
                FontSize="20"
                FontWeight="Bold"
                Foreground="AliceBlue"
                Opacity="0.3" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                资产编号
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding AssetNumber}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                生产厂家
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding Manufacturer}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                规格型号
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding Model}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                责任人
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding User}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Label
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                联系电话
            </Label>
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding UserPhone}" />
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal">
            <Label
                x:Name="TagA"
                Width="60"
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                Content="自定义A"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f" />
            <TextBox
                Width="200"
                Height="20"
                Padding="0"
                BorderBrush="#2f9f9f"
                BorderThickness="0,0,0,1"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#2f9f9f"
                IsReadOnly="True"
                Text="{Binding TagA}" />
        </StackPanel>

        <Grid
            Grid.Row="3"
            Grid.RowSpan="5"
            Margin="270,-5,0,5">

            <Image
                x:Name="BarcodeImage"
                Width="110"
                Height="110"
                Stretch="UniformToFill" />

            <Label
                HorizontalAlignment="Center"
                FontSize="9"
                FontWeight="Bold"
                Foreground="#2f9f9f">
                资产二维码
            </Label>

            <Border
                Width="110"
                BorderBrush="#2f9f9f"
                BorderThickness="0.5"
                CornerRadius="5" />

            <Border
                Width="105"
                Height="105"
                BorderBrush="#2f9f9f"
                BorderThickness="0.3" />

            <Label
                x:Name="AssetId"
                Padding="0,0,0,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                d:Content="ABCDEFG12345"
                Content="{Binding AssetId}"
                FontSize="10"
                Foreground="#2f9f9f" />
        </Grid>


        <Grid Grid.Row="8" Background="#2f9f9f">
            <Label
                x:Name="CustomizeCompanyTag"
                Width="380"
                Margin="10,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="ThinkITAM-点击修改本字段标签"
                Cursor="Hand"
                FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
                FontSize="12"
                Foreground="AliceBlue"
                MouseDown="CustomizeTag_OnMouseDown" />
        </Grid>

        <materialDesign:DialogHost
            x:Name="SaveCustomizeTagDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            d:Visibility="Collapsed"
            CloseOnClickAway="True"
            DialogClosed="SaveCustomizeTagDialogHost_OnDialogClosed"
            DialogContentUniformCornerRadius="5"
            DialogTheme="Inherit">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Margin="10">
                    <TextBlock
                        Width="300"
                        MaxWidth="400"
                        FontSize="14"
                        Text="输入自定义标签" />
                    <TextBox
                        x:Name="CompanyNameTextBox"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        FontSize="14" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SaveCustomizeTag"
                            Margin="0,8,8,0"
                            Click="SaveCustomizeTag_OnClick"
                            Content="保存"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    True
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Margin="0,8,8,0"
                            Click="CancelButton_OnClick"
                            Content="关闭"
                            IsCancel="False"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>


        </materialDesign:DialogHost>


    </Grid>
</UserControl>
