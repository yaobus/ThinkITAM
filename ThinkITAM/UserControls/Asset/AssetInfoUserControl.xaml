<UserControl
    x:Class="ThinkITAM.UserControls.Asset.AssetInfoUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.Asset"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    Height="40"
    Background="#404040"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <system:Double x:Key="LineOp">0.5</system:Double>

    </UserControl.Resources>


    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.05}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="9999"
                FontSize="16"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Index}" />

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="内部网络"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding AssetType}" />




            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="接入交换机"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding DeviceType}" />




            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="资产编号"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding AssetNumber}" />

            <TextBlock
                Grid.Column="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="购置日期"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding PurchaseDate}" />
            <TextBlock
                Grid.Column="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="购置价格"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding PurchasePrice}" />

            <TextBlock
                Grid.Column="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="制造商"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Manufacturer}" />
            <TextBlock
                Grid.Column="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="型号"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Model}" />
            <TextBlock
                Grid.Column="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="序列号"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding SerialNumber}" />


            <TextBlock
                Grid.Column="9"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="配置信息"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Configuration}" />



            <TextBlock
                Grid.Column="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="存放位置"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Location}" />



            <TextBlock
                Grid.Column="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="责任人单位"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding UserOrganization}" />
            <TextBlock
                Grid.Column="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="责任人部门"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding UserDepartment}" />
            <TextBlock
                Grid.Column="13"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="责任人"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding User}" />
            <TextBlock
                Grid.Column="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="责任人电话"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding UserPhone}" />
            <TextBlock
                Grid.Column="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="使用人"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Consumer}" />
            <TextBlock
                Grid.Column="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="资产状态"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Status}" />
            <TextBlock
                Grid.Column="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="已用年限"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding UserYear}" />

            <TextBlock
                Grid.Column="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="报废日期"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding ScrapDate}" />

            <TextBlock
                Grid.Column="19"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="备注信息"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding Notes}" />

            <TextBlock
                Grid.Column="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagA"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagA}" />

            <TextBlock
                Grid.Column="21"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagB"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagB}" />

            <TextBlock
                Grid.Column="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagC"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagC}" />

            <TextBlock
                Grid.Column="23"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagD"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagD}" />
            <TextBlock
                Grid.Column="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagE"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagE}" />
            <TextBlock
                Grid.Column="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="TagF"
                FontSize="14"
                FontWeight="ExtraBold"
                Foreground="AliceBlue"
                Text="{Binding TagF}" />
        </Grid>
    </materialDesign:TransitioningContent>
</UserControl>
