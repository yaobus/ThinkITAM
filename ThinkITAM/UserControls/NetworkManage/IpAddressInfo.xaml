<UserControl
    x:Class="ThinkITAM.UserControls.NetworkManage.IpAddressInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:networkManage="clr-namespace:ThinkITAM.ViewModels.NetworkManage"
    Width="55"
    Height="47.5"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter" />


        <LinearGradientBrush x:Key="AnimatedBrush"
                             StartPoint="0 0"
                             EndPoint="1 0">
            <GradientStop Color="#6366f1"
                          Offset="0" />
            <GradientStop Color="#a855f7"
                          Offset="0.5" />
            <GradientStop Color="#ec4899"
                          Offset="1" />
        </LinearGradientBrush>

        <Border x:Key="AnimatedBorderPlaceholder"
                BorderBrush="{StaticResource AnimatedBrush}" />

        <Storyboard x:Key="AnimateBorder"
                    RepeatBehavior="Forever">
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="1 0" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="1 1"
                            BeginTime="0:0:2" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="0 1"
                            BeginTime="0:0:4" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="0 0"
                            BeginTime="0:0:6" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="1 1" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="0 1"
                            BeginTime="0:0:2" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="0 0"
                            BeginTime="0:0:4" />
            <PointAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                            Storyboard.Target="{StaticResource AnimatedBorderPlaceholder}"
                            Duration="0:0:2"
                            To="1 0"
                            BeginTime="0:0:6" />
        </Storyboard>


    </UserControl.Resources>



    <!--<UserControl.DataContext>
    <networkManage:IpAddressInfoListViewMode/>
    </UserControl.DataContext>-->
    <materialDesign:TransitioningContent Margin="2.5,0" OpeningEffectsOffset="{materialDesign:IndexedItemOffsetMultiplier 0:0:0.2}">
        <materialDesign:TransitioningContent.OpeningEffects>
            <materialDesign:TransitionEffect Kind="ExpandIn" />
        </materialDesign:TransitioningContent.OpeningEffects>



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>


            <Button
                x:Name="AddressButton"
                Grid.Row="0"
                Margin="0"
                Padding="0"
                d:Background="DarkCyan"
                d:BorderThickness="3"
                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                BorderBrush="{StaticResource AnimatedBorderPlaceholder}"
                BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToBorderThicknessConverter}, Mode=TwoWay}"
                Click="AddressButton_Click"
                IsEnabled="{Binding AddressType}"
                Tag="{Binding Status}"
                ToolTip="{Binding AddressToolTip}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItem_OnClick" Header="端口检测" />
                        <MenuItem Click="MenuItem_OnClick" Header="PING测试" />
                        <MenuItem Click="MenuItem_OnClick" Header="地址收藏" />
                        <MenuItem Click="MenuItem_OnClick" Header="WOL收藏" />
                    </ContextMenu>
                </Button.ContextMenu>



                <!-- 扩展现有的样式并添加新的触发器 -->
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatMidBgButton}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="AnimateBorder" Storyboard="{StaticResource AnimateBorder}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Grid x:Name="AddressGrid" Width="50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="10" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="AddressBlock"
                        Grid.Row="0"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="255"
                        FontWeight="Bold"
                        Foreground="{Binding PingStatusColor}"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Address}" />


                </Grid>




            </Button>

            <Grid
                Grid.Row="1"
                Margin="0,1"
                Background="{Binding AddressColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}">
                <Button
                    x:Name="ColorTagSet"
                    Height="8"
                    Padding="0"
                    BorderThickness="0"
                    Click="ColorTagSet_OnClick"
                    IsEnabled="{Binding AddressType}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="点击修改颜色标记" />

            </Grid>
        </Grid>
    </materialDesign:TransitioningContent>
</UserControl>
