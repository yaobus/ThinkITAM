<UserControl
    x:Class="ThinkITAM.UserControls.NetworkManage.IpAddressInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:functionClass="clr-namespace:ThinkITAM.FunctionClass"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:networkManage="clr-namespace:ThinkITAM.ViewModels.NetworkManage"
    Width="55"
    Height="47.5"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter" />


        <LinearGradientBrush x:Key="AnimatedBrush" StartPoint="0 0" EndPoint="1 0">
            <GradientStop Offset="0" Color="#00FFFF" />
            <GradientStop Offset="0.5" Color="#FFFF00" />
            <GradientStop Offset="1" Color="#FF0000" />
        </LinearGradientBrush>
        <Storyboard x:Key="AnimateBorder" RepeatBehavior="Forever">
            <!--  修改 StartPoint 和 EndPoint  -->
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 0"
                Duration="0:0:2" />

            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.StartPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:2"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 1"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:4"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="0 0"
                Duration="0:0:2" />
            <PointAnimation
                BeginTime="0:0:6"
                Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.EndPoint)"
                To="1 0"
                Duration="0:0:2" />
        </Storyboard>

    </UserControl.Resources>





    <!--<UserControl.DataContext>
    <networkManage:IpAddressInfoListViewMode/>
    </UserControl.DataContext>-->
    <materialDesign:TransitioningContent Margin="2.5,0" OpeningEffectsOffset="{materialDesign:IndexedItemOffsetMultiplier 0:0:0.2}">
        <materialDesign:TransitioningContent.OpeningEffects>
            <materialDesign:TransitionEffect Kind="ExpandIn" />
        </materialDesign:TransitioningContent.OpeningEffects>



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>


            <Button
                x:Name="AddressButton"
                Grid.Row="0"
                Margin="0"
                Padding="0"
                d:Background="DarkCyan"
                d:BorderThickness="3"
                Background="{Binding AddressStatus, Converter={StaticResource StatusToColorConverter}}"
                BorderBrush="{StaticResource AnimatedBrush}"
                BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToBorderThicknessConverter}, Mode=TwoWay}"
                Click="AddressButton_Click"
                IsEnabled="{Binding AddressType}"
                Tag="{Binding Status}"
                ToolTip="{Binding AddressToolTip}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItem_OnClick" Tag="PortScan" Header="{DynamicResource NmpPortScan}" />
                        <MenuItem Click="MenuItem_OnClick" Tag="Ping" Header="{DynamicResource NmpPingIp}" />
                        <MenuItem Click="MenuItem_OnClick" Tag="Collect" Header="{DynamicResource NmpIpCollect}" />
                        <MenuItem Click="MenuItem_OnClick" Tag="Wol" Header="{DynamicResource NmpWolCollect}" />
                    </ContextMenu>
                </Button.ContextMenu>

                <Button.Style>
                    <!--  继承 MaterialDesignFlatLightButton 并扩展触发器  -->
                    <Style BasedOn="{StaticResource MaterialDesignFlatLightButton}" TargetType="Button">
                        <!--  保留 Material Design 的默认属性  -->
                        <Setter Property="BorderBrush" Value="{StaticResource AnimatedBrush}" />
                        <!--  确保动画画刷优先级  -->
                        <Style.Triggers>
                            <!--  当 IsSelected 为 true 时启动动画  -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="AnimateBorderStoryboard" Storyboard="{StaticResource AnimateBorder}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="AnimateBorderStoryboard" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>


                <Grid x:Name="AddressGrid" Width="50">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="10" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="AddressBlock"
                        Grid.Row="0"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="255"
                        FontWeight="Bold"
                        Foreground="{Binding PingStatusColor}"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Address}" />


                </Grid>




            </Button>

            <Grid
                Grid.Row="1"
                Margin="0,1"
                Background="{Binding AddressColor, Converter={StaticResource IntegerToBrushConverter}, Mode=TwoWay}">
                <Button
                    x:Name="ColorTagSet"
                    Height="8"
                    Padding="0"
                    BorderThickness="0"
                    Click="ColorTagSet_OnClick"
                    IsEnabled="{Binding AddressType}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="点击修改颜色标记" />

            </Grid>
        </Grid>
    </materialDesign:TransitioningContent>
</UserControl>
