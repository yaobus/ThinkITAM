<UserControl
    x:Class="ThinkITAM.UserControls.NetworkManage.SubNetworkInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.NetworkManage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="243"
    Height="50"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.5}">
        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="LimeGreen" />

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Background="Teal" />

                <TextBlock
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="16"
                    Foreground="AliceBlue"
                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                    Text="{Binding Index}" />



                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:Text="192.168.222.0-192.168.222.255"
                    FontSize="14"
                    Foreground="AliceBlue"
                    Style="{StaticResource MaterialDesignButtonTextBlock}"
                    Text="{Binding Range}" />


                <Grid Grid.Row="1" Grid.Column="1">

                    <ProgressBar
                        Grid.Row="0"
                        Height="15"
                        VerticalAlignment="Bottom"
                        d:Value="69"
                        materialDesign:TransitionAssist.DisableTransitions="True"
                        Foreground="SeaGreen"
                        Maximum="100"
                        Minimum="0"
                        Opacity="0.5"
                        Value="{Binding Percentage}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="AliceBlue"
                            Opacity="0.3"
                            Text="{Binding Percentage}" />

                        <TextBlock
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="AliceBlue"
                            Opacity="0.3"
                            Text="%" />

                    </StackPanel>
                </Grid>

            </Grid>




        </materialDesign:Card>
    </materialDesign:TransitioningContent>

</UserControl>
