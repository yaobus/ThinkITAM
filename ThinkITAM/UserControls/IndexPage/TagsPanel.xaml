<UserControl x:Class="ThinkITAM.UserControls.IndexPage.TagsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThinkITAM.UserControls.IndexPage"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:index="clr-namespace:ThinkITAM.ViewModels.Index"
             d:Background="AliceBlue"
             d:Height="768"
             d:Width="1366"
             FontFamily="{StaticResource HarmonyOsFontFamily}"
             mc:Ignorable="d"
             >
    <UserControl.DataContext>
        <index:DashboardIndexTagViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            TextWrapping="NoWrap"
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="12"
            Opacity="0.8"
            d:Text="ABCDEFG"
            Text="{Binding GroupName}" />

        <ItemsControl Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:IndexTag DataContext="{Binding IndexTags}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


    </Grid>
</UserControl>
