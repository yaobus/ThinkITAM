<UserControl
    x:Class="ThinkITAM.UserControls.IndexPage.IndexTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.IndexPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="200"
    Height="50"
    Background="Transparent"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:ToolTipConverter x:Key="ToolTipConverter" />
        <converters:PinToStartIntToVisibilityConverter x:Key="PinToStartIntToVisibilityConverter" />
    </UserControl.Resources>

    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.2}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

            <Button
                x:Name="IndexButton"
                Width="200"
                Height="50"
                Padding="0"
                Click="IndexButton_OnClick"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="{Binding Browser, Converter={StaticResource ToolTipConverter}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItem_OnClick" Header="删除标签" />
                        <MenuItem Click="MenuItem_OnClick" Header="编辑标签" />

                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Width="200">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Background="{Binding Color, Converter={StaticResource IntegerToBrushConverter}}">

                        <materialDesign:PackIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="AliceBlue"
                            Kind="GoogleChrome" />

                    </Grid>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Background="Teal" />



                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0">
                            <Border.OpacityMask>
                                <LinearGradientBrush x:Name="MaskBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="0.75" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Grid>
                                <TextBlock
                                    x:Name="TextBlock"
                                    Grid.Column="0"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    d:Text="快速访问标签"
                                    FontWeight="Bold"
                                    Foreground="AliceBlue"
                                    SizeChanged="TextBlock_OnSizeChanged"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="{Binding Name}"
                                    ToolTip="{Binding Name}" />
                            </Grid>
                        </Border>
                        <Grid
                            Grid.Column="1"
                            Opacity="0.8"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="{Binding PinToStart, Converter={StaticResource PinToStartIntToVisibilityConverter}}">
                            <!--  设置中心点旋转  -->
                            <Grid.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Grid.RenderTransform>

                            <!--  原始内容  -->
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="5"
                                HorizontalAlignment="Right"
                                Foreground="AliceBlue"
                                Kind="PinOutline" />
                        </Grid>


                    </Grid>




                    <Border Grid.Row="1" Grid.Column="1">
                        <Border.OpacityMask>
                            <LinearGradientBrush x:Name="MaskBrush2" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="0.75" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid>


                            <TextBlock
                                x:Name="TextBlock2"
                                Grid.Column="0"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Text="http://192.168.0.1"
                                FontWeight="Bold"
                                Foreground="AliceBlue"
                                Opacity="0.5"
                                SizeChanged="TextBlock2_OnSizeChanged"
                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                Text="{Binding Url}"
                                ToolTip="{Binding Url}" />




                        </Grid>
                    </Border>
                </Grid>


            </Button>

        </materialDesign:Card>
    </materialDesign:TransitioningContent>


</UserControl>