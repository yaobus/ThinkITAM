<UserControl
    x:Class="ThinkITAM.UserControls.IndexPage.IndexTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ThinkITAM.Functions.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.IndexPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="210"
    Height="50"
    Background="Transparent"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IntegerToBrushConverter x:Key="IntegerToBrushConverter" />
        <converters:ToolTipConverter x:Key="ToolTipConverter" />
    </UserControl.Resources>

    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.2}">
        <materialDesign:Card Margin="0" materialDesign:ElevationAssist.Elevation="Dp3">

            <Button
                x:Name="IndexButton"
                Width="210"
                Height="50"
                Padding="0"
                Click="IndexButton_OnClick"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="{Binding Browser, Converter={StaticResource ToolTipConverter}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItem_OnClick" Header="删除标签" />
                        <MenuItem Click="MenuItem_OnClick" Header="编辑标签" />

                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Width="210">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Background="{Binding Color, Converter={StaticResource IntegerToBrushConverter}}">

                        <materialDesign:PackIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="AliceBlue"
                            Kind="GoogleChrome" />

                    </Grid>

                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Background="Teal" />





                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Text="快速访问标签"
                        FontWeight="Bold"
                        Foreground="AliceBlue"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Name}" />


                    <Grid Grid.Row="1" Grid.Column="1">


                        <TextBlock
                            Grid.Column="0"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            d:Text="http://192.168.0.1"
                            FontWeight="Bold"
                            Foreground="AliceBlue"
                            Opacity="0.5"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding Url}" />




                    </Grid>

                </Grid>


            </Button>

        </materialDesign:Card>
    </materialDesign:TransitioningContent>


</UserControl>