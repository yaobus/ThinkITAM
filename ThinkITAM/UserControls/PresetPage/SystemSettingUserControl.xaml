<UserControl
    x:Class="ThinkITAM.UserControls.PresetPage.SystemSettingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.PresetPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="800"
    d:Width="1200"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            Height="60"
            Margin="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Namp路径:" />
            <TextBox
                x:Name="TbName"
                Width="250"
                Height="28"
                Margin="0,0,10,0"
                Padding="3"
                VerticalAlignment="Center"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="LocationPath"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <Button
                Width="100"
                Content="浏览"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
        </StackPanel>



    </Grid>
</UserControl>
