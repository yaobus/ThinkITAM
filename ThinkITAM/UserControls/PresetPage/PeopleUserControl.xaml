<UserControl
    x:Class="ThinkITAM.UserControls.PresetPage.PeopleUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.PresetPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="800"
    d:Width="1200"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="PeopleUserControl_OnLoaded"
    mc:Ignorable="d">

    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.2}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1159*" />
                <ColumnDefinition Width="41*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:Card
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="2,5,5,2">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">


                        <Button
                            x:Name="AddButton"
                            Width="32"
                            Height="32"
                            Margin="5,0"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            Background="#aeea00"
                            BorderBrush="Transparent"
                            Click="AddButton_OnClick"
                            Content="{materialDesign:PackIcon ViewGridPlus}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                            ToolTip="新增" />

                        <Button
                            x:Name="EditAssetButton"
                            Width="32"
                            Height="32"
                            Margin="5,0"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            Background="#52c7b8"
                            BorderBrush="Transparent"
                            Click="EditAssetButton_OnClick"
                            Content="{materialDesign:PackIcon PencilBoxOutline}"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}" />

                        <Button
                            x:Name="DeleteAssetButton"
                            Width="32"
                            Height="32"
                            Margin="5,0"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            Background="#Cf3539"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="DeleteAssetButton_OnClick"
                            Content="{materialDesign:PackIcon DeleteOutline}"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}" />


                        <ProgressBar
                            Width="40"
                            Height="1"
                            Opacity="0.3"
                            Orientation="Vertical"
                            Value="100" />


                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ClearSearchKeyWord"
                            Click="ClearSearchKeyWord_OnClick"
                            Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                        </Button>
                        <TextBox
                            x:Name="SearchKeyWord"
                            Grid.Column="1"
                            MinWidth="200"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            BorderThickness="0"
                            KeyDown="SearchKeyWord_OnKeyDown"
                            Opacity="0.3" />
                        <Button
                            x:Name="SearchButton"
                            Grid.Column="2"
                            Click="SearchButton_OnClick"
                            Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                        </Button>

                        <Button
                            x:Name="ReSortColumnOrder"
                            Grid.Column="3"
                            Width="32"
                            Height="32"
                            Margin="5,0"
                            materialDesign:ElevationAssist.Elevation="Dp1"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="ReSortColumnOrder_OnClick"
                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                            ToolTip="{DynamicResource NmpResetColumnOrderSort}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="TableRefresh" />
                        </Button>
                    </Grid>


                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">


                        <Button
                            x:Name="DataImport"
                            Width="50"
                            Height="30"
                            Margin="5"
                            Padding="0"
                            HorizontalAlignment="Right"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            Click="DataImport_OnClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="人员数据导入">

                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="DatabaseImportOutline" />


                        </Button>
                        <Button
                            x:Name="DataExport"
                            Width="50"
                            Height="30"
                            Margin="5"
                            Padding="0"
                            HorizontalAlignment="Right"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            BorderThickness="0"
                            Click="DataExport_OnClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="导出当前网段信息"
                            Visibility="Collapsed">

                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="DatabaseExportOutline" />


                        </Button>

                    </StackPanel>


                </Grid>

            </materialDesign:Card>

            <materialDesign:Card
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="2,2,5,5">

                <DataGrid
                    x:Name="PeopleListView"
                    Margin="0,0,0,10"
                    d:Visibility="Visible"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ColumnReordered="PeopleListView_OnColumnReordered"
                    MouseDoubleClick="PeopleListView_OnMouseDoubleClick"
                    SelectionChanged="PeopleListView_OnSelectionChanged"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Visibility="Visible">


                    <DataGrid.Columns>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Index">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="FormatListNumbered" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="序号" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding Index}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="UserNumber">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Numeric9BoxMultipleOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="编号" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding UserNumber}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Name">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="AccountOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="姓名" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Organization">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="SourceCommitStartNextLocal" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="一级组织" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Organization}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Department">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="SourceMerge" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="二级组织" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Department}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Group">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="GraphOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="三级组织" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Group}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Group">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="GraphOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="四级组织" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Unit}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Phone">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Phone" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="电话" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Phone}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Description">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="NotebookOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="备注" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Note}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>


                <!--<ListView
                x:Name="PeopleListView"
                Grid.Row="1">
                <ListView.View>
                <GridView>
                <GridViewColumn
                DisplayMemberBinding="{Binding Index}"
                Header="序号" />
                <GridViewColumn
                DisplayMemberBinding="{Binding Name}"
                Header="姓名" />
                <GridViewColumn
                DisplayMemberBinding="{Binding Organization}"
                Header="组织" />
                <GridViewColumn
                DisplayMemberBinding="{Binding Department}"
                Header="部门" />
                <GridViewColumn
                DisplayMemberBinding="{Binding Phone}"
                Header="联系电话" />
                <GridViewColumn
                DisplayMemberBinding="{Binding Description}"
                Header="备注" />
                </GridView>
                </ListView.View>

                </ListView>-->

            </materialDesign:Card>


        </Grid>
    </materialDesign:TransitioningContent>

</UserControl>