<UserControl
    x:Class="ThinkITAM.UserControls.PresetPage.AddressUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.PresetPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="AliceBlue"
    d:Height="800"
    d:Width="1200"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    Loaded="AddressUserControl_OnLoaded"
    mc:Ignorable="d">
    <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect SlideInFromBottom, Duration=0:0:0.2}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Margin="2.5,5,5,2.5">


                <StackPanel
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">


                    <Button
                        x:Name="AddButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#aeea00"
                        BorderBrush="Transparent"
                        Click="AddButton_OnClick"
                        Content="{materialDesign:PackIcon ViewGridPlus}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="新增" />

                    <Button
                        x:Name="EditAddressButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#52c7b8"
                        BorderBrush="Transparent"
                        Click="EditAddressButton_OnClick"
                        Content="{materialDesign:PackIcon PencilBoxOutline}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="编辑地址信息" />

                    <Button
                        x:Name="DeleteAddressButton"
                        Width="32"
                        Height="32"
                        Margin="5,0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        Background="#Cf3539"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="DeleteAddressButton_OnClick"
                        Content="{materialDesign:PackIcon DeleteOutline}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="删除地址信息" />


                    <ProgressBar
                        Width="40"
                        Height="1"
                        Opacity="0.3"
                        Orientation="Vertical"
                        Value="100" />

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ClearSearchKeyWord"
                            Click="ClearSearchKeyWord_OnClick"
                            Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Margin="5,0,5,0" Kind="ClearCircleOutline" />
                        </Button>
                        <TextBox
                            x:Name="SearchKeyWord"
                            Grid.Column="1"
                            MinWidth="200"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="{DynamicResource NmpSearchKeyWord}"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            BorderThickness="0"
                            KeyDown="SearchKeyWord_OnKeyDown"
                            Opacity="0.3" />
                        <Button
                            x:Name="SearchButton"
                            Grid.Column="2"
                            Click="SearchButton_OnClick"
                            Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Margin="5,0" Kind="Search" />
                        </Button>
                    </Grid>





                </StackPanel>







            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="2.5,2.5,5,5">

                <DataGrid
                    x:Name="AddressListView"
                    Margin="0,0,0,10"
                    d:Visibility="Visible"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    MouseDoubleClick="AddressListView_OnMouseDoubleClick"
                    SelectionChanged="AddressListView_OnSelectionChanged"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Visibility="Visible">


                    <DataGrid.Columns>

                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Index">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Counter" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="序号" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding Index}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            MinWidth="350"
                            CanUserSort="True"
                            SortMemberPath="Location">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="MapMarkerOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="地点预设" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{Binding Location}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>




                        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Description">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="NotebookOutline" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="备注" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Note}" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                    </DataGrid.Columns>

                </DataGrid>





            </materialDesign:Card>


        </Grid>
    </materialDesign:TransitioningContent>

</UserControl>
