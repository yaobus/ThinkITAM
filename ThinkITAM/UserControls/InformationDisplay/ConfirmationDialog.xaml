<UserControl
    x:Class="ThinkITAM.UserControls.InformationDisplay.ConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ThinkITAM.UserControls.InformationDisplay"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="250"
    MinHeight="150"
    FontFamily="{StaticResource HarmonyOsFontFamily}"
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>


        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="10"
            FontFamily="{StaticResource HarmonyOsFontFamilyBold}"
            FontSize="14"
            FontWeight="ExtraBlack"
            Foreground="{Binding TitleColor}"
            Style="{StaticResource MaterialDesignTextBlock}"
            Text="{Binding Title}" />

        <!--  提示内容  -->
        <TextBlock
            Grid.Row="1"
            MaxWidth="400"
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource HarmonyOsFontFamily}"
            FontSize="14"
            Foreground="{Binding PromptColor}"
            Style="{StaticResource MaterialDesignTextBlock}"
            Text="{Binding Prompt}"
            TextWrapping="Wrap" />

        <!--  按钮组  -->
        <Grid Grid.Row="2">
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
                <!--  确认按钮  -->
                <Button
                    Grid.Column="0"
                    Margin="10"
                    HorizontalAlignment="Center"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmButtonText}"
                    Foreground="{Binding ConfirmButtonColor}"
                    Style="{StaticResource MaterialDesignOutlinedSecondaryDarkButton}">
                    <Button.CommandParameter>
                        <system:Boolean xmlns:system="clr-namespace:System;assembly=System.Runtime">True</system:Boolean>
                    </Button.CommandParameter>
                </Button>

                <!--  取消按钮  -->
                <Button
                    Grid.Column="1"
                    Margin="10"
                    HorizontalAlignment="Center"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Content="{DynamicResource CdClose}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedLightButton}">
                    <Button.CommandParameter>
                        <system:Boolean xmlns:system="clr-namespace:System;assembly=System.Runtime">False</system:Boolean>
                    </Button.CommandParameter>
                </Button>

        </Grid>
    </Grid>
</UserControl>
