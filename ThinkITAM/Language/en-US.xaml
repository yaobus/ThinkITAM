<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">


    <!--  MainWindow  -->
    <s:String x:Key="AddProject">Add Project</s:String>
    <s:String x:Key="SetPassword">Set Password</s:String>
    <s:String x:Key="SetPasswordAgain">Confirm Password</s:String>
    <s:String x:Key="SavePassword">Save Password</s:String>


    <s:String x:Key="InputPassword">Input Password</s:String>
    <s:String x:Key="Login">Verification Password</s:String>


