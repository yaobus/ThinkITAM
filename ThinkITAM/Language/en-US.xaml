    <s:String x:Key="ApwTitle">Add Project</s:String>
    <s:String x:Key="ApwType">Select the project storage method</s:String>
    <s:String x:Key="ApwSqlitePath">Select the storage path</s:String>
    <s:String x:Key="ApwSqliteNew">New</s:String>
