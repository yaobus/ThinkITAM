<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--  MainWindow  -->
    <s:String x:Key="AddProject">添加项目</s:String>
    <s:String x:Key="SetPassword">设置密码</s:String>
    <s:String x:Key="SetPasswordAgain">确认密码</s:String>
    <s:String x:Key="SavePassword">保存密码</s:String>


    <s:String x:Key="InputPassword">输入密码</s:String>
    <s:String x:Key="Login">验证密码</s:String>


    <!--  Windows.MainWindow连接失败MessageDialogHost  -->
    <s:String x:Key="MainOpenFailedPrompt">数据库打开失败,请检查数据库配置</s:String>
    <s:String x:Key="MainOpenFailedTitle">打开失败</s:String>



    <!--  UserControls.InformationDisplay.ConfirmationDialog  -->
    <s:String x:Key="CdClose">关闭</s:String>
    <s:String x:Key="CdConfirm">确认</s:String>
    <s:String x:Key="CdTitle">请设置密码</s:String>

    <s:String x:Key="CdPrompt">密码不得为空</s:String>

    <s:String x:Key="CdPrompt2">两次密码输入不一致</s:String>

    <s:String x:Key="CdFailedVerificationTitle">验证失败</s:String>
    <s:String x:Key="CdFailedVerificationPrompt">验证失败，密码错误</s:String>



    <!--  Windows.Project.AddProjectWindow  -->
    <s:String x:Key="ApwTitle">添加项目</s:String>
    <s:String x:Key="ApwType">选择项目存储方式</s:String>
    <s:String x:Key="ApwSqlitePath">选择项目存储路径</s:String>
    <s:String x:Key="ApwSqliteNew">新建</s:String>
    <s:String x:Key="ApwSqliteName">设定项目名称</s:String>

    <s:String x:Key="ApwSave">保存</s:String>

    <s:String x:Key="ApwOpenFileFilter">数据库文件 (*.db)|*.db|所有文件 (*.*)|*.*</s:String>
    <s:String x:Key="ApwOpenFileTitle">请选择一个Sqlite.db 文件</s:String>
    <s:String x:Key="ApwSaveFileMessage">选择存储文件夹</s:String>

    <s:String x:Key="ApwHost">数据库主机地址</s:String>
    <s:String x:Key="ApwPort">端口号</s:String>
    <s:String x:Key="ApwUserName">数据库用户名</s:String>
    <s:String x:Key="ApwPassword">数据库密码</s:String>
    <s:String x:Key="ApwDatabaseName">数据库名称</s:String>
    <s:String x:Key="ApwProjectName">设定项目名称</s:String>

    <!--  Windows.Project.AddProjectWindow信息不完整MessageDialogHost  -->
    <s:String x:Key="ApwMdTitle">信息不完整</s:String>
    <s:String x:Key="ApwMdPrompt">请填写完整信息</s:String>


</ResourceDictionary>